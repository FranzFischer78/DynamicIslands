# Steamvent Harbour - the third island of the library's plan The Frozen Horizon (storyline SL12, chapter 3: The Warm Harbour)
# A harbour town huddled round a geothermal vent: steam rising from a fissure in the square, iron pipes laid from it to
# the houses, the ground round it warm enough for a garden of fruit and flowers in the snow. A glass greenhouse grew shut
# with jungle vines (the machete is in the harbour store), a boiler house, a pipe store full of rats, a hen coop and a
# town hall that has been cold since the valve stuck. Quest "The Warm Harbour" (12 steps): the quay, the harbour master's
# notice, the machete's plans, the vines and the greenhouse, the gardener's log, the fuel tank's plans (boiler house), the
# rats, the fuel pipe's plans (pipe store), the vent valve (steam back to the houses), the biofuel extractor's plans
# (town hall locker), the town meeting minutes.
#
# Built by the recipe player (CIRecipe steamvent_harbour) through the editor's own operations. Points (metres over the
# sea): the town at 3 m (r 22 round 0 0), the vent in its middle; the quay at 1.2 m round 0 -38; the harbour store
# x -12..-7.5 z -16..-13; the greenhouse x 14..20 z -6.5..2.5 (door south at 15.5 -6.5); the boiler house x -22..-17.5
# z 2..6.5; the pipe store x 6..10.5 z 12..16.5; the town hall x -6..0 z 10..14.5; the hen coop round -18 18.
include lib_sea
include lib_huts
include lib_rt
include lib_features
include lib_frozen
# RESIZE 10-24: Radius 46 -> 90 (Height 7 -> 8), the old content moved 0 -24.2 as one frame (push) so its sea side stays at the coast; the island grows behind it.
new
gen Trees=0.06 Bushes=0.2 Rocks=0.3 Harvest=0.2 BeachThings=0.3
gen Seed=12301 Radius=90 Height=8 Roughness=0.4 Peaks=2 Shape=0 Style=1 BeachWidth=0.25 Cliffs=0.35 PeakShape=0.5
gen Water=0.5 SeaRocks=0.3 SeaFinds=0.3 Sunken=0.2 Hostiles=0 Friendly=0 SeaLife=0.3
generate
push at 0 -24.2

# --- Terrain: the town at 3 m, the road down to the quay at 1.2 m ---------------------------------------------------
brush flatten at 0 0 r=22 s=20 frames=300 h=3
brush flatten from 0 -22 to 0 -33 r=3.5 s=20 frames=80 h=2.1
brush flatten at 0 -38 r=6 s=20 frames=200 h=1.2
# RESIZE 10-24 retest: the bigger island stands higher here - the huts' pads flattened again
brush flatten at -9.75 -14.5 r=5 s=20 frames=200 h=3
brush flatten at -19.75 4.25 r=5 s=20 frames=200 h=3
brush flatten at 8.25 14.25 r=5 s=20 frames=200 h=3
brush flatten at -3 12.25 r=5 s=20 frames=200 h=3
brush flatten at -18.5 15.5 r=5 s=20 frames=200 h=3
brush flatten from -12 14 to -12 18 r=3 s=20 frames=200 h=3
brush grass at 0 0 r=9 s=20 frames=20
pop
brush flatten at -11.8 30.8 r=5 s=8 frames=40
origin
clear at -11.8 30.8 r=6
push at 0 -24.2
clear at 0 0 r=22
clear from 0 -22 to 0 -38 r=6

# --- The quay: the harbour master's notice, bollards, crates ----------------------------------------------------------
place Zone_Trigger quayzone at 0 -38 ground y=1
place Note_Sign notice at 3 -35 ground sit yaw=200
place TP_Moontown_SealedCrate02 - at -4 -39 ground sit yaw=10
place Reef_Barrel2 - at -3 -36.5 ground sit
place Reef_Barrel2 - at 4.5 -40 ground sit
place TP_Moontown_TarpCrate01_Clean - at -5 -34 ground sit yaw=80

# --- The vent in the square: a ring of dark rock round the fissure, steam, the valve on its post, pipes to the houses ---
place SmallRock_02 ventrock at -1.6 0.4 ground y=-0.7 scale=0.9 yaw=10
place SmallRock_02 ventrock at 1.4 1.2 ground y=-0.7 scale=0.8 yaw=130
place SmallRock_02 ventrock at 0.6 -1.6 ground y=-0.7 scale=0.85 yaw=250
prop ventrock tint.color=#3a3634
prop ventrock tint.amount=0.6
place Zone_Atmosphere ventsteam at 0 0 ground y=1.5
prop ventsteam atmo.particles=mist
prop ventsteam atmo.fog=#d8dcdc
prop ventsteam atmo.fogAmount=0.2
prop ventsteam zone.radius=4
place Zone_Atmosphere steamhouses at 0 4 ground y=2
prop steamhouses atmo.particles=mist
prop steamhouses atmo.fog=#e4e6e6
prop steamhouses atmo.fogAmount=0.25
prop steamhouses zone.radius=18
prop steamhouses beh.hidden=1
place RT_Pillar - at 3 -3 ground sy=0.6
place TP_Selene_DoorCrankWheel ventvalve at 3 -3.09 ground y=1.2
place RT_Pipe - at -5 3 ground yaw=150
place RT_Pipe - at 5 -2 ground yaw=80
place RT_Pipe - at -4 -6 ground yaw=40
place RT_Pipe - at 4 6 ground yaw=20
place "Pickup_Landmark_Clay 1" - at -2.8 -2.2 ground sit
place "Pickup_Landmark_Clay 2" - at 2.4 2.8 ground sit

# --- The vent garden (the warm ground round the vent): fruit, berries, flowers of every colour --------------------------
scatter "Pickup_Landmark_Tree_Mango" 2 at -8 -8 r=3 seed=12311 free=4
scatter "Pickup_Landmark_PineappleLandmark" 3 at 8 -9 r=3 seed=12312 free=2
scatter "Pickup_Landmark_WatermelonLandmark" 2 at -9 4 r=3 seed=12313 free=2
scatter "Pickup_Landmark_BerryBush" 3 at 9 3 r=3 seed=12314 free=2
scatter "Pickup_Landmark_Tree_Palm 2" 2 at 10 -14 r=3 seed=12310 free=4
scatter "Pickup_Landmark_Flower_Red" 2 at 0 -8 r=3 seed=12315 free=1
scatter "Pickup_Landmark_Flower_Yellow" 2 at 0 -8 r=3 seed=12316 free=1
scatter "Pickup_Landmark_Flower_White" 2 at -6 -1 r=3 seed=12317 free=1
scatter "Pickup_Landmark_Flower_Blue" 2 at 6 -5 r=3 seed=12318 free=1
scatter "Pickup_Landmark_Flower_Black" 2 at -3 7 r=3 seed=12319 free=1

# --- The harbour store: the machete's plans and a machete for the greenhouse vines -----------------------------------
push at -12 -16 h=3
call hut w=3 d=2 y=0.1
place Loot_Chest harbourstore at 3.7 2.3 y=0.1 sit yaw=180
place Placeable_Shelf_Wood - at 1.2 2.4 y=0.1 sit yaw=180
pop

# --- The greenhouse (radio tower glass, its door south), grown shut with vines: beds, a hive, the gardener's log ------
push at 20 -2 h=3
call rt_storey a=greenhouse f1=RT_WallDoor1 f2=RT_WallWindow1 b1=RT_WallWindow1 b2=RT_WallWindow1 l1=RT_WallWindow1 l2=RT_WallWindow1 l3=RT_WallWindow1 r1=RT_WallWindow1 r2=RT_WallWindow1 r3=RT_WallWindow1
place RT_Floor greenhouse at 0 4.5 y=3
place Placeable_Table_Basic - at -1.2 3.4 y=0 sit yaw=0
place Note_Book gardenerlog at -1.2 3.4 y=0.9 drop yaw=20
place Loot_Chest greenstore at -4.8 3.6 y=0 sit yaw=180
place Placeable_BeeHive - at -5.3 0 y=0 sit yaw=90
place Placeable_Cropplot_Medium - at -1.5 -0.5 y=0 sit
place "Pickup_Landmark_BerryBush" - at -4.4 -2.6 y=0 sit
place "Pickup_Landmark_Flower_Red" - at -1 -3 y=0 drop
place "Pickup_Landmark_Flower_Yellow" - at -0.6 1 y=0 drop
place Zone_Trigger greenzone at -3 0 y=1
pop
place ChoppableVines greenvines at 15.5 -6.9 ground yaw=0

# --- The boiler house (west): the fuel tank's plans; the old boiler outside -----------------------------------------
push at -22 2 h=3
call hut w=3 d=3 y=0.1
place Loot_Chest boilerhouse at 3.7 3.8 y=0.1 sit yaw=180
place Placeable_Lantern_Metal - at 1 3.9 y=0.1 drop
pop
place "VG_DecorationPrefabBase_EmergencyGenerator Variant" - at -24.5 4 ground sit yaw=90
place UT_Generator01 - at -15.5 8 ground sit yaw=200

# --- The pipe store (north-east): rats among the pipes, the fuel pipe's plans --------------------------------------
push at 6 12 h=3
call hut w=3 d=3 y=0.1
place Loot_Chest pipestore at 3.7 3.8 y=0.1 sit yaw=180
place Zone_Trigger pipezone at 2.25 2.25 y=1
place Creature_Rat rats at 2.25 2.5 y=0.3
pop

# --- The town hall (north): the steam-house locker (opens with the steam), the minutes --------------------------------
push at -6 10 h=3
call hut w=4 d=3 y=0.1
place Placeable_Table_Basic - at 3 2.5 y=0.1 sit yaw=90
place Note_Book minutes at 3 2.5 y=1 drop yaw=10
place Loot_ChestLarge townlocker at 5.2 3.6 y=0.1 sit yaw=180
place Placeable_Lantern_Metal - at 1 3.9 y=0.1 drop
pop
place Placeable_Cropplot_Medium - at -12 14 ground sit
place Placeable_Cropplot_Medium - at -12 17.5 ground sit
call dirt x=-12 z=20 r=4 n=2 seed=12321

# --- The hen coop (north-west): a small hut, the hens round it -------------------------------------------------------
push at -20 14 h=3
call hut w=2 d=2 y=0.1
pop
place Creature_Chicken hens at -17 19 ground
call hives x=24 z=10 r=6 n=2 seed=12322

# --- The sea --------------------------------------------------------------------------------------------------------
scatter VP_CoralDigitate01 4 at 58.7 -34.5 r=4 seed=12331 wet free=1
scatter VP_CoralBulb04 3 at 58.7 -34.5 r=4 seed=12332 wet free=1
call shallows x=0 z=24.2 r=90 deep=6 n=1 seed=12340
pop

# --- DISCOVERIES 10-24 (optional, no quest needs them): camp + note; TP_SnowVehicle02 + chest; hatch with a chest; dirt to dig (the detector comes later); viewpoint ---
place campfire_1 - at -11.8 30.8 ground sit
place Balboa_DecorationPrefabBase_SimpleTent - at -8.8 32.8 ground sit yaw=97
place "Box Small" - at -13.8 33.3 ground sit
place Note_Paper dnote at -13.8 33.3 ground y=0.7 drop yaw=20
note dnote Sealer's note | Poor hunting. The seals left when the warm water came up.\nLeft the spare furs and the tea in the box.\nIf you are cold, the fire pit still takes driftwood.
place TP_SnowVehicle02 dvan at 32.6 -26.4 ground yaw=217
prop dvan tint.color=#7a8a96
prop dvan tint.amount=0.5
place Loot_ChestSmall dwreckchest at 28.6 -23.4 ground sit yaw=157
note dwreckchest Driver's box | The driver's box under the seat: bolts, glass and a scrap of leather.
loot dwreckchest Bolt*2;Glass*2;Leather*2
prop dwreckchest loot.refill=0
call hatchcache x=-31.7 z=-27.6 r=15 seed=12391 alias=dhatch chest=dhatchchest items=MetalIngot*2;Wool*3;Bolt*2
call dirt x=-5 z=25 r=22 n=3 seed=12392
place Zone_Trigger dview at -41.5 6.6 ground
prop dview zone.id=steamvent_harbour_view
prop dview zone.radius=7
prop dview zone.repeat=never
prop dview zone.message=Steam rises from the square below, and the harbour town huddles round it for the warmth.

# --- Settings, story items, notes, behaviours, quest -----------------------------------------------------------------
info title=Steamvent Harbour
info author=Custom Islands
info description=A harbour town round a steaming vent in the snow: pipes to every house, a fruit garden on the warm ground, a glass greenhouse grown shut with vines and a valve that stuck. The third island of The Frozen Horizon.
island on.arrive=message||Steam rising from a town square - and round it, in the snow, a garden.

story wheelpiece|Handwheel piece|Placeable_Lantern_Metal|A piece of the vent valve's handwheel. The harbour master took it apart to stop the frozen valve being forced.
story steam|Steam to the houses|Placeable_Lantern_Metal|You opened the vent valve: steam runs to every house in the harbour again.

note notice Harbour master's notice | STEAMVENT HARBOUR - NOTICE\n\nThe vent valve has stuck. The houses are cold.\nThe greenhouse door has grown shut - jungle vines, the heat did it. A machete is in the harbour store.\nRats in the pipe store. Mind your fingers.\nTown meeting in the hall once the steam is back.\n\n- Harbour master
note harbourstore Harbour store | The harbour store: a machete in oilcloth, the plans for making more, and rope.
note greenstore Greenhouse store | The gardener's store: seed packets, potatoes for planting, a jar of last year's honey.
note gardenerlog Gardener's log | GREENHOUSE LOG\n\nThe vent keeps it at summer heat all winter. Bananas, berries, roses.\nThe vines came in with a crate of bananas, a stowaway. Now they've grown over the door.\nThe boiler house has the fuel plans; the pipe store, the pipes - but the rats have it now.\nThe valve on the square feeds the houses. It sticks in the cold. Turn it hard.
note boilerhouse Boiler house | The boiler house chest: the fuel tank's plans, a can of fuel, bolts.
note pipestore Pipe store | The pipe store's chest, gnawed at the corners: the plans for fuel pipes and a bundle of copper.
note townlocker Steam-house locker | The town hall's locker, its frozen lock thawed by the steam: the biofuel extractor's plans - "the harbour's own oil".
note minutes Town meeting minutes | TOWN MEETING - MINUTES\n\nSteam back thanks to a stranger.\nAgreed: we take the sledges to Orrin's camp on the shelf ice, and from there to the Whale. The Whale's captain kept the vault's charts.\nOrrin is on 900.\nAgreed: the greenhouse feeds whoever stays.
loot harbourstore Blueprint_Machete*1;Machete*1;Rope*2
prop harbourstore loot.refill=0
loot greenstore story:wheelpiece*1;Seed_Banana*2;Seed_Strawberry*2;Seed_Flower_Red*1;Seed_Flower_Blue*1;Raw_Potato*3
prop greenstore loot.refill=0
loot boilerhouse Blueprint_Fueltank*1;Bolt*2;Scrap*2;story:wheelpiece*1
prop boilerhouse loot.refill=0
loot pipestore Blueprint_Pipe_Fuel*1;CopperIngot*2;Scrap*2;story:wheelpiece*1
prop pipestore loot.refill=0
loot townlocker Blueprint_BiofuelExtractor*1;MetalIngot*2;Bolt*2
prop townlocker loot.refill=0

prop quayzone zone.id=quay
prop quayzone zone.radius=6
prop quayzone zone.message=The quay. Up the road, steam rises from the square.
prop greenvines obj.name=greenvines
prop greenvines on.use=hide|greenvines\nsignal||vines\nmessage||The machete bites through the vines. Warm air spills out of the greenhouse door.
prop greenzone zone.id=greenhouse
prop greenzone zone.radius=2.5
prop greenzone zone.message=The greenhouse: summer air, bananas, roses - and bees.
prop pipezone zone.id=pipestore
prop pipezone zone.radius=4
prop pipezone zone.repeat=never
prop pipezone zone.message=Rats! The pipe store is full of them.
prop rats creature.count=4
prop rats creature.respawn=0
prop rats creature.zone=pipestore
prop hens creature.count=3

prop ventvalve obj.name=ventvalve
prop ventvalve beh.use=Turn the vent valve
prop ventvalve if.use=!signal|steam\ntake|story:wheelpiece|3
prop ventvalve on.use=message||The valve groans, gives - and steam hisses down the pipes. One by one the houses' chimneys breathe.\nsignal||steam\ngive||story:steam*1\nshow|steamhouses\nsound||event:/exploring/obstacles/keypad/keypad_correct
prop ventvalve else.use=message||The valve is open and the town is warm - or its handwheel is still in three pieces: the greenhouse, the boiler house, the pipe store.
prop steamhouses obj.name=steamhouses
prop townlocker obj.name=townlocker
prop townlocker if.open=signal|steam
prop townlocker else.open=message||The locker's lock is frozen solid. The hall needs its steam back.

quest title=The Warm Harbour
quest intro=A town round a steaming vent, its houses cold. Tie up at the quay.
step reach|quay|1|Tie up at the harbour quay
step read|Harbour master's notice|1|Read the harbour master's notice
step blueprint|Blueprint_Machete|1|Take the machete's plans from the harbour store
step reach|greenhouse|1|Cut the vines and go into the greenhouse
step read|Gardener's log|1|Read the gardener's log
step blueprint|Blueprint_Fueltank|1|Take the fuel tank's plans from the boiler house
step kill|Rat|4|Clear the rats out of the pipe store
step blueprint|Blueprint_Pipe_Fuel|1|Take the fuel pipe's plans from the pipe store
step collect|story:wheelpiece|3|Find the valve handwheel's three pieces (greenhouse, boiler house, pipe store)
step collect|story:steam|1|Turn the vent valve on the square
step blueprint|Blueprint_BiofuelExtractor|1|Take the biofuel extractor's plans from the town hall's locker
step read|Town meeting minutes|1|Read the town meeting minutes
quest done=The town goes to Orrin's sledge camp on the shelf ice - and then to the Whale. Orrin is on 900.
quest reward=MetalIngot*2;Rope*4;Egg*2

# RESIZE 10-24 retest: the bigger island's generator rocks that floated over slopes (ground check)
clear at -48.49 12.83 r=1.5 only=TP_BigRock
clear at -31.35 25.78 r=1.5 only=TP_BigRock
clear at -16.43 52.79 r=1.5 only=TP_BigRock
clear at -30.27 34.12 r=1.5 only=TP_BigRock
clear at -34.44 -20.65 r=1.5 only=TP_BigRock
clear at -40.56 -14.82 r=1.5 only=TP_BigRock

save Steamvent Harbour
