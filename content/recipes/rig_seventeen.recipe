prop controlroom zone.radius=4
prop controlroom zone.message=The control room: dead screens, a control desk with a checklist on it, the manager's locker.
prop tankstack zone.id=tankstack
prop tankstack zone.radius=6
prop tankstack zone.message=The tank stack: three diesel tanks on a red rock, and the fuel store.
prop firedeck obj.name=firedeck
prop firedeck beh.hidden=1
prop firedeck zone.id=firedeck
prop firedeck zone.radius=5
prop firedeck zone.message=The cellar deck is burning. Valve one, at the wellhead - through the heat!
prop lifeboatbay zone.id=lifeboatbay
prop lifeboatbay zone.radius=2.2
prop lifeboatbay zone.message=The lifeboat bay. You made it before the fire door.
