prop pier zone.id=pier
prop pier zone.radius=7
prop pier zone.message=The festival pier: paper garlands, a board with the programme, and a box with LAMPLIGHTER painted on it.
prop stage zone.id=stage
prop stage zone.radius=5
prop stage zone.message=The stage on the hill under its pagoda, the rocket rack behind it - and the whole crescent below you in the dusk.
prop hens creature.count=3
prop dolphins creature.count=2
prop turtle creature.count=1

quest title=Twelve Lanterns
quest intro=A festival island at dusk, every lantern dark. The programme is on the pier.
step reach|pier|1|Tie up at the festival pier
step read|Festival programme|1|Read the festival programme
step open|Lamplighter's box|1|Take the taper from the lamplighter's box
step open|Sunk festival goods|1|Dive off the end of the pier for the festival goods the storm knocked in
step open|Fish stall box|1|See what the fish stall in the square left behind when everyone ran
step collect|story:lit|6|Light the six lanterns along the shore walk
step catch|Chicken|2|Catch two of the festival hens loose round the stall square
step collect|story:lit|12|Light the six lanterns up the hill path along the ridge
step reach|stage|1|Climb to the stage on the hill
step collect|story:fan|1|Set off the finale from the rocket rack
step open|The festival prize|1|Open the lamplighter's prize under the pagoda
quest done=Twelve lanterns burn round the crescent and the last rockets drift down over the bay. The festival happened after all - with an audience of dolphins.
quest reward=Mango*3;Cooked_Herring*2;Rope*2

save Lanternfall

