# Geiger Isle - a new medium island of the library (ROADMAP 3d NI7b), no quest
# A black volcanic isle with green patches where the ash let grass back in. Somebody fenced off its middle years ago:
# a wire fence with warning plates round a yard of toxic barrels, a decontamination tent, a guard's hut and a radio mast,
# and at the yard's north end the bunker - a hollow in the rock hill, dark, full of leaking drums. Rats and roaches have
# the bunker now; hyenas roam the grass west of the fence. A plank jetty runs from the south beach out to where the
# supply boats tied up. Scrap, metal and a few good finds for those who brave it.
#
# Built by the recipe player (CIRecipe geiger_isle) through the editor's own operations. Points: the yard (3 m, r 20 round
# 0 -7), the fence x -13..13, z -20..7 (gate in the south side at x -2.5..2.5, a gap in the north side to the bunker); the
# guard's hut x -11..-6.5, z -17..-14 (its door south at -8.75 -17), his box inside at -10 -14.7; the bunker rock round
# -1 24, its floor 3.1 m, its mouth south at about -1 10.5; the bunker's chest at -1 28; the jetty's root on the south
# beach at 0 -43 (1.35 m), the jetty z -43..-58 at x -1.5..1.5 (deck 1.5 m); the hyenas at -26 -6.
include lib_huts
include lib_sea
include lib_features
include lib_ni34
include lib_ni7b
new
# (nature: volcanic - few trees, more rocks; Raft's finds in the sea as round Raft's islands)
gen Trees=0.15 Bushes=0.25 Rocks=0.5 Harvest=0.2 BeachThings=0.3
gen Seed=7711 Radius=50 Height=12 Roughness=0.4 Peaks=1 Shape=0 Style=4 BeachWidth=0.5 Cliffs=0.35 PeakShape=0.4
gen SeaFloor=0 Shelf=0.5 Seabed=1
gen Water=0.5 SeaRocks=0.45 SeaFinds=0.4 Sunken=0.4 Hostiles=0 Friendly=0 SeaLife=0.2
generate

# ===== Terrain: the fenced yard; the ground under the bunker rock; the track down to the jetty; grass and sand patches ======
brush flatten at 0 -7 r=20 s=20 frames=100 h=3
brush flatten at -1 22 r=14 s=20 frames=100 h=2.6
brush flatten from 0 -24 to 0 -40 r=3.5 s=20 frames=60 h=2.2
brush flatten at 0 -43 r=3 s=20 frames=60 h=1.35
brush flatten at -8.75 -15.5 r=5 s=20 frames=150 h=3.2
brush smooth from 0 -22 to 0 -42 r=5 s=10 frames=40
brush grass at -26 -4 r=11 s=20 frames=20
brush grass at 22 -22 r=9 s=20 frames=20
brush sand from -18 -38 to 18 -40 r=6 s=20 frames=20
brush rock at 24 12 r=9 s=20 frames=20
clear at 0 -7 r=21
clear at -1 22 r=18
clear from 0 -24 to 0 -46 r=3

# ===== The fence round the yard, warning plates by the gate, a sign to read ===============================================
call fencesquare x=-13 z=-20 w=26 d=27 gw=5 ngw=6
place Note_Sign gatesign at -4.5 -21.5 ground sit yaw=180

# ===== The yard: the guard's hut, the decontamination tent, barrel heaps, the radio mast, a crate ==========================
push at -11 -17 h=3.2
call cabin w=3 d=2 al=hutwall
place Bed_Simple - at 3.0 2.0 y=0.1 sit yaw=90
place "Box Small" hutbox at 1 2.3 y=0.1 sit yaw=10
pop
place Balboa_DecorationPrefabBase_SimpleTent - at 7 -15 ground sit yaw=0
call toxicheap x=6 z=-6 n=5 r=1.8 seed=7711
call toxicheap x=-6 z=-2 n=4 r=1.6 seed=7712
call toxicheap x=9 z=2 n=4 r=1.6 seed=7713
place VP_ExplosiveBarrel_Pile - at 10 -10 ground sit yaw=30
place Antenna_pole - at -10 3 ground
place Loot_Crate yardcrate at 2 -12 ground sit yaw=15
scatter DeadTree_TreeStumps_1 3 at 0 -7 r=17 seed=7714 free=3
scatter DeadTree_TreeStumps_3 2 at 0 -7 r=17 seed=7715 free=3

# ===== The bunker: Balboa's dead-end cave in the rock hill, its mouth to the yard; posts and a warning sign at the mouth;
# leaking drums, a lantern, the last chest inside; rats and roaches; dark ==================================================
place BalboaCave_DeadEnd bunker at -1 24 h=9.1 yaw=180 scale=0.8
place RT_PillarThick - at -5.6 9.4 ground sy=0.6
place RT_PillarThick - at 3.6 9.4 ground sy=0.6
place Sign_02 - at 5.5 8.5 ground sit yaw=200
place Balboa_DecorationPrefabBase_ToxicBarrel - at -3.2 23.6 h=3.1 sit
place Balboa_DecorationPrefabBase_ToxicBarrel - at -3.6 22 h=3.1 sit yaw=40
place Balboa_DecorationPrefabBase_ToxicBarrel - at 1.5 23 h=3.1 sit roll=90 yaw=70
place Placeable_Lantern_Basic - at 1.8 26 h=3.1 sit
place Loot_ChestSmall bunkerchest at -1 28 h=3.1 sit yaw=180
place Creature_Rat rats at -1 22 h=3.4
prop rats creature.count=3
place Creature_Roach roaches at 0 25 h=3.4
prop roaches creature.count=2
place Zone_Atmosphere bunkerdark at -1 23 h=6
prop bunkerdark atmo.fog=#030405
prop bunkerdark atmo.fogAmount=0.6
prop bunkerdark zone.radius=9

# ===== The supply jetty off the south beach ===============================================================================
push at 0 -43 yaw=90
call jetty n=8 h=1.5
pop
place Loot_Crate jettycrate at 1.2 -56 h=1.5 sit yaw=10

# ===== The rest of the isle: palms on the grass, hyenas, dirt, a treasure; Raft's finds in the shallows; turtles ==========
scatter "Pickup_Landmark_Tree_Palm 3" 3 at -26 -4 r=9 seed=7716 free=5
scatter "Pickup_Landmark_Tree_Palm 4" 2 at 22 -22 r=7 seed=7717 free=5
place DeadTree2 - at 20 -6 ground yaw=40
place DeadTree3 - at -22 14 ground yaw=200
place Creature_Hyena hyenas at -26 -6 ground
prop hyenas creature.count=2
call dirt x=0 z=0 r=36 n=3 seed=7718
call treasure x=-24 z=-6 r=10 n=1 seed=7711
call shallows r=72 deep=5 n=2 seed=771
place Creature_Turtle turtles at 40 -40 h=-2
prop turtles creature.count=2

info title=Geiger Isle
info author=Custom Islands
info description=A black volcanic isle with a fenced yard of leaking barrels, a decontamination tent, a guard's hut and a radio mast - and a dark bunker in the rock hill where rats and roaches nest. Hyenas on the grass, a supply jetty off the south beach. No quest - an island to explore.

note gatesign Warning sign | DANGER - RESTRICTED AREA\nContaminated ground. No entry without a suit.\nDo not open the drums. Do not drink the water from the bunker.
note hutbox Guard's box | The last guard's box: a torch with no battery, a roll of tape, some rope and a scrap of a duty roster.
loot hutbox Rope*2;Scrap*3;Bolt*2;Plank*4
prop hutbox loot.refill=0
note yardcrate Crate in the yard | Stencilled SPARES. Spare it is.
loot yardcrate MetalIngot*2;Hinge*2;Nail*8
prop yardcrate loot.refill=0
note bunkerchest Bunker locker | Deep in the bunker, behind the drums: whatever was worth keeping down here.
loot bunkerchest Battery*2;CopperIngot*2;MetalIngot*3;Bolt*3
prop bunkerchest loot.refill=0
note jettycrate Crate on the jetty | The last delivery nobody came down to collect.
loot jettycrate Plank*6;Rope*2;Glass*2
prop jettycrate loot.refill=0

save Geiger Isle
