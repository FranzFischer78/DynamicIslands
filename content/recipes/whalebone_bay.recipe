place Block_Wall_Wood stationwall at 0 2.25 y=0.1 yaw=90
place Block_Wall_Window_Wood stationwall at 4.5 0.75 y=0.1 yaw=90
place Block_Wall_Wood stationwall at 4.5 2.25 y=0.1 yaw=90
call corners w=3 d=2
