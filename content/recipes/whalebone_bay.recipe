# --- Raft's special features (lib_features; the user, 2026-10-10: every Raft feature on more than one island): the
# cooper's workshop padlocked (Vasagatan's padlock door in its doorway), his strongbox behind it; the bolt cutters in a
# tool chest on the shelf south of the flensing plan
call keydoor x=14.751 z=-0.5 h=2.4 yaw=0 door=UT_Skyscraber01PadlockDoor key=Vasagatan_BoltCutter alias=workshopdoor vault=workshopvault vx=15.8 vz=-1.3 vh=2.4 vyaw=270 items=MetalIngot*3;Bolt*4;Rope*2 kx=27 kz=-8 kr=4 seed=611 keychest=cutterchest keytitle="Flenser's tool chest" keyitems=Rope*2;Nail*6
prop workshopdoor on.use=hide|\nshow|workshopvault\nmessage||The cutters bite, the padlock drops into the snow of wood shavings. The cooper kept his strongbox in here.
prop workshopdoor else.use=message||A company padlock, rusted shut. The flensers kept bolt cutters in their tool chest on the shelf past the flensing plan.

# ===== The flensing plan, the harpoon cannon, the rendering tanks ======================================================
# (a broad deck on the shelf, plank edges, a slipway down into the bay; the cannon at its seaward edge, aimed at the bay)
for fx 23.54 34 5.23
place Relay_Floor_deck - at $fx 7.5 h=2.3
place Relay_Floor_deck - at $fx 2.27 h=2.3
next
line Block_Wall_Fence_Plank from 18.4 -2.9 to 18.4 7.4 step=1.46 h=2.45
line Block_Wall_Fence_Plank from 34 -2.9 to 34 7.4 step=1.46 h=2.45
ramp Block_Floor_Wood from 29 7.6 2.4 to 29 15 -1.5 len=1.5 top=0
ramp Block_Floor_Wood from 30.5 7.6 2.4 to 30.5 15 -1.5 len=1.5 top=0
ramp Block_Floor_Wood from 32 7.6 2.4 to 32 15 -1.5 len=1.5 top=0
# (the gun's barrel set on its base; a stub of post inside it carries it - the base has nothing solid)
place UT_Harpoon_Base - at 22 6.5 h=3.01
place Block_Pillar_Wood - at 22 6.5 h=2.45 sy=0.48
place UT_Harpoon_Barrel cannon at 22 6.5 h=4.01
place Zone_Trigger flensing at 24 4 h=3.6
place UT_WaterTank tanks at 41 -3.5 h=2.3
place UT_WaterTank tanks at 41 2 h=2.3

