place "Box Small" churchcoal at 2.4 2.35 y=0.1 sit yaw=10
pop
push at -21.75 40 h=6
call floors w=1 d=1 y=0.1
place Block_Wall_Wood churchwall at 0.75 0 y=0.1
place Block_Wall_Wood churchwall at 0 0.75 y=0.1 yaw=90
place Block_Wall_Wood churchwall at 1.5 0.75 y=0.1 yaw=90
place Block_Wall_Wood churchwall at 0.75 1.5 y=0.1
place Block_Floor_Wood - at 0.75 0.75 y=2.6
place Block_Wall_Wood churchwall at 0.75 0 y=2.6
place Block_Wall_Wood churchwall at 0 0.75 y=2.6 yaw=90
place Block_Wall_Wood churchwall at 1.5 0.75 y=2.6 yaw=90
place Block_Wall_Wood churchwall at 0.75 1.5 y=2.6
place Block_Roof_Wood_Pyramid - at 0.75 0.75 y=5.0
pop
# (the graveyard west of the church: six wooden markers inside a plank fence)
for gz 44 50 2
place Placeable_Sign - at -24.4 $gz h=6 yaw=90
place Placeable_Sign - at -22.8 $gz h=6 yaw=90
next
line Block_Wall_Fence_Plank from -25.4 42.8 to -25.4 51.5 step=1.46 h=6
line Block_Wall_Fence_Plank from -25.4 51.6 to -21.5 51.6 step=1.4 h=6
line Block_Wall_Fence_Plank from -25.4 42.6 to -21.5 42.6 step=1.4 h=6

# ===== The manager's house above the church: his diary on the table, his strongbox =====================================
# (Balboa's log house, its porch east over the bay; its floor 10.31 m)
place Balboa_Shack villahouse at -37 32 h=9.65 yaw=0
place Placeable_Table_Basic - at -38 33.5 h=11.5 drop yaw=0
