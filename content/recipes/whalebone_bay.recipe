place Block_Wall_Wood churchwall at 3.75 10.5 y=0.1
for cz 0.75 9.75 1.5
place Block_Wall_Wood churchwall at 0 $cz y=0.1 yaw=90
next
for cz 0.75 8.25 1.5
place Block_Wall_Wood churchwall at 4.5 $cz y=0.1 yaw=90
next
call corners w=3 d=7
roof 3 7 at 0 0 y=0.1 wood
place Bench_01 - at 1.1 2 y=0.1 sit yaw=0
place Bench_01 - at 1.1 3.5 y=0.1 sit yaw=0
place Bench_01 - at 3.4 2 y=0.1 sit yaw=0
place Bench_01 - at 3.4 3.5 y=0.1 sit yaw=0
place Bench_01 - at 3.4 5 y=0.1 sit yaw=0
place Placeable_Piano - at 1.05 6.4 y=0.1 sit yaw=0
place Balboa_DecorationPrefabBase_Table - at 2.25 8.5 y=0.1 sit yaw=90
place Loot_ChestSmall altarbox at 2.25 8.5 y=0.1 sit yaw=180
place Placeable_Candelabra - at 0.5 9.9 y=0.1 sit
place Placeable_Candelabra - at 2.25 10.0 y=0.1 sit
place Placeable_Table_Square_Tall - at 3.9 5.6 y=0.1 sit
place Note_Book register at 3.9 5.6 y=1.6 drop yaw=200
pop
# (the stove room: an annex of 2 x 2 cells on the church's north-east, its doorway from the nave)
push at -15.75 49 h=6
call floors w=2 d=2 y=0.1
place Block_Wall_Wood churchwall at 0.75 0 y=0.1
place Block_Wall_Wood churchwall at 2.25 0 y=0.1
place Block_Wall_Wood churchwall at 0.75 3 y=0.1
place Block_Wall_Wood churchwall at 2.25 3 y=0.1
place Block_Wall_Wood churchwall at 3 0.75 y=0.1 yaw=90
place Block_Wall_Window_Wood churchwall at 3 2.25 y=0.1 yaw=90
call corners w=2 d=2
roof 2 2 at 0 0 y=0.1 wood
