# Whalebone Bay - a themed island, three times the size (x3). Inspiration: films and stories of the southern whaling
# stations (a rusting station in a snowy bay, a little white church, whale catchers sunk at the quay, a harpoon cannon still
# aimed at the bay) - the mood only, never named on the island.
# A snowy crescent (Shape 6, Style 1) round a bay that opens to the north-east. The station on a shelf along the bay's
# south shore (2.3 m, x -13..51): the boiler house and the coal store at its west end, the steam crane and the quay (x
# 6..10.5, out north to z 19.5) in the middle, the workshop, the flensing plan with its harpoon cannon, the rendering tanks,
# the old catcher drawn up on the beach at its east end; the barracks on the west shore; the white church on a terrace up
# the west arm (-19 46, 6 m) and the manager's house above it (-37 32, 10 m); the point at the east horn (60 8, 5 m).
# The catcher Skua lies 7 m down at the quay's end; the bay's middle is dug to 12 m for the old whale and her calf.
# Quest "The Last Whale" (14 steps): the quay, the notice board, the manager's house and diary, the bears in the boiler
# house, three sacks of coal, the steam crane, the sunk catcher hooked (a dive), the payroll lifted, the pastor's register,
# the firing pin under the altar, the flensing plan, the cannon spiked and the whale's return, the manager's strongbox.
include lib_relay
include lib_huts
include lib_sea
include lib_features
new
gen Trees=0.08 Bushes=0.15 Rocks=0.15 Harvest=0.05 BeachThings=0.3
gen Seed=9019 Radius=78 Height=30 Roughness=0.45 Peaks=2 Shape=6 Style=1 BeachWidth=0.5 Cliffs=0.4 PeakShape=0.4
gen SeaFloor=0 Shelf=0.45 Seabed=1
gen Water=0.5 SeaRocks=0.5 SeaFinds=0.2 Sunken=0.4 Hostiles=0 Friendly=0 SeaLife=0
generate

# ===== The land ==========================================================================================================
# (ramps: flatten dabs from one height to another along a line - the trails up to the church, the house and the point)
macro dabs x1 z1 h1 x2 z2 h2 n=10 r=2.6
for i 0 $n
brush flatten at {$x1+($x2-$x1)*$i/$n} {$z1+($z2-$z1)*$i/$n} r=$r s=20 frames=25 h={$h1+($h2-$h1)*$i/$n}
next
end
# (the bay: its middle dug to 12 m for the whales, a hollow 7 m deep at the quay's end for the sunk catcher, the quay's bed)
brush flatten at 32 40 r=16 s=20 frames=60 h=-12
brush smooth at 32 40 r=22 s=10 frames=20
brush flatten at 32 40 r=12 s=20 frames=40 h=-12
brush flatten from 0 28 to 16 28 r=6 s=20 frames=60 h=-7
brush flatten from 8.25 9 to 8.25 21 r=4 s=20 frames=40 h=-3
# (the station's shelves: along the south shore and up the west shore; the beach for the old catcher)
brush flatten from -12 -2 to 48 -2 r=8 s=20 frames=60 h=2.3
brush flatten from -12 3 to 48 3 r=7 s=20 frames=60 h=2.3
brush flatten from -14 6 to -14 30 r=8 s=20 frames=60 h=2.3
brush flatten at 42 13 r=6 s=20 frames=40 h=0.3
# (the church's terrace up the west arm, the manager's pad above it, the point at the east horn)
brush flatten at -19 46 r=9 s=20 frames=60 h=6
brush flatten at -34 32 r=8 s=20 frames=60 h=10
brush flatten at 60 8 r=5 s=20 frames=40 h=5
# (the trails)
call dabs -12 33 2.3 -16 40 6 n=10 r=3.6
call dabs -26 41 6 -28 34.5 10 n=10 r=3.4
call dabs 48 2 2.3 57 7 5 n=8
# (snow painted back over the cuts)
brush grass from -12 0 to 48 0 r=10 s=20 frames=30
brush grass from -14 6 to -14 30 r=9 s=20 frames=30
# (the station, the trails and the bay cleared of the generator's rocks, drifts and ice)
clear from -13 0 to 51 0 r=10
clear from -14 6 to -14 34 r=9
clear at -19 46 r=10
clear at -34 32 r=9
clear at 60 8 r=6
clear at 22 30 r=30
clear from -26 41 to -28 34.5 r=3
clear from 48 2 to 57 7 r=3

# ===== The quay and the steam crane =====================================================================================
# (the quay: three blocks wide on posts from its bed, its deck 2.45 m, out north from the shelf's edge; the notice board at its
# root; a barrel and scrap under it)
push at 10.5 4.5 h=-3 yaw=-90
call boardwalk n=10 wide=3 y=5.45 rs=none rn=none
pop
place Note_Board notice at 4.3 2 h=2.3 yaw=180
place Zone_Trigger quay at 8.25 12 h=3.5
place Loot_SunkenBarrel quaybarrel at 12.5 14 ground sit yaw=30
place "Pickup_Landmark_Scrap 2_OceanBottom" - at 11.5 17 ground
place "Pickup_Landmark_Scrap 2_OceanBottom" - at 5 13 ground
place "Pickup_Landmark_Scrap 2_OceanBottom" - at 12 11 ground
# (the strongbox the crane lifts onto the quay, hidden until it does)
place "Box Big" liftedbox at 8.25 17 h=2.45 sit yaw=10
# (Utopia's crane on the shelf at the quay's root, its jib out over the bay; two of Raft's ladders up to its cab's
# platform (4.4 m over the shelf), its lever on the platform)
place UT_ElectricityIsland_Crane02 crane at 1 0 h=2.3
place Block_Ladder - at -1.35 -2.44 h=2.3 yaw=0
place Block_Ladder - at -1.35 -2.44 h=4.72 yaw=0
place UT_JumpPuzzle_LiftMechanism_Lever cranelever at -0.4 -1.2 h=8.83 yaw=90
place Zone_Trigger cranecab at 0.2 -1.4 h=7.8

# ===== The sunk catcher Skua, 7 m down at the quay's end ==============================================================
place BoatStranded skua at 8 28 h=-3.6 yaw=90
place "Box Big" sunkbox at 14 25 h=-7 sit yaw=20
place Zone_Trigger catcherzone at 8.25 23 h=-4

