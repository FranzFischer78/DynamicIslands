place "VG_DecorationPrefabBase_Engine Variant" boiler at 2.5 1.8 y=0.1 sit yaw=0
place RT_Pipe - at 0.3 1.6 y=-1.4 yaw=0
place RT_PipeDownStraight - at -0.73 2.2 y=2.0
place RT_PipeDownStraight - at -0.73 2.2 y=4.2
place Creature_PolarBear bears at 5.5 3.5 y=0.3
place Zone_Trigger boilerhouse at 3.75 3 y=1.5
pop
# --- The coal store west of it (a lean-to of 2 x 2 cells, open to the shelf): a coal heap, sacks, the last sack -------
push at -15.5 3 h=2.3
call floors w=2 d=2 y=0.1
place Block_Wall_Wood stationwall at 0.75 0 y=0.1
place Block_Wall_Wood stationwall at 2.25 0 y=0.1
place Block_Wall_Wood stationwall at 3 0.75 y=0.1 yaw=90
place Block_Wall_Wood stationwall at 3 2.25 y=0.1 yaw=90
call corners w=2 d=2
