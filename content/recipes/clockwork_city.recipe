place TP_LaserControlPanel_lever handIII at -5.6 -2.4 y=0 sit yaw=90
place TP_LaserControlPanel_lever handVI at -5.6 -1.6 y=0 sit yaw=90
place TP_LaserControlPanel_lever handIX at -5.6 -0.8 y=0 sit yaw=90
place Zone_Trigger clockroom at -3 0 y=1.5
place Pickup_Landmark_Plastic3_Land - at -2.0 -1.6 y=0.3 drop yaw=75
pop
push at 83 44.5 h=30.05
call rt_storey floor=RT_Floor
