prop crypbubbles atmo.particles=bubbles
prop crypbubbles zone.radius=3
prop observatory zone.id=observatory
prop observatory zone.radius=4
prop observatory zone.repeat=never
prop observatory zone.message=The observatory - and the birds that kept the thief up here want you out of it!
prop screechers creature.count=2
prop screechers creature.respawn=0
prop screechers creature.zone=observatory
prop towerbalcony zone.id=towerbalcony
prop towerbalcony zone.radius=5
prop towerbalcony zone.message=The clock tower's balcony. The great face above you says twenty past nothing.
prop clockroom zone.id=clockroom
prop clockroom zone.radius=3
prop clockroom zone.message=The clock room: an empty heart of cogs, a panel of hand levers, a plaque.
prop vault zone.id=vault
prop vault zone.radius=2.5
prop vault zone.message=The founder's vault under the tower, ticking softly all round you.
prop puffers creature.count=2
prop hens creature.count=3
prop goats creature.count=3
prop turtles creature.count=2
prop dolphins creature.count=2

prop shuttle1 obj.name=shuttle1
prop shuttle1 beh.use=Pull the shuttle lever (to the plaza)
prop shuttle1 if.use=has|story:winder|1
prop shuttle1 on.use=message||The platform shudders, the winding key turns in its socket, and it glides out over the water towards the plaza stack -\nsound||event:/exploring/zipline/zipline_engine\nwait|4\nteleport|plazalanding\nmessage||- and docks at the plaza.
prop shuttle1 else.use=message||The shuttle's lever has a winding hole - the city's key.
prop shuttle2 obj.name=shuttle2
prop shuttle2 beh.use=Pull the shuttle lever (to the gearworks)
prop shuttle2 if.use=has|story:winder|1
prop shuttle2 on.use=message||Out over the water again, towards the stone piers of the gearworks -\nsound||event:/exploring/zipline/zipline_engine\nwait|4\nteleport|gearlanding\nmessage||- and docks at the gearworks' platform.
prop shuttle2 else.use=message||The shuttle's lever has a winding hole - the city's key.
prop shuttle3 obj.name=shuttle3
prop shuttle3 beh.use=Pull the shuttle lever (up to the observatory)
prop shuttle3 if.use=has|story:winder|1
prop shuttle3 on.use=message||The platform climbs as it slides, up and up towards the highest stack -\nsound||event:/exploring/zipline/zipline_engine\nwait|4\nteleport|obslanding\nmessage||- and docks under the observatory.
prop shuttle3 else.use=message||The shuttle's lever has a winding hole - the city's key.
prop shuttle4 obj.name=shuttle4
prop shuttle4 beh.use=Pull the shuttle lever (to the clock tower)
prop shuttle4 if.use=has|story:winder|1
prop shuttle4 on.use=message||The last shuttle runs out along a cable towards the clock tower, the whole city below you -\nsound||event:/exploring/zipline/zipline_engine\nwait|4\nteleport|towerbalcony\nmessage||- and bumps against the tower's balcony.
prop shuttle4 else.use=message||The shuttle's lever has a winding hole - the city's key.
prop plazalanding obj.name=plazalanding
prop plazalanding zone.radius=2
prop gearlanding obj.name=gearlanding
prop gearlanding zone.radius=2
prop obslanding obj.name=obslanding
prop obslanding zone.radius=2
prop towerbalcony obj.name=towerbalcony

quest title=Setting the Hour
quest intro=A city of clockwork on sea stacks, stopped mid-tick. The clockmaker's welcome is at the top of the harbour steps.
# Chapter 1 - arrival
step reach|harbour|1|Tie up at the harbour stack
step read|The clockmaker's welcome|1|Read the clockmaker's welcome
step collect|story:winder|1|Take the winding key from the harbourmaster's box
step reach|plaza|1|Ride the first shuttle to the plaza
step read|The city timetable|1|Read the city timetable
# Chapter 2 - the timed doors
step collect|story:gear|1|Strike the gong and get the first gear out of the Hall of Hours in thirty seconds
step kill|Rat|4|Clear the rats out of the gearworks
step collect|story:gear|2|Drop the counterweight and reach the gearworks' vault in twenty seconds
step reach|undercroft|1|Swim through the sea door into the flooded undercroft
step collect|story:gear|3|Find the third gear in the undercroft
# Chapter 3 - the shuttles
step reach|observatory|1|Ride the shuttles up to the observatory
step kill|Screecher|2|Drive off the screechers
step read|The thief's diary|1|Read the thief's diary
step collect|story:mainspring|1|Take the mainspring from the thief's stash
step reach|towerbalcony|1|Ride the last shuttle down to the clock tower
# Chapter 4 - the clock
step reach|clockroom|1|Climb to the clock room
step collect|story:clockkey|1|Fit the gears and the mainspring into the clock's heart
step read|The founder's plaque|1|Read the founder's plaque
step reach|vault|1|Set the hands to the founding hour - and go down into the founder's vault
step open|The founder's vault|1|Open the founder's vault
quest done=The clock strikes the hour and Horologe winds itself again: cogs turning, figures walking their rounds, shuttles sliding over the water. Teodor Vance's city keeps time - thanks to you.
quest reward=CopperIngot*3;Bolt*6;Cooked_GenericMeat*3

save The Clockwork City
