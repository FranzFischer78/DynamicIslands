prop gearworks zone.repeat=never
prop gearworks zone.message=The gearworks - belts, wheels, and rats nesting in all of it!
prop rats creature.count=4
prop rats creature.respawn=0
prop rats creature.zone=gearworks
prop undercroft zone.id=undercroft
prop undercroft zone.radius=5
prop undercroft zone.message=The undercroft, under water: pipes, valves, a bell of trapped air.
