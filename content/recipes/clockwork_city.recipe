push at -42 -46 h=15.05
call rt_storey f1=RT_WallDoor1 f2=RT_WallWindow1 l2=RT_WallWindow1
place RT_Floor - at 0 4.5 y=3
place Loot_ChestSmall harbourbox at -1.2 3.4 y=0 sit yaw=180
place Placeable_Table_Basic - at -4.6 3.2 y=0 sit
place "Pickup_Landmark_Scrap 3_Land" - at -2.8 0.2 y=0.3 drop yaw=44
place Pickup_Landmark_Plank_Land - at -4.0 0.8 y=0.3 drop yaw=129
pop
place Note_Sign welcome at -38.5 -54 h=15.05 sit yaw=180
place RT_SatteliteDisc - at -50 -55 h=15.05 sit scale=0.6 yaw=200
