# --- The clock tower on the north-east stack: three rooms stacked - the founder's vault at the bottom (its door a stone
# slab that sinks when the clock strikes), the clock room in the middle with the balcony where the last shuttle lands, a
# ladder from the balcony down to the vault's door; the top room with a clock face on every side; the clock's heart, the
# founder's plaque, the four hand levers; the chimes and the city's tick (hidden till the city wakes) ----------------------
push at 83 44.5 h=24.05
call rt_storey f1=none f2=RT_Wall1
