# The Clockwork City - a new island of the library, seven times the size (x7)
# Horologe, a city of clockwork on tropical sea stacks: the harbour stack (south-west), the plaza stack with the Hall of
# Hours (north-west), the gearworks on a stone pier platform in the sea (east of the plaza), the observatory on the
# highest stack (south) and the clock tower on the far stack (north-east) - shuttles between them, doors that open on the
# gong for half a minute, brass figures frozen mid-step. The clock tower's heart was stolen; set it right and the city
# wakes.
# Quest "Setting the Hour" (20 steps in 4 chapters): arrival, the timed doors (a 30 s hall, a 20 s vault, a flooded
# undercroft), the shuttles up to the observatory and the thief, the clock - its heart refitted, the founding hour set.
#
# Built by the recipe player (CIRecipe clockwork_city) through the editor's own operations.
include lib_rt
include lib_huts
include lib_sea
new
# (nature: tropical, Like Raft - palms and jungle on the stacks' tops round the buildings)
gen Trees=0.28 Bushes=0.28 Rocks=0.43 Harvest=0.24 BeachThings=0.3
gen Seed=9223 Radius=119 Height=30 Roughness=0.45 Peaks=8 Shape=3 Style=0 BeachWidth=0.3 Cliffs=0.85 PeakShape=0.5
gen Water=0.5 SeaRocks=0.4 SeaFinds=0.3 Sunken=0.4 Hostiles=0
generate

# --- Terrain: the stacks' tops levelled - the harbour stack 15 m, the plaza stack 20 m, the observatory's 28 m, the clock
# tower's 24 m; the undercroft's pit by the plaza stack's west foot (7 m under the sea) ------------------------------------
brush flatten at -45 -50 r=9 s=20 frames=300 h=15
brush flatten at -3 32 r=12 s=20 frames=300 h=20
brush flatten at -3 24 r=9 s=20 frames=300 h=20
brush flatten at 20 -12 r=7 s=20 frames=300 h=28
brush flatten at 80 40 r=8 s=20 frames=300 h=24
brush flatten at 80 46 r=6 s=20 frames=300 h=24
brush flatten at -28 30 r=6 s=20 frames=300 h=-7
brush sand at -3 36 r=7 s=20 frames=20
clear at -45 -50 r=11
clear at -3 32 r=14
clear at 20 -12 r=8
clear at 80 40 r=9
clear at -28 30 r=7

# --- The harbour stack: the quay on its south shore, a tower of posts with two ladders up its south face to a landing at
# the top; the harbourmaster's office (its box: the winding key), the clockmaker's welcome at the ladder's top, the gong;
# the first shuttle's lever on the north edge -------------------------------------------------------------------------------
push at -50 -64.5 h=-3
call boardwalk n=6 wide=1 y=4.6
pop
for lv 0 2 1
place RT_PillarThick - at -42.5 -61 h={-3+6*$lv}
place RT_PillarThick - at -41 -61 h={-3+6*$lv}
next
