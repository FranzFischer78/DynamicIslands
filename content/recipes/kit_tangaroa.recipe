place OuterDoorFrame odf at 19 -4
place KeyCard card at 24 -4 y=0.05
place Tangaroa_BoardRoomKit_Table brt at 30 -4
# row 4 (z -30): the floating base, the underground room's floor and walls
place Flotation flot at -30 -32
place FlotationLids flotlid at -30 -32
place FlotationBase_Ladders flotl at -30 -32
