# Kit check (not content): Tangaroa's apartment modules, floating base, harbour platform, underground room, hatch, statue
new
gen Seed=1 Radius=60 Height=4 Shape=4 Roughness=0.1 ObjectDensity=0 Trees=0 Bushes=0 Rocks=0 BeachThings=0 Harvest=0
gen Hostiles=0 Friendly=0 SeaLife=0 Water=0 SeaRocks=0 SeaFinds=0 Sunken=0
generate
brush flatten at 0 0 r=60 s=20 frames=80
# row 1 (z 24): the apartments' inner modules
place Apartment_Int_BaseFloor af at -36 24
place Apartment_Int_BaseMidMid amm at -29 24
place Apartment_Int_BaseMidMidWindow ammw at -22 24
place Apartment_Int_BaseMidCorner amc at -15 24
