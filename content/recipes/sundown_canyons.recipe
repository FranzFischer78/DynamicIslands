place UT_Skyscraber01PadlockDoor vaultdoor at -3.555 4.5
pop
push at -93.5 -20 h=3.05 yaw=90
call rt_storey f1=none f2=none
pop
push at -102.5 -20 h=6.05 yaw=90
call rt_storey b1=none b2=none f1=none f2=none l1=none l2=none l3=none r1=none r2=none r3=none
