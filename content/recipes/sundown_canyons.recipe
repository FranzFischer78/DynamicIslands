place Block_Wall_Fence_Plank - at -30.4 -35 h=48.5 yaw=0
place Block_Wall_Fence_Plank - at -28.6 -35 h=48.5 yaw=0
place Block_Wall_Fence_Plank - at -33 -34.2 h=48.5 yaw=90
