# --- The derailment at the bend: the engine off the rails, the express car on its side with its safe beside it, the ore
# wagons tipped over, the tool car upright with its box, the mail sack; the logs the gang laid across the line ------------
place CaravanBarebones1 - at -44.5 -70 ground yaw=-20 tilt=12
# (the engine's tank thrown off beside it on the canyon floor: lying across the engine it ran into the canyon's north
# bank, its middle buried 1 m, CIGroundIslands)
place Placeable_FuelTank - at -43.94 -73.95 sit rot=0,340,90
