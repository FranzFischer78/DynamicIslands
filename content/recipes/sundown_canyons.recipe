# Sundown Canyons - a themed island, ten times the size (x10). Inspiration: westerns and the frontier-town theme park
# film (a dusty town with a saloon, a jail and a bank; a silver train derailed in a canyon; a mine with a lift; an outlaw
# gang's fort on a mesa; rustled stock) - the mood only, never named on the island.
# A big red-rock island (Shape 0, Style 2, terraced): the town of Sundown on the flat west shore (main street x -115,
# z -38..12), the railroad from its station (-101 -46) east up the canyon cut along the mesa's south side (floor 4 m) -
# the derailment at its bend (-46 -73), the section house (-28 -82), the blown trestle over the river gorge that the sea
# reaches up from the south coast (x 4), the Lucky Strike mine up the switchbacks in the canyon's north wall (mouth
# 24 -58, 11.5 m); Black Mesa in the middle, its top levelled at 42 m with the gang's fort (-26 -24), the mine lift's top
# station (-2 -34) and the ladder trail down its north face (x -24); the Double Bar ranch on the east plain (104 4) and the
# box canyon behind it (66 -6).
# Quest "The New Sheriff" (36 steps, 6 chapters): Sundown (6), the ranch (5), the railroad (7), the mine (5), the fort
# (8), the bank (5).
include lib_rt
include lib_huts
include lib_relay
include lib_sea
include lib_features
new
gen Trees=0.38 Bushes=0.5 Rocks=0.55 Harvest=0.25 BeachThings=0.3
gen Seed=9026 Radius=142 Height=45 Roughness=0.5 Peaks=3 Shape=0 Style=2 BeachWidth=0.5 Cliffs=0.5 PeakShape=0.35 Valleys=0.7 Terraces=0.4
gen Water=0.5 SeaRocks=0.3 SeaFinds=0.2 Sunken=0.4 Hostiles=0 Friendly=0 SeaLife=0
generate

# ===== The land ==========================================================================================================
# (ramps: flatten dabs from one height to another along a line - switchbacks, a doorstep)
macro dabs x1 z1 h1 x2 z2 h2 n=10 r=2.6
for i 0 $n
brush flatten at {$x1+($x2-$x1)*$i/$n} {$z1+($z2-$z1)*$i/$n} r=$r s=20 frames=25 h={$h1+($h2-$h1)*$i/$n}
next
end
# (Black Mesa: its top levelled at 42 m, reaching north to the ladder trail's head)
brush flatten from -34 -24 to -12 -24 r=26 s=20 frames=80 h=42
# (the ladder trail down its north face: three cliff bands 6 m high, each faced with timber cribbing (at z -4.5, 1.5 and
# 7.5) with a landing of planks behind its top; ledges at 36 and 30 m between them, the foot at 24 m - drawn in strokes
# across the face from the top down)
brush flatten from -30 -9 to -18 -9 r=2 s=20 frames=30 h=42
brush flatten from -30 -8 to -18 -8 r=2 s=20 frames=30 h=42
brush flatten from -30 -7 to -18 -7 r=2 s=20 frames=30 h=42
brush flatten from -30 -6 to -18 -6 r=2 s=20 frames=30 h=42
brush flatten from -30 -5 to -18 -5 r=2 s=20 frames=30 h=42
brush flatten from -30 -4 to -18 -4 r=2 s=20 frames=30 h=36
brush flatten from -30 -3 to -18 -3 r=2 s=20 frames=30 h=36
brush flatten from -30 -2 to -18 -2 r=2 s=20 frames=30 h=36
brush flatten from -30 -1 to -18 -1 r=2 s=20 frames=30 h=36
brush flatten from -30 0 to -18 0 r=2 s=20 frames=30 h=36
brush flatten from -30 1 to -18 1 r=2 s=20 frames=30 h=36
brush flatten from -30 2 to -18 2 r=2 s=20 frames=30 h=30
brush flatten from -30 3 to -18 3 r=2 s=20 frames=30 h=30
brush flatten from -30 4 to -18 4 r=2 s=20 frames=30 h=30
brush flatten from -30 5 to -18 5 r=2 s=20 frames=30 h=30
brush flatten from -30 6 to -18 6 r=2 s=20 frames=30 h=30
brush flatten from -30 7 to -18 7 r=2 s=20 frames=30 h=30
brush flatten from -30 8 to -18 8 r=2 s=20 frames=30 h=24
brush flatten from -30 9 to -18 9 r=2 s=20 frames=30 h=24
brush flatten from -30 10 to -18 10 r=2 s=20 frames=30 h=24
brush flatten from -30 11 to -18 11 r=2 s=20 frames=30 h=24
brush flatten from -30 12 to -18 12 r=2 s=20 frames=30 h=24
# (the town on the flat west shore: main street and the building plots, the wharf's head)
brush flatten from -115 -44 to -115 12 r=20 s=20 frames=60 h=3
brush flatten from -104 -17 to -90 -17 r=8 s=20 frames=60 h=3
brush flatten at -133 -28 r=7 s=20 frames=60 h=3
brush flatten from -100 -2 to -96 8 r=7 s=20 frames=60 h=3
brush flatten from -93 -5 to -91 6 r=6 s=20 frames=60 h=3
brush flatten from -106 10 to -101 21 r=8 s=20 frames=60 h=3
brush flatten at -104 -34 r=6 s=20 frames=60 h=3
brush flatten at -126 10 r=5 s=20 frames=40 h=3
brush flatten from -112 -47 to -96 -47 r=8 s=20 frames=60 h=3
brush flatten at -130 -20 r=5 s=20 frames=40 h=3
brush flatten at -128 -11 r=10 s=20 frames=60 h=3
brush flatten at -100 -44 r=9 s=20 frames=60 h=3
# (the wharf's channel through the beach)
brush flatten from -158 -20 to -137 -20 r=4 s=20 frames=60 h=-1.2
# (the railroad's canyon from the station east along the mesa's south side, its floor at 4 m)
brush flatten from -93 -54 to -82 -60 r=7 s=20 frames=60 h=4
brush flatten from -82 -60 to -64 -67 r=7 s=20 frames=60 h=4
brush flatten from -64 -67 to -46 -73 r=7 s=20 frames=60 h=4
brush flatten from -46 -73 to -26 -77 r=7 s=20 frames=60 h=4
brush flatten from -26 -77 to -9 -75 r=7 s=20 frames=60 h=4
brush flatten from -9 -75 to 17 -75 r=7 s=20 frames=60 h=4
brush flatten from 17 -75 to 32 -68 r=7 s=20 frames=60 h=4
brush flatten at -28.5 -82.5 r=5 s=20 frames=40 h=4
# (the river: the sea let in from the south coast up a gorge through the terrace and across the canyon, 7 m deep)
brush flatten from 4 -168 to 4 -66 r=9 s=20 frames=80 h=-7
# (the Lucky Strike: switchbacks up the canyon's north wall to the ledge at the mine's mouth, the gallery's trench)
call dabs 16 -68.5 4.2 38 -64.5 8.2 n=12
brush flatten at 40 -62.5 r=3 s=20 frames=30 h=8.4
call dabs 38 -60.5 8.6 28 -58 11.5 n=6
brush flatten at 25 -59.5 r=7 s=20 frames=40 h=11.5
brush flatten from 24 -60 to 24 -26 r=9 s=20 frames=60 h=11.5
# (the trench as wide as the bear cave's back gallery, 16 m: its walls ran steeply through the gallery's sides, and the
# cells cut there for it reached up out of the rock - a slit of sky on the west wall)
brush flatten from 16 -49 to 16 -28 r=5 s=20 frames=50 h=11.5
brush flatten from 32 -49 to 32 -28 r=5 s=20 frames=50 h=11.5
brush flatten at 30.5 -61.5 r=4 s=20 frames=30 h=11.5
# (the Double Bar ranch on the east plain; the box canyon behind it, cut into the hills)
brush flatten at 106 2 r=22 s=20 frames=60 h=13.5
brush flatten at 110 -13 r=8 s=20 frames=60 h=13.5
brush flatten at 99 12 r=12 s=20 frames=60 h=13.5
brush flatten from 90 -6 to 68 -6 r=7 s=20 frames=60 h=13.5
brush flatten at 64 -6 r=9 s=20 frames=60 h=13.5
# (the sites and the trails cleared of the generator's trees, bushes and rocks)
clear from -115 -44 to -115 14 r=22
clear from -104 -17 to -88 -17 r=9
clear from -158 -20 to -128 -20 r=5
clear from -100 -51 to -82 -60 r=8
clear from -82 -60 to -46 -73 r=8
clear from -46 -73 to -9 -75 r=8
clear from -9 -75 to 32 -68 r=9
clear from 4 -150 to 4 -66 r=10
clear from 16 -68 to 40 -60 r=5
clear from 24 -62 to 24 -26 r=8
clear from -34 -24 to -2 -30 r=20
clear from -26 -6 to -24 12 r=6
clear at 106 2 r=22
clear from 90 -6 to 62 -6 r=9
clear from -96 8 to -78 40 r=3
clear from -78 40 to -40 58 r=3
clear from -40 58 to 40 60 r=3
clear from 40 60 to 88 32 r=3
clear from 88 32 to 100 16 r=3
clear from -24 12 to -40 30 r=3

# ===== Chapter 1 - Sundown ===============================================================================================
