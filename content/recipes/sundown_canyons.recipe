# --- The ladder trail down the mesa's north face: three ladders, each from a ledge to the band above; the signpost at its
# foot, the mayor's proclamation and the zone hidden until the signal --------------------------------------------------
# (each band: a wall of timber cribbing three planks high, a landing of planks behind its top, the ladder up its face)
# (lo: how far under the ledge the lowest course starts; t: its thickness - see the middle band)
macro cribband z hl lo=1 t=1
for cx -26.25 -21.75 1.5
place Block_Wall_Wood - at $cx $z h={$hl-$lo} sz=$t
place Block_Wall_Wood - at $cx $z h={$hl+1.43}
place Block_Wall_Wood - at $cx $z h={$hl+3.86}
place Block_Floor_Wood - at $cx {$z-0.75} h={$hl+6}
place Block_Floor_Wood - at $cx {$z-2.25} h={$hl+6}
next
place LandmarkLadder_6m mesaladder at -24 {$z+0.25} h=$hl yaw=180
end
call cribband 7.5 24
# (its face stands half way up the slope, the ground 1.56 m over the ledge: the lowest course 25 cm higher, its top over
# the ground - a metre under, it was buried whole, CIGroundIslands; 10% thicker where it reaches into the course on it)
call cribband 1.5 30 lo=0.75 t=1.1
call cribband -4.5 36
place Balboa_DirectionSign - at -21 11 ground yaw=200
place Note_Sign proclamation at -22.6 11.4 ground yaw=180
place Zone_Trigger homeward at -24 11 y=1.5

