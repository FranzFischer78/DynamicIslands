# Castaway Knoll - a new small island of the library (ROADMAP 3d NI3), no quest - a sunken one
# A knoll under the sea, its top a forest of kelp. In a clearing on its top lies a castaway's raft that went down: her
# floor of planks broken in two, her bed, her table, her crates still lashed on. Corals, sunken barrels, Raft's finds;
# a turtle grazing in the kelp. Nothing hostile.
#
# Built by the recipe player (CIRecipe castaway_knoll) through the editor's own operations. Points (metres over the
# island's own water line; in the world it all lies 11 m lower, under the sea): the clearing at 5 m (r 7 round -2 2); the
# raft's two halves x -6..-1.5 and -1..3, z 0..3 and 1..4; her crate at -4.2 1.5, her chest at 1.5 3.3.
include lib_sea
include lib_features
include lib_ni34
new
# (nature: a sunken knoll - no land plants, kelp and coral instead)
gen Trees=0 Bushes=0 Rocks=0.3 Harvest=0 BeachThings=0
gen Seed=7406 Radius=24 Height=7 Roughness=0.4 Peaks=1 Shape=0 Style=0 BeachWidth=0.1 Cliffs=0.3 PeakShape=0.4
gen SeaFloor=0 Shelf=0.5 Seabed=2
gen Water=0.5 SeaRocks=0.35 SeaFinds=0.4 Sunken=0.5 Hostiles=0 Friendly=0 SeaLife=0.3
generate
elevation -11

# ===== The clearing on the knoll's top ===================================================================================
brush flatten at -2 2 r=7 s=20 frames=60 h=5
brush seabed at -2 2 r=9 s=20 frames=30
clear at -2 2 r=8

# ===== The lost raft: her floor broken in two on the sand, her table, crate and chest ===============================
for fx -5.25 -2.25 1.5
place FL_Foundation1 - at $fx 1.5 ground sit roll=-4
next
for fx -0.25 2.75 1.5
place FL_Foundation1 - at $fx 2.5 ground sit yaw=12 roll=6
next
place Table_Floor - at 0.6 2.4 sit yaw=12
place Loot_Crate raftcrate at -2.6 1.2 sit yaw=20
place Loot_ChestSmall raftchest at 2.2 3.4 sit yaw=192
place Reef_Barrel5 - at -7 4 ground sit roll=80

# ===== Kelp all over the knoll, corals on its flanks, sunken barrels; a turtle in the kelp ===============================
scatter SeaVine3 40 at 0 0 r=20 seed=7416 free=2
scatter SeaVine3_klump 10 at 0 0 r=20 seed=7426 free=3
scatter CylinderCoral_1 3 at 9 -6 r=4 seed=7436 free=1
scatter LeafCoral_2 3 at 9 -6 r=4 seed=7446 free=1
scatter Coral1 3 at -10 -6 r=4 seed=7456 free=1
scatter SpineCoral_3 3 at -10 -6 r=4 seed=7466 free=1
scatter Loot_SunkenBarrel 3 at 0 0 r=16 seed=7476 free=3
place Creature_Turtle turtle at 6 8 h=6
call shallows x=0 z=0 r=34 deep=8 n=1 seed=746

info title=Castaway Knoll
info author=Custom Islands
info description=A knoll under the sea, its top a forest of kelp - and in a clearing a castaway's raft that went down, broken in two, her bed and crates still on her. No quest - an island to explore.

note raftcrate The lost raft's crate | Still lashed to the planks. Whoever sailed her packed well.
loot raftcrate Plank*6;Rope*3;Nail*8;Plastic*4
prop raftcrate loot.refill=0
note raftchest The castaway's chest | A small chest under the table: a few tools, a metal detector wrapped in cloth.
loot raftchest MetalDetector*1;Hinge*2;Bolt*2
prop raftchest loot.refill=0

save Castaway Knoll
