# The Aqueduct - a new island of the library, four times the size (x4)
# An old water city on two tropical peaks: the spring house on the south-west peak's shoulder, a flooded cistern below
# it, an aqueduct striding on stone piers across the lagoon in the valley between the peaks, the sluice house on the
# lagoon's shore, and on the north-east peak the little city of Aquila round a dry fountain, its castellum where the line
# ends, its harbour on the east coast.
# Quest "Water to the City" (15 steps): five valves opened in order along the line, from the source to the city - a climb,
# a dive, a fight on the arches, a sluice, a locked tower - and the fountain runs again.
#
# Built by the recipe player (CIRecipe the_aqueduct) through the editor's own operations.
include lib_rt
include lib_huts
include lib_sea
new
# (nature: tropical, Like Raft - jungle on the peaks; the line and the city cleared)
gen Trees=0.28 Bushes=0.28 Rocks=0.43 Harvest=0.24 BeachThings=0.3
gen Seed=9217 Radius=90 Height=32 Roughness=0.4 Peaks=2 Shape=7 Style=0 BeachWidth=0.5 Cliffs=0.3 PeakShape=0.45 Lakes=0.5
gen Water=0.5 SeaRocks=0.3 SeaFinds=0.3 Sunken=0.4 Hostiles=0
generate

# --- Terrain: the valley lagoon between the peaks dug 5 m under the sea's level; the spring house's pad on the south-west
# peak (18 m) and the path up to it from the west beach; the cistern's pit by the lagoon's west end (4 m under the sea);
# the sluice house's pad on the lagoon's south-east shore; the city's square cut into the north-east peak (16 m); the
# harbour road from the east beach up to the square in two legs -----------------------------------------------------------
brush flatten from -12 2 to 8 2 r=8 s=20 frames=300 h=-5
brush flatten from -12 2 to 8 2 r=8 s=20 frames=300 h=-5
brush smooth from -12 2 to 8 2 r=12 s=10 frames=5
brush flatten at -19.5 -14 r=7 s=20 frames=200 h=18
for i 0 24 1
brush flatten at {-55+25*$i/24} {-5-23*$i/24} r=3 s=20 frames=150 h={2+10*$i/24}
next
for i 0 10 1
brush flatten at {-30+7*$i/10} {-28+11*$i/10} r=3 s=20 frames=150 h={12+6*$i/10}
next
brush smooth from -55 -5 to -30 -28 r=3 s=10 frames=6
brush flatten at -25 5 r=3 s=20 frames=300 h=-4
brush flatten at -25 5 r=3 s=20 frames=300 h=-4
brush flatten at 14 -12 r=5 s=20 frames=150 h=4
brush flatten at 22 22 r=16 s=20 frames=300 h=16
brush flatten at 22 22 r=16 s=20 frames=300 h=16
brush flatten at 22 32 r=7 s=20 frames=300 h=16
brush flatten at 31 14 r=7 s=20 frames=300 h=16
brush flatten from 0.4 7.1 to 12 22 r=3.5 s=20 frames=300 h=16
brush smooth at 22 22 r=20 s=10 frames=4
brush flatten from 86 22 to 78 24 r=3 s=20 frames=150 h=2.6
for i 0 28 1
brush flatten at {78-23*$i/28} {24+14*$i/28} r=3.6 s=20 frames=200 h={3+6*$i/28}
next
for i 0 18 1
brush flatten at {55-17*$i/18} {38-8*$i/18} r=3.6 s=20 frames=200 h={9+7*$i/18}
next
brush smooth from 86 22 to 55 38 r=3 s=10 frames=6
brush flatten at 14 -8 r=6.5 s=20 frames=300 h=4
brush smooth from 55 38 to 38 30 r=3 s=10 frames=6
brush sand at 22 22 r=12 s=20 frames=20
clear from -12 2 to 8 2 r=10
clear at -19.5 -14 r=8
clear from -14 -14 to 12 22 r=4
clear at -25 5 r=5
clear at 14 -12 r=6
clear at 22 22 r=15
clear from 78 24 to 55 38 r=3.5
clear from 55 38 to 38 30 r=3.5
clear from -55 -5 to -30 -28 r=3
clear from -30 -28 to -23 -17 r=3
clear at 86 22 r=6

# --- The spring house on the south-west peak (a radio tower room, its door east to where the line starts): the water-
# master's box with the valve key; valve one on the outlet pipe outside the door, the line's start ---------------------------
push at -19.5 -11 h=18.05 yaw=270
call rt_storey f1=RT_WallDoor1 f2=RT_Wall1 l2=RT_WallWindow1 r2=RT_WallWindow1
place RT_Floor - at 0 4.5 y=3
place Loot_ChestSmall masterbox at -1.2 3.4 y=0 sit yaw=180
place Zone_Trigger source at -3 0 y=1.5
pop
place RT_Pillar - at -13.6 -15.2 h=18 sy=0.4
place TP_Selene_DoorCrankWheel valve1 at -13.6 -15.45 h=19.1
place WaterPipe_Out_1 - at -14.2 -15.3 h=18.6
place Creature_Goat goats at -28 -26 ground

# --- The cistern by the lagoon's west end: a pit flooded to the sea's level, rubble round its rim, ladders down its north
# wall; valve two on its floor, a pocket of air in its corner, the dark ---------------------------------------------------
place VP_Rubble_Cement02 - at -20 8 ground sit yaw=90
place VP_Rubble_Cement02 - at -24 10 ground sit
for l 0 1 1
place Block_Ladder - at -25 7.4 h={-1+2.42*$l} yaw=0
next
place TP_Selene_DoorCrankWheel valve2 at -25 4 h=-4 sit rot=90,0,0
place Zone_Trigger cistern at -25 5 h=0.5
place Zone_Trigger cisternair at -23.8 4 h=-3
place Zone_Atmosphere cisternbubbles at -23.8 4 h=-3
place Zone_Atmosphere cisterndark at -25 5 h=-2

