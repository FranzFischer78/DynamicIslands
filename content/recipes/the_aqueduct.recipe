place RT_Floor aqueduct at 30 1.5 y=0 sx=0.993 sz=0.333
place RT_Floor aqueduct at 36 1.5 y=0 sx=0.993 sz=0.333
place RT_Floor aqueduct at 42 1.5 y=0 sx=0.993 sz=0.333
