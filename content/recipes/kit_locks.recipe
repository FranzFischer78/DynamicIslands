# Kit check (not content): lock gates, levers, a crank wheel, pumps and doors for The Drowned Gate
new
gen Seed=1 Radius=70 Height=4 Shape=4 Roughness=0.1 ObjectDensity=0 Trees=0 Bushes=0 Rocks=0 BeachThings=0 Harvest=0
gen Hostiles=0 Friendly=0 SeaLife=0 Water=0 SeaRocks=0 SeaFinds=0 Sunken=0
