prop fog atmo.light=#8a929a
prop fog atmo.lightAmount=0.3
prop fog atmo.particles=mist
prop fog zone.radius=45
prop rain sound.event=event:/amb/rain_ocean
prop rain sound.volume=0.5
prop rain zone.radius=40

quest title=The Dark Light
quest intro=A lighthouse on a rock in the fog, dark for three nights. Two keepers kept it. Start at the landing.
step reach|landing|1|Climb the landing stair onto the keepers' rock
step read|Head Keeper Shale's diary|1|Read the head keeper's diary in the cottage
step read|Keeper Lusk's diary|1|Read the assistant keeper's diary in the oil store under the lighthouse
step kill|Screecher|2|Climb to the dark lamp gallery and drive the screechers off it
step kill|Angler fish|1|Go down into the flooded cistern and face what lives in it
step open|Lamp room locker|1|Bring up the oil, light the lamp, sound the foghorn - and open the lamp room's locker
step blueprint|Blueprint_HeadLight|1|Take the headlamp plans from the lamp room locker
quest done=The light turns and the horn sounds over the fog. Whatever the two keepers saw in each other, the ships see the light again.
quest reward=Plank*6;Rope*3;Cooked_Herring*3

# Buried treasure (reach audit 10-24: a late island of its story line needs one): the metal detector finds it, the shovel digs it
call treasure x=0 z=0 r=25 n=1 seed=8848
prop treasure8848 treasure.loot=TitaniumOre*2

save Keeper's Light
