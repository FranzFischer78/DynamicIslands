# Sargasso Town - a new island of the library, four times the size (x4)
# A floating town of wrecks in the calm lagoon of a sunken volcano (Shape 1, Style 4): a ring of black rock round a
# shallow lagoon, a channel cut through the rim on the south for the way in, and in the lagoon's middle the town on its
# weed islets - plank streets on posts from the quay to the council house, the captains' ships and houses round it, a
# scrap barge, a schooner at the north pier, a capsized hull off the west side; the crater spring at the north rim's foot
# and a lookout tower on the east rim's foot. The Council of Captains is away for the season; each captain left a favour
# for their vote: fetch, fight, dive, fix, find. Win all five votes and the town chest is yours. Quest "Five Votes" (15
# steps, five favours of five kinds).
#
# Built by the recipe player (CIRecipe sargasso_town) through the editor's own operations. Points: the lagoon's floor
# -3.3 m, the channel x 5 from z -40 to the sea; the weed islets at 0.3 m - the council's at 0 0 (r 7), Mbeki's at -16 2,
# Rourke's at 16 2, Ilka's at 16 -16; the streets' decks at 1 m: the quay x -1.5..1.5, z -26..-3.5, the north street
# x 0..1.5, z 7..22 (Fen's pier), the west street x -12..-6 (z 1.25..2.75), the east street x 6..12, the south-east street
# x 1.5..12 (z -15.5..-14); the council house x -2.25..2.25, z -2.25..2.25 (door south); Rourke's galley x 14..18.5,
# z -0.25..4.25 (door west); the capsized hull at -26 -12 over a hole 8 m deep; the spring's pad at 0 46 (2.4 m); the
# lookout's pad at 51 -4 (4.6 m), its deck 12.1 m, its ladder at 51.75 -5.7.
include lib_huts
include lib_sea
new
# (nature: volcanic - scrub and a few hardy trees on the rim, black sand; the lagoon weedy)
gen Trees=0.2 Bushes=0.3 Rocks=0.5 Harvest=0.25 BeachThings=0.3
gen Seed=9213 Radius=90 Height=18 Roughness=0.5 Peaks=2 Shape=1 Style=4 BeachWidth=0.3 Cliffs=0.5 PeakShape=0.45
gen Water=0.7 SeaRocks=0.3 SeaFinds=0.3 Sunken=0.5 Hostiles=0 Friendly=0 SeaLife=0
generate

# ===== The ground: the channel through the rim, the weed islets, the hole under the capsized hull, the spring's and the
# lookout's pads ===========================================================================================================
brush flatten from 5 -40 to 5 -100 r=5 s=20 frames=120 h=-3.5
brush flatten at 0 0 r=7 s=20 frames=60 h=0.3
brush flatten at -16 2 r=4.5 s=20 frames=60 h=0.3
brush flatten at 16 2 r=4.5 s=20 frames=60 h=0.3
brush flatten at 16 -16 r=4 s=20 frames=60 h=0.3
brush grass at 0 0 r=7 s=20 frames=30
brush grass at -16 2 r=4.5 s=20 frames=30
brush grass at 16 2 r=4.5 s=20 frames=30
brush grass at 16 -16 r=4 s=20 frames=30
brush flatten at -26 -12 r=8 s=20 frames=80 h=-8
brush flatten at 0 46 r=3.5 s=20 frames=60 h=2.4
brush flatten at 51 -4 r=4.6 s=20 frames=80 h=4.6
clear from 5 -40 to 5 -100 r=6
clear at 0 0 r=8
clear at -16 2 r=5
clear at 16 2 r=5
clear at 16 -16 r=5
clear at -26 -12 r=9
clear at 0 46 r=4
clear at 51 -4 r=4

