# ===== Chapter 3 - the hatch under its slab on the wooded rise in the middle ==========================================
# (as Shelter Atoll: Selene's rooms in a pit, a slab of the tower's floor over them at ground level, a concrete collar
# round the ladder's shaft and the hatch's lid lying open beside it. Down the ladder: the terminal room, the bunk room
# west of it, the vault east of it behind its sliding leaves)
push at 0 0 h=3 yaw=0
place TP_Selene_Int_Tunnel_Ladder_Bot - at -3 9
call selene_cell -3 3 n=TP_Selene_Int_Room_Entrance w=TP_Selene_Int_Room_Entrance e=TP_Selene_Int_Room_Entrance
call selene_cell -9 3 e=TP_Selene_Int_Room_Entrance
call selene_cell 3 3 w=TP_Selene_Int_Room_Entrance
# (both leaves pivot on the doorway's middle: the left one reaches +z, the right one -z)
place TP_Selene_Int_DoorLargeL vaultdoorL at 3 0 sy=1.051
place TP_Selene_Int_DoorLargeR vaultdoorR at 3 0 sy=1.051
macro slab x1 x2 z1 z2
place RT_Floor - at $x2 $z2 y=6 sx={($x2-$x1)/6.04} sz={($z2-$z1)/9}
end
call slab -14 -6.9 4.5 14
call slab -14 -6.9 -8 4.5
call slab -6.9 -1.3 4.5 14
call slab -6.9 -1.3 -8 4.5
call slab 1.3 6.9 4.5 14
call slab 1.3 6.9 -8 4.5
call slab 6.9 14 4.5 14
call slab 6.9 14 -8 4.5
call slab -1.3 1.3 7.2 14
call slab -1.3 1.3 -8 4.6
place VP_ConcretePipe02 collar at 0 5.9 y=6.25 rot=90,0,0 scale=1.5 sz=0.1
place TangaroaHatchRoom_Hatch - at 2.6 6.4 y=6 yaw=80
# (the terminal room: the terminal on its desk, the clock on the wall, the rations' shelves, the manual; the lamps and
# the computers' hum)
# (Selene's walls are planes 0.2 m inside their cell's edges)
place "Table Office" - at 0.6 -2.75 y=1 drop yaw=0
place Balboa_DecorationPrefabBase_CRTScreen - at 0.9 -2.35 y=2 drop yaw=0
place Balboa_DecorationPrefabBase_ComputerChassis - at -0.1 -2.4 y=2 drop yaw=0
place Tangaroa_OfficeKit_Keyboard terminal at 0.9 -2.1 y=2 drop yaw=0
place Note_Book manual at 1.4 -2.15 y=2 drop yaw=20
place "VG_DecorationPrefabBase_Clock Variant" - at 0.6 -2.79 y=2.6 yaw=0
place Shelf_Empty_02 rations at -2.1 -2.75 y=0 yaw=0
place Stairwell_CeilingLamp - at 0 0 y=4.6
place Stairwell_CeilingLamp - at -6 0 y=4.6
place Stairwell_CeilingLamp - at 6 0 y=4.6
place Zone_Sound hatchhum at 0 0 y=2
place Zone_Trigger hatchzone at 0 6.3 y=1.5
# (the bunk room)
place "VG_DecorationPrefabBase_BunkBed Variant" - at -7.7 -2.0 y=0 yaw=90
place "VG_DecorationPrefabBase_BunkBed Variant" - at -7.7 0.8 y=0 yaw=90
# (the vault: the Initiative's strongbox, the emergency release lever)
place Loot_ChestLarge vault at 8.2 0 y=0 yaw=270
place UT_JumpPuzzle_LiftMechanism_Lever releaselever at 8.4 2.2 y=2.13 yaw=270
place Zone_Trigger vaultroom at 6 0 y=1.5
pop

