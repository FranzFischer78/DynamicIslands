# The Island of Stations - a themed island, five times the size (x5). Inspiration: the mystery-island TV series of a
# plane crash and research stations (a crashed plane, the survivors' camp, the stations of a vanished research
# initiative, a caged bear that got out, the other islanders' village, a hatch with a terminal and a countdown) - the
# mood only; no names, numbers or phrases from the series.
# A big, low, misty forest marsh full of pools (Shape 5, Style 3): the plane came down at the marsh's edge behind the
# south beach (-22 -60), the survivors' camp on the beach (12 -80); the stations of the Halden Initiative: Gull (comms)
# on a rise by the east shore (75 9), Kelp (the marine lab) sunk 10 m down in the bay south-east of it (100 -15.5),
# Pike (zoology) in the marsh south of the middle (36 -40), Moth (the residents' village) round a green in the west
# (-58 9), Lantern (the observatory) on the north hill (-8 60); the hatch under a concrete slab on the wooded rise at the
# marsh's heart (0 3). The plane is Raft's light plane, scaled up and nose-down in the reeds.
# Quest "The Sequence" (22 steps, 3 chapters): the crash - camp, journal, the passenger's trunk (4), the stations and
# their five cards - Pike's sign and its bear, a village fridge, the boars under the north hill (13), the hatch and the
# vault (5, timed).
include lib_rt
include lib_selene
include lib_relay
include lib_sea
include lib_features
new
gen Trees=0.3 Bushes=0.38 Rocks=0.42 Harvest=0.1 BeachThings=0.18
gen Seed=9023 Radius=100 Height=14 Roughness=0.4 Peaks=1 Shape=5 Style=3 BeachWidth=0.5 Cliffs=0.1 PeakShape=0.35
gen Water=0.5 SeaRocks=0.5 SeaFinds=0.3 Sunken=0.4 Hostiles=0 Friendly=0 SeaLife=0
generate

# ===== The land: the north hill, the hatch's clearing, the bay, the pads, the marsh's pools ===========================
# (the north hill for the observatory: raised in steps from the marsh, its top levelled at 14 m)
brush flatten at -8 60 r=30 s=20 frames=60 h=6
brush flatten at -8 60 r=26 s=20 frames=60 h=7.5
brush flatten at -8 60 r=22 s=20 frames=60 h=9
brush flatten at -8 60 r=18 s=20 frames=60 h=10.5
brush flatten at -8 60 r=14 s=20 frames=60 h=12
brush flatten at -8 60 r=11 s=20 frames=60 h=13
brush flatten at -8 60 r=8.5 s=20 frames=60 h=14
brush smooth at -8 60 r=30 s=10 frames=15
# (the top levelled again for the observatory and its doorstep: a gentle lip all round)
brush flatten at -8 60 r=7.5 s=20 frames=40 h=14
# (a ramp up to its door from the south)
brush flatten at -9.5 52 r=2.5 s=20 frames=30 h=12.9
brush flatten at -9.5 53.5 r=2.5 s=20 frames=30 h=13.45
brush flatten at -9.5 55 r=2.5 s=20 frames=30 h=13.95
# (the hatch's clearing on the wooded rise in the middle, 9 m up; the pit for its rooms, their floor 6 m under it)
brush flatten at 0 3 r=20 s=20 frames=60 h=9
macro pitrow z
for px -9 9 3
brush flatten at $px $z r=4 s=20 frames=30 h=2.9
next
end
call pitrow -3
call pitrow 0
call pitrow 3
call pitrow 6
call pitrow 9
# (the bay south-east of Station Gull: sloping down to a floor 10 m deep, open to the sea in the east)
brush flatten at 100 -15.5 r=22 s=20 frames=60 h=-5
brush flatten at 100 -15.5 r=14 s=20 frames=60 h=-10.2
brush flatten from 100 -15.5 to 135 -15.5 r=10 s=20 frames=60 h=-10.2
brush smooth at 100 -15.5 r=24 s=10 frames=20
brush flatten at 100 -15.5 r=13 s=20 frames=40 h=-10.2
# (the pads: Gull's rise, Pike's yard, the village green, the camp on the beach)
brush flatten at 74 8 r=13 s=20 frames=60 h=5
brush smooth at 74 8 r=19 s=10 frames=15
brush flatten at 75 8.7 r=9.5 s=20 frames=40 h=5
brush flatten at 36 -38 r=15 s=20 frames=60 h=3.4
