# Hollow Mountain - a new island of the library, seven times the size (x7)
# One great snowy mountain hollowed out long ago by the Delvers: a gate in the valley at its south foot, halls on three
# levels joined by lifts (the entry hall behind the gate, the mid hall in the east face with a balcony over the sea, the
# high hall near the summit), and a sunken lake hall in its west foot with a throne hall on an islet in the lake. The
# Delvers left in one night, sealing their gate with three keystones; their last king, Orm, stayed on his throne with his
# guardian - a bear of stone - beside him.
# Quest "The Delvers' Hoard" (22 steps in 4 chapters): the gate (the rune, the bears, three keystones from the ice ledge,
# the frozen falls and the herder, the sockets in order), the lifts (the crank, the granary's rats and its cog, the
# decree), the lake (the long lift down, a dive past two air bells to the drowned treasury, the islet), the throne hall
# (the guardian, Orm's words, the crown laid down, the hoard).
#
# Built by the recipe player (CIRecipe hollow_mountain) through the editor's own operations.
include lib_rt
include lib_selene
include lib_huts
include lib_sea
new
# (nature: snowy, Like Raft's Temperance - pines on the foothills, drifts and bare rock above)
gen Trees=0.08 Bushes=0.15 Rocks=0.25 Harvest=0.05 BeachThings=0.3
gen Seed=9221 Radius=119 Height=72 Roughness=0.45 Peaks=1 Shape=0 Style=1 BeachWidth=0.35 Cliffs=0.5 PeakShape=0.7 Valleys=0.25
gen Water=0.5 SeaRocks=0.3 SeaFinds=0.3 Sunken=0.4 Hostiles=0 Friendly=0 SeaLife=0
generate

# ===== THE LAND ===========================================================================================================
# The mountain (the map, seed 9221): its summit 70 m at -15 5, the high ground spreading west to the west coast (10-25 m),
# a low plain on the east (0.5-3 m) to the beach, a valley opening south at -40 -90. The gate in the valley's head (its
# forecourt at 4 m, -40 -85), the entry hall in a notch behind it (-46..-34 x -75..-63, 4 m); the mid hall in the east face
# (8..14 x -13.5..13.5, 25 m) with its balcony east; the high hall near the summit (-21..-9 x -12..-6, 50 m); the lake hall
# in the west foot under a roof of slabs (x -104..-56, z -13..13, the roof 14 m): its shore ledge east at -62 0, the sunken
# gate at -75 0 (10 m down), the islet with the throne hall at -92 0. The landing on the east beach at 112 35.

# --- Terrain: the forecourt and the entry hall's notch; the mid hall's shelf in the east face; the high hall's notch; the
# lake hall's sinkhole (4 m deep, 10 m in its east part), its shore ledge and the islet; the keystone shrines' pads; the
# herder's yard -------------------------------------------------------------------------------------------------------------
brush flatten from -40 -92 to -40 -80 r=9 s=20 frames=300 h=4
brush flatten from -40 -74 to -40 -62 r=9 s=20 frames=400 h=4
brush flatten from 10 -12 to 10 12 r=8 s=20 frames=400 h=25
brush flatten from 15 -4 to 15 4 r=4 s=20 frames=300 h=25
brush flatten from -19 -9 to -11 -9 r=6 s=20 frames=400 h=50
brush flatten from -92 0 to -72 0 r=11 s=20 frames=400 h=-4
brush flatten from -80 0 to -70 0 r=7 s=20 frames=400 h=-10
brush flatten at -62 0 r=4 s=20 frames=300 h=0.8
brush flatten at -92 0 r=5 s=20 frames=300 h=1
brush flatten at -100 50 r=6.5 s=20 frames=300 h=20
brush flatten at -100 39 r=3 s=20 frames=300 h=12
brush flatten at 62 27 r=6 s=20 frames=200 h=2
clear from -40 -92 to -40 -62 r=14
clear from 10 -12 to 10 12 r=12
clear at -10 25 r=12
clear from -19 -9 to -11 -9 r=16
clear at -38 5 r=9
clear at -13 8.5 r=5
clear from -104 0 to -58 0 r=14
clear at -100 50 r=5
clear at 62 27 r=7

