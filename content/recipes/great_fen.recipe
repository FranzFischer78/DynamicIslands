# The Great Fen - a new island of the library, twenty times the size (x20)
# A vast forested wetland - reed beds, willows, channels and pools - with seven stilt villages round its rim and in the
# middle, on an island in the great mere, the lost town of Sevenbridge, cut off since its seven drawbridges were raised in
# the fever year. Each bridge's windlass belongs to one village, and each village wants something done first.
# Quest "The Seven Bridges" (35 steps in 9 chapters): the warden's hut at the landing; then one chapter per village -
# Reedcut's geese, Eelmarsh's sunk bridge pin, Mothwick's wisp called with three horns, Turfholm's bog boars, Heronsby's
# fen-mint from the hermit's isle, Willowbend's timed lock, Stillwater's Bog Beast; and Sevenbridge itself - the charter,
# the hall's rats, the town bell for seven bridges, the hoard.
#
# Built by the recipe player (CIRecipe great_fen) through the editor's own operations.
include lib_huts
include lib_relay
include lib_rt
include lib_sea
new
# (nature: forest, Like Raft's Balboa - birch, pine and bushes on the firm ground; the meres open water)
gen Trees=0.21 Bushes=0.38 Rocks=0.42 Harvest=0.1 BeachThings=0.3
gen Seed=9228 Radius=200 Height=6 Roughness=0.35 Peaks=1 Shape=5 Style=3 BeachWidth=0.5 Cliffs=0 PeakShape=0.2 Lakes=0.6
gen Water=0.6 SeaRocks=0.2 SeaFinds=0.3 Sunken=0.4 Hostiles=0 Friendly=0 SeaLife=0
generate

# ===== THE LAND ===========================================================================================================
# The fen (the map, seed 9228): low marsh everywhere (0.5-6 m), pools of the generator's own. The great mere dug round
# its middle (-10 -10): water from 28 to 64 m out, 4 m deep; Sevenbridge's island inside it (r 26, 1.5 m). The seven
# villages ~105-130 m out on the firm ground, each levelled at 1.5 m: Reedcut -10 95, Eelmarsh 64 64, Mothwick 75 -10, Turfholm 64 -84, Heronsby 35 -130, Willowbend -115 -10, Stillwater -85 70.
# From each village a sunken causeway (1 m) runs to the mere's shore, a boardwalk on posts across the water (deck 1 m),
# and the last 12 m to the town's shore is the drawbridge's gap. The landing on the south coast at 40 -190.

# --- Terrain: the mere (two rings of strokes), the town's island levelled at 1.5 m; the villages' ground; the causeways'
# beds to the mere's shore; Eelmarsh's deep pool, Mothwick's pond and islet, Turfholm's bog, the hermit's isle and the
# mill isle in their rings of water; the landing --------------------------------------------------------------------------
for a 0 345 15
brush flatten at {-10+40*cos($a)} {-10+40*sin($a)} r=10 s=20 frames=300 h=-4
brush flatten at {-10+54*cos($a)} {-10+54*sin($a)} r=10 s=20 frames=300 h=-4
brush flatten at {-10+33*cos($a)} {-10+33*sin($a)} r=6 s=20 frames=300 h=-4
next
brush flatten at -10 -10 r=29 s=20 frames=600 h=1.5
brush smooth at -10 -10 r=36 s=10 frames=8
brush flatten at -10 -10 r=25 s=20 frames=300 h=1.5
brush flatten at -10 95 r=16 s=20 frames=300 h=1.5
brush flatten from -10 95 to -10 56 r=3 s=20 frames=200 h=1
brush flatten at 64 64 r=16 s=20 frames=300 h=1.5
brush flatten from 64 64 to 36.67 36.67 r=3 s=20 frames=200 h=1
brush flatten at 75 -10 r=16 s=20 frames=300 h=1.5
brush flatten from 75 -10 to 56 -10 r=3 s=20 frames=200 h=1
brush flatten at 64 -84 r=16 s=20 frames=300 h=1.5
brush flatten from 64 -84 to 36.67 -56.67 r=3 s=20 frames=200 h=1
brush flatten at 35 -130 r=18 s=20 frames=300 h=1.5
brush flatten from 35 -130 to 13.17 -71.8 r=3 s=20 frames=200 h=1
brush flatten at -115 -10 r=16 s=20 frames=300 h=1.5
brush flatten from -115 -10 to -76 -10 r=3 s=20 frames=200 h=1
brush flatten at -85 70 r=16 s=20 frames=300 h=1.5
brush flatten from -85 70 to -55.14 38.15 r=3 s=20 frames=200 h=1
brush flatten from -57.88 41.07 to -66.08 49.82 r=6 s=20 frames=200 h=1
brush flatten at 72 72 r=5.5 s=20 frames=300 h=-7
for a 0 315 45
brush flatten at {75+6.5*cos($a)} {6+6.5*sin($a)} r=3.5 s=20 frames=300 h=-1.5
next
brush flatten at 75 6 r=2.5 s=20 frames=200 h=0.8
brush flatten at 84 -94 r=6 s=20 frames=200 h=0.3
for a 0 315 45
brush flatten at {-75+11*cos($a)} {-125+11*sin($a)} r=5 s=20 frames=300 h=-2
next
brush flatten at -75 -125 r=6 s=20 frames=200 h=1
for a 0 330 30
brush flatten at {-132+13*cos($a)} {-28+13*sin($a)} r=5 s=20 frames=300 h=-2
next
brush flatten at -132 -28 r=7 s=20 frames=200 h=1.5
brush flatten at 40 -186 r=7 s=20 frames=200 h=1
clear at -10 -10 r=66
clear at -10 95 r=17
clear at 64 64 r=17
clear at 75 -10 r=17
clear at 64 -84 r=17
