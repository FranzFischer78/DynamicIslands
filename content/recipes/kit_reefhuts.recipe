# Kit check (not content): Raft's reef huts - stilt huts of lib_huts on land and over shallow water, a boardwalk, a hall of
# wooden walls under the recipe's roof command
include lib_huts
new
gen Seed=1 Radius=40 Height=4 Shape=4 Roughness=0.1 ObjectDensity=0 Trees=0 Bushes=0 Rocks=0 BeachThings=0 Harvest=0
gen Hostiles=0 Friendly=0 SeaLife=0 Water=0 SeaRocks=0 SeaFinds=0 Sunken=0
generate
brush flatten at 0 0 r=35 s=20 frames=60
push at -6 -8
call stilt_hut
pop
push at 4 -8
call stilt_hut y=1.6 w3=none w4=ReefHuts_PlasticWall4 ladder=none
pop
push at -8 2
call boardwalk n=6 wide=2 rn=none
pop
# a hall of Raft's wooden walls with a roof command roof
push at 4 2
for wx 0.75 5.25 1.5
place Block_Wall_Wood - at $wx 0 y=0.2
place Block_Wall_Wood - at $wx 4.5 y=0.2
next
for wz 0.75 3.75 1.5
place Block_Wall_Wood - at 0 $wz y=0.2 yaw=90
place Block_Wall_Wood - at 6 $wz y=0.2 yaw=90
next
place Block_Pillar_Wood - at 0 0 y=0.2
place Block_Pillar_Wood - at 6 0 y=0.2
place Block_Pillar_Wood - at 0 4.5 y=0.2
place Block_Pillar_Wood - at 6 4.5 y=0.2
roof 4 3 at 0 0 y=0.2 wood
pop
