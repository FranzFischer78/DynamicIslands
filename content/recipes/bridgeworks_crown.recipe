prop authsecret beh.hidden=1
prop fleetsecret obj.name=fleetsecret
prop fleetsecret beh.hidden=1
prop unionsecret obj.name=unionsecret
prop unionsecret beh.hidden=1
prop letters on.open=show|authsecret\nshow|fleetsecret\nshow|unionsecret\nmessage||Three letters, three seals - one for each faction. The rain has made the seals soft.
prop teomsg beh.hidden=1

prop shutters obj.name=shutters
prop shutters beh.use=Crank the storm shutters shut
prop shutters if.use=!signal|shutters
prop shutters on.use=signal||shutters\ngive||story:shutters*1\nsound||event:/raft/radar/lever\nmessage||The shutters rattle down over the landing's windows. The wind screams round them.
prop shutters else.use=message||The shutters are shut.

prop alarmbell obj.name=alarmbell
prop alarmbell beh.use=Ring the alarm bell
prop alarmbell if.use=!signal|storm
prop alarmbell on.use=signal||storm\ngive||story:alarm*1\nsound||event:/raft/radar/lever\nmessage||The bell clangs over the roofs. On every bridge, lanterns turn toward the council house.
prop alarmbell else.use=message||The bell is still ringing in your ears.

prop councilpad obj.name=councilpad
prop councilpad beh.use=Type the council door's code
prop councilpad lock.code=4719
prop councilpad on.use=sound||event:/exploring/obstacles/keypad/keypad_correct\nhide|councilgate\nsignal||councildoor\ngive||story:councilcode*1\nmessage||The keypad blinks green. The council house door swings open.
prop councilpad else.use=message||Four digits. Each faction's secret letter holds a piece of it.

prop wayauthority obj.name=wayauthority
prop wayauthority beh.use=Choose: the Authority keeps the water
prop wayauthority if.use=!signal|chosen
prop wayauthority on.use=signal||authority\nsignal||chosen\ngive||story:choice*1\nshow|verdictauthority\nshow|councilchest\nshow|teomsg\nmessage||You stand with the Authority. The Fleet's captains walk out into the rain.
prop wayauthority else.use=message||The council has its answer.
prop wayfleet obj.name=wayfleet
prop wayfleet beh.use=Choose: the Free Fleet takes the pumps
prop wayfleet if.use=!signal|chosen
prop wayfleet on.use=signal||fleet\nsignal||chosen\ngive||story:choice*1\nshow|verdictfleet\nshow|councilchest\nshow|teomsg\nmessage||You stand with the Fleet. The Authority's councillor takes off his chain.
prop wayfleet else.use=message||The council has its answer.
prop wayunion obj.name=wayunion
prop wayunion beh.use=Choose: the Union runs the water
prop wayunion if.use=!signal|chosen
prop wayunion on.use=signal||union\nsignal||chosen\ngive||story:choice*1\nshow|verdictunion\nshow|councilchest\nshow|teomsg\nmessage||You stand with the Union. The foreman nods once, and the cranes are theirs.
prop wayunion else.use=message||The council has its answer.
prop wayexpose obj.name=wayexpose
prop wayexpose beh.use=Choose: read the valve log aloud - expose them all
prop wayexpose if.use=!signal|chosen
prop wayexpose on.use=signal||expose\nsignal||chosen\ngive||story:choice*1\nshow|verdictexpose\nshow|councilchest\nshow|teomsg\nmessage||You read the valve log aloud. Nobody in the room can look at anyone else.
prop wayexpose else.use=message||The council has its answer.
prop wayfree obj.name=wayfree
prop wayfree beh.use=Choose: the water goes to the Rookery - and the Rookery goes free
prop wayfree if.use=!signal|chosen
prop wayfree on.use=signal||free\nsignal||chosen\ngive||story:choice*1\nshow|verdictfree\nshow|councilchest\nshow|teomsg\nmessage||You speak for the Rookery. Three factions, one stranger - and for once, the stranger wins.
prop wayfree else.use=message||The council has its answer.

prop verdictauthority beh.hidden=1
prop verdictfleet beh.hidden=1
prop verdictunion beh.hidden=1
prop verdictexpose beh.hidden=1
prop verdictfree beh.hidden=1
prop councilchest beh.hidden=1
