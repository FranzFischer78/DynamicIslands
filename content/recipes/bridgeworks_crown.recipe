prop authzone zone.message=The Authority's roof. Its spotlight sweeps the rain.
prop fleetzone zone.id=fleet_roof
prop fleetzone zone.radius=3
prop fleetzone zone.message=The Fleet's roof. The gull flag snaps at the mast.
prop unionzone zone.id=union_roof
prop unionzone zone.radius=3
prop unionzone zone.message=The Union's roof. Its crane creaks in the wind.
prop doorzone zone.id=council_door
prop doorzone zone.radius=2.5
prop doorzone zone.message=The council house door. A keypad, four digits.
prop councilzone zone.id=council
prop councilzone zone.radius=3
prop councilzone zone.message=The council house. Five levers on the walls. Everyone is waiting for you.
prop pilestair zone.id=pile_stair
prop pilestair zone.radius=3
prop pilestair zone.message=The pile stair, going down into black water.
prop pilehead zone.id=pile_head
