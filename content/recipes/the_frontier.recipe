place "VG_DecorationPrefabBase_BigOfficeDesk Variant" archivepress at 2.9 2.25 y=0.1 sit yaw=90
place "VG_DecorationPrefabBase_Bookshelf Filled 1 Variant" - at 1.1 3.6 y=0.1 sit yaw=180
place "VG_DecorationPrefabBase_Bookshelf Filled 2 Variant" - at 2.6 3.6 y=0.1 sit yaw=180
place "VG_DecorationPrefabBase_Bookshelf Filled 3 Variant" - at 2.6 0.3 y=0.1 sit
place Placeable_Lantern_Metal - at 3.4 1.6 y=1 drop
place Zone_Trigger archive at 2.25 2.25 y=1.2
pop

# --- The signal horn's tower by the hall: two decks of Raft's floors on its pillars, ladders, rope rails and a wooden
# roof on its posts; the horn on the top deck (its reed gone to the forge) ---------------------------------------------------
push at 40 16 h=34.7
call floors w=2 d=2
for lv 0 2 1
place Block_Pillar_Wood - at 0 0 y={0.1+$lv*2.42}
place Block_Pillar_Wood - at 3 0 y={0.1+$lv*2.42}
place Block_Pillar_Wood - at 0 3 y={0.1+$lv*2.42}
place Block_Pillar_Wood - at 3 3 y={0.1+$lv*2.42}
next
place Block_Floor_Wood - at 2.25 0.75 y=2.52
place Block_Floor_Wood - at 0.75 2.25 y=2.52
place Block_Floor_Wood - at 2.25 2.25 y=2.52
place Block_Floor_Wood - at 0.75 0.75 y=4.94
place Block_Floor_Wood - at 2.25 0.75 y=4.94
place Block_Floor_Wood - at 0.75 2.25 y=4.94
place Block_Ladder - at 0.75 1.38 y=0.1
place Block_Ladder - at 2.25 1.62 y=2.52 yaw=180
place Block_Wall_Fence_Rope - at 0.75 0 y=4.94
place Block_Wall_Fence_Rope - at 2.25 0 y=4.94
place Block_Wall_Fence_Rope - at 0.75 3 y=4.94
place Block_Wall_Fence_Rope - at 2.25 3 y=4.94
place Block_Wall_Fence_Rope - at 0 0.75 y=4.94 yaw=90
place Block_Wall_Fence_Rope - at 0 2.25 y=4.94 yaw=90
place Block_Wall_Fence_Rope - at 3 0.75 y=4.94 yaw=90
place Block_Wall_Fence_Rope - at 3 2.25 y=4.94 yaw=90
roof 2 2 at 0 0 y=4.94 wood
place Placeable_HonkHorn_3 horn at 0.8 0.8 y=4.94 sit yaw=225
place Zone_Trigger horntop at 1.5 1.5 y=6
pop

# --- The Corps' hall on the east rim: Raft's wooden walls two high, windows above, a wide doorway to the town closed by
# two sliding doors (they slide aside when the three seals are set), a back door to the lift; a wooden hip roof on the
# walls and its corner pillars; the long table, the commander's last order, the Corps' flags ----------------------------------
push at 50 4 h=34.7
call floors w=6 d=4
for wx 0.75 8.25 1.5
place Block_Wall_Wood - at $wx 0 y=0.1
place Block_Wall_Window_Wood - at $wx 0 y=2.52
place Block_Wall_Wood - at $wx 6 y=0.1
place Block_Wall_Window_Wood - at $wx 6 y=2.52
next
place Block_Wall_Wood - at 0 0.75 y=0.1 yaw=90
place Block_Wall_Wood - at 0 5.25 y=0.1 yaw=90
place Block_Wall_Window_Wood - at 0 0.75 y=2.52 yaw=90
place Block_Wall_Wood - at 0 2.25 y=2.52 yaw=90
place Block_Wall_Wood - at 0 3.75 y=2.52 yaw=90
place Block_Wall_Window_Wood - at 0 5.25 y=2.52 yaw=90
place Block_Wall_Wood - at 9 0.75 y=0.1 yaw=90
place Block_Wall_Wood - at 9 2.25 y=0.1 yaw=90
place Block_Wall_Wood - at 9 5.25 y=0.1 yaw=90
for wz 0.75 5.25 1.5
place Block_Wall_Wood - at 9 $wz y=2.52 yaw=90
next
call corners w=6 d=4
call corners w=6 d=4 y=2.52
roof 6 4 at 0 0 y=2.52 wood
place Block_Wall_Wood halldoora at -0.12 2.25 y=0.1 yaw=90
place Block_Wall_Wood halldoorb at -0.12 3.75 y=0.1 yaw=90
place "VG_DecorationPrefabBase_DinnerTable Variant" - at 4.5 3 y=0.1 sit yaw=90
place Note_Paper commandersorder at 4.5 3 y=0.9 drop yaw=10
place Placeable_Flag_01 - at 8.3 0.7 y=0.1
place Placeable_Flag_01 - at 8.3 5.3 y=0.1
place Placeable_Lantern_Basic - at 0.7 0.7 y=0.1 sit
place Placeable_Lantern_Basic - at 0.7 5.3 y=0.1 sit
place Zone_Trigger hallinside at 4.5 3 y=1.4
place Pickup_Landmark_Plastic3_Land - at 2.5 1.5 y=0.4 drop yaw=226
pop
place Note_Sign hallplaque at 49.2 9.4 h=34.7 yaw=270
place Zone_Trigger hall at 46 7 h=36

# --- The Corps' lift: its platform behind the hall on the rim, the control box; the shaft down the cliff's notch to the
# shelf by the cove, its control box at the foot -------------------------------------------------------------------------------
push at 59 6.25 h=34.7
call floors w=3 d=2
place Block_Wall_Fence_Rope - at 0.75 0 y=0.1
place Block_Wall_Fence_Rope - at 2.25 0 y=0.1
place Block_Wall_Fence_Rope - at 3.75 0 y=0.1
place Block_Wall_Fence_Rope - at 0.75 3 y=0.1
place Block_Wall_Fence_Rope - at 2.25 3 y=0.1
place Block_Wall_Fence_Rope - at 3.75 3 y=0.1
place EmergencyGenerator liftdown at 3.9 0.45 y=0.1 sit yaw=0
place Zone_Trigger lifttop at 1.6 1.5 y=0.2
pop
place VP_ElevatorShaft liftshaft at 63.6 11.1 h=2.5 ground sy=1.47
place EmergencyGenerator liftup at 71.6 9.8 h=2.5 sit yaw=270
place Zone_Trigger liftbottom at 72 7.5 h=2.6

# --- The Corps' vault, sunk in the cove at the lift's foot: Raft's steel walls and roof, its door to the lift; the vault
# chest; the giant stingray in the cove --------------------------------------------------------------------------------------------
push at 82 4.5 h=-5.2
for fx 0.75 5.25 1.5
for fz 0.75 5.25 1.5
place Block_Floor_Tier3 - at $fx $fz y=0.1
place Block_Floor_Tier3 - at $fx $fz y=2.52
next
next
for wx 0.75 5.25 1.5
place Block_Wall_Tier3 - at $wx 0 y=0.1
place Block_Wall_Tier3 - at $wx 6 y=0.1
place Block_Wall_Tier3 - at 6 $wx y=0.1 yaw=90
next
place Block_Wall_Tier3 - at 0 0.75 y=0.1 yaw=90
place Block_Wall_Tier3 - at 0 5.25 y=0.1 yaw=90
place Block_Pillar_Tier3 - at 0 0 y=0.1
place Block_Pillar_Tier3 - at 6 0 y=0.1
place Block_Pillar_Tier3 - at 0 6 y=0.1
place Block_Pillar_Tier3 - at 6 6 y=0.1
place VG_Safe corpsvault at 5.2 3 y=0.1 sit yaw=270
place Zone_Trigger vault at 3 3 y=1.2
pop
place Creature_Stingray ray at 92 7.5 h=-4.6

# --- The lower terrace (12.5 m): crop beds east of the road's top and along the bank, melon rows west of it in front of
# the ramp, its cistern, a scarecrow, the tool crate; fences along its front (a gap where the road comes up) -----------------------------------------
for cx 18 32 2.8
place Placeable_Cropplot_Medium - at $cx 69 h=12.5 sit
place Placeable_Cropplot_Medium - at $cx 71.2 h=12.5 sit
next
for cx -30 -8 3
place Pickup_Landmark_WatermelonLandmark - at $cx 73 h=12.5 sit yaw={rnd(0,360)}
place Pickup_Landmark_PineappleLandmark - at {$cx+1.5} 75 h=12.5 sit yaw={rnd(0,360)}
next
for cx 6 12 3
place Placeable_Cropplot_Medium - at $cx 68.6 h=12.5 sit
next
place Placeable_WaterTank - at -33 73.6 h=12.5 sit yaw=90
place Placeable_Scarecrow - at 15.5 70.2 h=12.5 sit yaw=0
place Loot_Crate terrace1 at 35.5 68.8 h=12.5 sit yaw=80
place Reef_Wheelbarrow - at -4 73.5 h=12.5 sit yaw=-30
line Relay_Fence_wood from -34 76.4 to 34 76.4 step=1.825

# --- The middle terrace (23.6 m): crop beds and pineapple rows north of the path, a berry bush, the cistern the pipe from
# the reservoir fills, a scarecrow, the tool crate; fences along its front (a gap where the ramp from the lower terrace comes up) ------------------
for cx -24 -6 2.6
place Placeable_Cropplot_Medium - at $cx 58 h=23.6 sit
place Placeable_Cropplot_Medium - at $cx 60.2 h=23.6 sit
next
for cx 6 30 3
place Pickup_Landmark_PineappleLandmark - at $cx 57.5 h=23.6 sit yaw={rnd(0,360)}
place Pickup_Landmark_WatermelonLandmark - at {$cx+1.5} 60.3 h=23.6 sit yaw={rnd(0,360)}
next
place Pickup_Landmark_BerryBush - at -30 52 h=23.6 sit yaw=40
place Placeable_Scarecrow - at -2 59 h=23.6 sit yaw=0
place Loot_Crate terrace2 at -27.5 61.2 h=23.6 sit yaw=-10
line Relay_Fence_wood from -28 62.6 to 34 62.6 step=1.825

# --- Sound and the lights at the end: the forge's fire, the lower town's bustle, the upper town's wind in the grass; the
# hall's lamps, dark until the vault is opened -------------------------------------------------------------------------------
place Zone_Sound forgefire at 59.5 59.5 h=3.5
place Zone_Sound townsound at 14 88 h=4
place Zone_Sound uppersound at 10 26 h=36
place RT_Floodlight halllights at 49.6 5.1 h=37.2 yaw=270
place RT_Floodlight halllights at 49.6 8.9 h=37.2 yaw=270

# --- Friendly animals (placed, not the generator's: its sea life has stingrays, and a stingray is the cove's boss): hens in
# the lower town and by the grower's house, goats grazing west of the upper town, turtles in the harbour basin, dolphins
# off the north shore ------------------------------------------------------------------------------------------------------
place Creature_Chicken townhens at 18 85 h=2.5
place Creature_Chicken growerhens at -32 31 h=34.7
place Creature_Goat pasture at -52 6 h=34.7
place Creature_Turtle turtles at -9 116 h=-1.6
place Creature_Dolphin dolphins at 24 156 h=-3

# --- Settings, story items, notes, behaviours, quest (Almost Home: 32 steps in six chapters - the finale) -------------------
# --- Raft's finds in the shallows round the island (lib_sea) ----------------------------------------
call shallows r=130 deep=5 n=3

info title=The Frontier
info author=Custom Islands
info description=The last high ground beyond the storm belt: the Frontier Corps' town on a great mesa - a harbour and a lower town on the shelf, farm terraces climbing the north face, the upper town with its reservoir, builders' tower and archive, and the Corps' hall on the east rim with its lift down to a flooded vault. Six chapters, thirty-two steps: the end of Raft 2: The Drowned Frontier.
island on.arrive=message||High ground at last: a harbour, a town under a great mesa, farm terraces climbing its face, a hall on the rim. "If you can hear this, you are almost home."

story wardenkey|Smiths' key|quest:Caravan_KeyMayor|The key to the forge's chest, from the netmaker's sunken net store.
story hornreed|Horn reed|quest:Vasagatan_MechanicalPart|The signal horn's brass reed, from the forge's chest.
story valvewheel|Valve wheel|quest:Tangaroa_GeneratorPart|One of the reservoir sluice box's three valve wheels.
story waterpass|Water pass|quest:Tangaroa_KeyCard|The farm store's pass, from the sluice box.
story sealtool|Seal press|quest:Balboa_BrunosTool_Hammer|The archive's seal press, from the builders' tower.
story seal|Hall seal|quest:Tangaroa_Token|One of the three seals the Corps' hall opens to.

# chapter 1 - arrival
note welcomeboard Welcome board | FRONTIER CORPS - THE FRONTIER\n\nIf you are reading this, you crossed the storm belt and followed the stations. Welcome home.\n\nThe town is yours - but we left it locked against the storms: the forge's chest, the farms' water, the hall's three seals. The harbour office has the map. Everything you need is in the town; everything we hoped for is in the hall on the rim.
note harbouroffice Harbour office locker | The harbour office's locker: the town map - the harbour and the lower town, the farm terraces up the mesa's face, the reservoir on the rim, the upper town, the Corps' hall on the east rim - and a ration tin.
loot harbouroffice Plank*6;Rope*3;Nail*10;Cooked_Mackerel*2
prop harbouroffice loot.refill=0
# the harbour office radio (T-4c2): Raft's own check (no "power" signal on this island, so the battery charger part from
# the Drowned Gate's pump room, rule 9; kept) - it shows the Corps' last crate; nothing in the quest needs it
prop officeradio obj.name=officeradio
prop officeradio else.use=message||The harbour office's radio is dead - its battery charger has burnt out. A tag on the set: "Spare charger part ordered from the Drowned Gate's pump room."
prop officeradio on.use=message||The charger part clicks home and the set warms up. A recorded voice, on a loop: "Harbour office - the Corps' last crate is under the boards by the door. For whoever gets here."\nsignal||officeradio\nshow|officecache
prop officecache obj.name=officecache
prop officecache note.title=The Corps' last crate
prop officecache beh.hidden=1
loot officecache TitaniumIngot*3;MetalIngot*4;CopperIngot*4;Battery_Advanced*1;Cooked_Salmon*3
prop officecache loot.refill=0
# chapter 2 - the lower town
note smithnote Smith's note | THE SMITHS' QUARTER\nThe forge's chest has the signal horn's reed - the horn on its tower by the hall won't sound without it. The chest's key went to the netmaker on the quay: she keeps everything.\nThe dogs got into the yard after we left. Mind them.
note fishernote Netmaker's note | THE FISHERS' QUARTER\nThe smiths' key was in our net store at the quay's end - and the net store went into the harbour in the last blow. Dive off the quay's end: the crate is down there with the nets.
note netstore Net store crate | The sunken net store's crate: nets, floats - and the smiths' key on a ring.
loot netstore story:wardenkey*1;Rope*2
prop netstore loot.refill=0
note smokebox Smokehouse box | Smoked fish, wrapped in leaves - the fishers' last catch.
loot smokebox Cooked_Herring*2;Cooked_Salmon*1
prop smokebox loot.refill=0
note forgechest Forge chest | The forge's chest: the signal horn's brass reed, wrapped in an oiled rag.
loot forgechest story:hornreed*1;MetalIngot*3;Nail*10
prop forgechest loot.refill=0
prop forgechest if.open=quest|8\ntake|story:wardenkey|1
prop forgechest else.open=message||The forge chest is locked. The smith's note said its key went to the netmaker on the quay.
# chapter 3 - the farms' water
note reservoirnote Reservoir keeper's note | THE RESERVOIR\nThe sluice box has three valve wheels - we took them off so the storms couldn't open it and flood the terraces. One went into each terrace's tool crate: the lower, the middle, the upper by the rim. Put them back and the farms drink again - and the farm store's pass is in the box.
note terrace1 Lower terrace crate | A valve wheel, greased, in the lower terrace's tool crate.
loot terrace1 story:valvewheel*1;Seed_Watermelon*2
prop terrace1 loot.refill=0
note terrace2 Middle terrace crate | A valve wheel in the middle terrace's crate, under the pruning shears.
loot terrace2 story:valvewheel*1;Seed_Pineapple*2
prop terrace2 loot.refill=0
note terrace3 Upper terrace crate | A valve wheel in the upper terrace's crate, under a sack of seed.
loot terrace3 story:valvewheel*1;Seed_Strawberry*2
prop terrace3 loot.refill=0
note farmstore Farm store | The farm store: seeds for every crop the Corps grew here, tools - and the harvest's seal for the hall, kept with the last harvest.
loot farmstore story:seal*1;Seed_Watermelon*3;Seed_Pineapple*3;Seed_Strawberry*3;Placeable_Sprinkler*1
prop farmstore loot.refill=0
prop farmstore if.open=quest|14\ntake|story:waterpass|1
prop farmstore else.open=message||The farm store is locked. It opens to the water pass from the reservoir's sluice box.
# chapter 4 - the upper town
note growernote Grower's note | THE GROWERS' QUARTER\nThe goats broke the pen's gate in the storm. Bring two of them back - the net launcher is in the box by the gate - and the chest in my house is yours.
note growernet Net box | The box by the pen's gate: the grower's net launcher and its canisters.
loot growernet NetGun*1;NetCanister*4
prop growernet loot.refill=0
note growerchest Grower's chest | The grower's chest: food for the road, and a note - "Thank you. Plant something."
loot growerchest Watermelon*2;Pineapple*2;Strawberry*3;Seed_Mango*2
prop growerchest loot.refill=0
note buildernote Builder's note | THE BUILDERS' QUARTER\nThe archive's seal press is on our tower's top deck, in the crate under the roof - we were mending the archive's desk when the storm came. The ladders are sound. Mostly.
note toptower Builders' tower crate | The crate on the builders' tower's top deck: the archive's seal press - and a view over the whole Frontier.
loot toptower story:sealtool*1;Nail*8;Plank*6
prop toptower loot.refill=0
# chapter 5 - the hall
note hallplaque Hall door plaque | THE CORPS' HALL\nThree seals open these doors: the harvest's (kept in the farm store), the archive's (pressed at the archive's desk), the horn's (sound the signal horn on its tower).
note commandersorder Commander's last order | TO WHOEVER OPENS THESE DOORS\n\nWe are out on the fleet - every boat we have - searching the storm belt for the ones still adrift. We built the Frontier for them. For you.\n\nThe vault in the cove below has everything we saved from the drowned world: take the lift behind the hall. Something has moved into the cove - go armed.\n\nLight the hall's lamps when you leave, so we can find our way home.\n\n- Commander Ilse Varg, the Frontier Corps
# chapter 6 - the end
note corpsvault Corps' vault | The Corps' vault: what they saved from the drowned world - and a logbook of every raft that made it through the storm belt. The last line is blank, waiting for your name.
loot corpsvault TitaniumIngot*8;Battery_Advanced*4;MetalIngot*8;CopperIngot*6;Cooked_Salmon*4;Cooked_Mackerel*4
prop corpsvault loot.refill=0
prop corpsvault if.open=signal|hall
prop corpsvault else.open=message||The vault's wheel won't turn. It is locked from the hall above.
prop corpsvault on.open=message||Far out on the dark sea, one by one, lights turn towards the island: the hall's lamps are lit.\nshow|halllights\nsound||event:/music/music_final

prop archivepress obj.name=archivepress
prop archivepress beh.use=Press the archive's seal
prop archivepress if.use=quest|21\ntake|story:sealtool|1
prop archivepress on.use=message||The press comes down on hot wax: the archive's seal, stamped with the Corps' anchor.\ngive||story:seal*1\nsound||event:/crafting/hammer_impact
prop archivepress else.use=message||The archive desk's seal press is missing. The builder's note said it is on their tower.
prop horn obj.name=horn
prop horn beh.use=Fit the reed and sound the signal horn
prop horn if.use=take|story:hornreed|1
prop horn on.use=message||The horn's call rolls out over the town and the sea - long, long, short. In its bell, wedged where the reed was, a seal.\ngive||story:seal*1\nsound||event:/crafting/horns/viking\nsignal||horn
prop horn else.use=message||The signal horn has no reed. The smith's note said it is in the forge's chest.
prop sluice obj.name=sluice
prop sluice beh.use=Fit the three valve wheels and open the sluice
prop sluice if.use=quest|13\ntake|story:valvewheel|3
prop sluice on.use=message||Wheel by wheel the sluice opens - the pump hums, water thunders down the pipe to the terraces, and the box's lid springs open: the farm store's pass.\ngive||story:waterpass*1\nshow|wheels\nsound||event:/exploring/obstacles/waterpump\nsignal||water
prop sluice else.use=message||The sluice box is missing its three valve wheels. The reservoir keeper's note said where they are.
prop wheels obj.name=wheels
prop wheels beh.hidden=1
# (Selene's crank wheel as a ready piece is turned by players: these are the fitted valve wheels the sluice shows - the ready piece's settings taken off)
prop wheels beh.use=
prop wheels if.use=
prop wheels else.use=
prop wheels on.use=
prop halldoora obj.name=halldoor
prop halldoora beh.move=0,0,-1.5
prop halldoorb obj.name=halldoor
prop halldoorb beh.move=0,0,1.5
prop halldoora beh.use=Set the three seals in the hall's doors
prop halldoora beh.moveTime=2
prop halldoora beh.moveMode=switch
prop halldoora if.use=quest|26\ntake|story:seal|3
prop halldoora on.use=message||The three seals sink into the doors - harvest, archive, horn - and the Corps' hall slides open.\nopen|halldoor\nsound||event:/exploring/utopia/door_warehouse_open\nsignal||hall
prop halldoora else.use=message||The hall's doors have three seal sockets. The plaque beside them says which seals.
prop halldoorb beh.moveTime=2
prop halldoorb beh.moveMode=switch
prop liftdown obj.name=liftdown
prop liftdown beh.use=Ride the Corps' lift down to the cove
prop liftdown on.use=message||The cage rattles down the shaft - thirty metres of cliff - and stops at the cove.\nteleport|liftbottom\nsound||event:/exploring/elevator/elevator_changefloor
# (the emergency generator as a ready piece wants Raft's generator part before it runs: as the lift's controls it locked the Corps' lift for good. The ready piece's lock taken off)
prop liftdown if.use=
prop liftdown else.use=
prop liftup obj.name=liftup
prop liftup beh.use=Ride the Corps' lift up to the hall
prop liftup on.use=message||The cage climbs the shaft and stops behind the hall.\nteleport|lifttop\nsound||event:/exploring/elevator/elevator_changefloor
# (the emergency generator as a ready piece wants Raft's generator part before it runs: as the lift's controls it locked the Corps' lift for good. The ready piece's lock taken off)
prop liftup if.use=
prop liftup else.use=
prop lifttop obj.name=lifttop
prop liftbottom obj.name=liftbottom
prop halllights obj.name=halllights
prop halllights beh.hidden=1

