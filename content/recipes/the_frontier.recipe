clear from -46 30 to 62 30 r=13
clear from -46 12 to 62 12 r=9
clear from 66 7.5 to 112 7.5 r=9
# (the generator's boulders left on the mesa's cliffs and the terraces' faces, 4-33 m up: on faces this steep they looked
# as if they hung in the air in the pictures)
clear at 0 0 r=140 only=Rock|Boulder above=4 below=33

# --- The quay: three blocks wide from the shelf out over the basin (its deck 2.6 m), the netmaker's hut on its west side,
# the smokehouse on its east side (both on stilts in the basin, their open fronts onto the quay); the welcome board
# at its land end ----------------------------------------------------------------------------------------------------------
push at 2.25 94 h=-2.5 yaw=270
call boardwalk n=7 wide=3 y=5.1
pop
