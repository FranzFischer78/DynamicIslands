# The Frontier - an island of the library's plan Raft 2: The Drowned Frontier (station Ten of the Frontier Corps)
# The last high ground beyond the storm belt: the Frontier Corps' town on a 35 m mesa - the harbour and the lower town on
# the north shelf (2.5 m), the road up the north face through the farm terraces (12.5 m, 23.6 m), the upper town on the
# mesa: the reservoir, the growers' and builders' quarters, the archive, the signal horn's tower and the Corps' hall on
# the east rim, its lift down the cliff to the flooded vault in the east cove. Quest "Almost Home" (the finale).
#
# Built by the recipe player (CIRecipe the_frontier) through the editor's own operations.
include lib_sea
include lib_rt
include lib_huts
include lib_features
new
# (nature: forest: Like Raft's Balboa - Raft's islands as the generator's Like Raft has them, CIGenLikeRaft; thicker than
# that in the wild west and south of the mesa, where the town and the terraces were cleared out of it - CIIslandDensity)
gen Trees=0.28 Bushes=0.6 Rocks=0.5 Harvest=0.05 BeachThings=0.3
gen Seed=8110 Radius=110 Height=35 Roughness=0.35 Shape=4 Style=3 Cliffs=0.6
gen Water=0.5 SeaRocks=0.5 SeaFinds=0.5 Sunken=0.4 Hostiles=0 Friendly=0.2 SeaLife=0.3
generate

# --- Terrain: the harbour basin dredged in front of the lower town (2.5 m down, where the quay's posts stand); the farm
# terraces cut across the north face (the lower 12.5 m, the middle 23.6 m) and the road up them in three ramps (about
# 1:3, wide strokes every 1.5 m, then smoothed); the east cove dug to the cliff's foot for the vault, the cliff made
# sheer where the Corps' lift goes down it -------------------------------------------------------------------------------
brush flatten from -10 100 to -10 128 r=7 s=20 frames=150 h=-2.5
brush flatten from 0 100 to 0 128 r=7 s=20 frames=150 h=-2.5
brush flatten from 10 100 to 10 128 r=7 s=20 frames=150 h=-2.5
# (a hole off the quay's end, 6 m down, where the net store went in; the square's pad at the terraces' foot)
brush flatten at 7 137 r=5 s=20 frames=60 h=-6
brush flatten at 30 88 r=5 s=20 frames=50 h=2.45
brush flatten from -36 72 to 34 72 r=8 s=20 frames=160 h=12.5
brush flatten from -36 67 to 34 67 r=8 s=20 frames=160 h=12.5
brush flatten from -38 58 to 34 58 r=8 s=20 frames=160 h=23.6
brush flatten from -38 53 to 34 53 r=8 s=20 frames=160 h=23.6
# (the ramps, wide (the walker slid off ramps of narrow strokes): the first up from the east shelf onto the lower terrace's
# east end, the second along the lower terrace's back up to the middle terrace's west end, the third along the middle
# terrace's back up to the mesa - 30-36 m each; a level landing where each one meets the ground above it)
for i 0 24 1
brush flatten at {74-$i*1.5} 75 r=5 s=20 frames=20 h={2.5+$i*0.417}
next
for i 0 20 1
brush flatten at {-2-$i*1.5} 66.4 r=4.5 s=20 frames=20 h={12.5+$i*0.555}
next
for i 0 23 1
brush flatten at {2+$i*1.5} 51.4 r=4.5 s=20 frames=20 h={23.6+$i*0.483}
next
brush smooth from 74 75 to 38 75 r=3.5 s=10 frames=12
# (the first ramp's foot eased into the shelf and the beach east of it: its edge stood as a step)
brush smooth from 74 75 to 82 74 r=4.5 s=10 frames=20
brush smooth from -2 66.4 to -32 66.4 r=3.5 s=10 frames=12
brush smooth from 2 51.4 to 36 51.4 r=3.5 s=10 frames=12
brush flatten from 39 74 to 35 73 r=4 s=20 frames=60 h=12.5
brush flatten from -33 66 to -32 59 r=4 s=20 frames=60 h=23.6
brush flatten from 36 50.5 to 39 45 r=4 s=20 frames=80 h=34.7
# (pads on the mesa for the upper town: the fields, the reservoir, the farm store, the grower's house, the builders' tower,
# the archive, the horn tower, the hall and the lift's platform)
brush flatten from 8 37 to 28 37 r=5 s=20 frames=60 h=34.7
brush flatten from -19 38 to -5 38 r=5.5 s=20 frames=60 h=34.7
brush flatten at -3.75 23.25 r=4.5 s=20 frames=50 h=34.7
brush flatten at -37.75 29.25 r=4.5 s=20 frames=50 h=34.7
brush flatten at 17.5 17.5 r=4 s=20 frames=50 h=34.7
brush flatten at 32.25 16.25 r=4.5 s=20 frames=50 h=34.7
brush flatten at 41.5 17.5 r=4 s=20 frames=50 h=34.7
brush flatten from 51 7 to 61 7 r=6 s=20 frames=80 h=34.7
# (the lift's notch cut into the east cliff behind the hall, down to the shelf; the cove dug from the sea to it, 5 m deep)
brush flatten at 61.5 7.5 r=3 s=20 frames=60 h=34.7
brush flatten from 67 5.5 to 74 5.5 r=3.5 s=20 frames=200 h=2.5
brush flatten from 67 9.5 to 74 9.5 r=3.5 s=20 frames=200 h=2.5
brush flatten from 112 7.5 to 80 7.5 r=7 s=20 frames=100 h=-5
brush flatten from 83 5.5 to 90 5.5 r=6.5 s=20 frames=80 h=-5.2
brush flatten from 83 9.5 to 90 9.5 r=6.5 s=20 frames=80 h=-5.2
# (the cut and filled ground textured again by height and slope: the terraces' faces rock, their tops grass)
brush auto from -44 62 to 54 62 r=24 s=20 frames=60
brush auto from 60 7.5 to 90 7.5 r=12 s=20 frames=40
origin
clear from -40 70 to 52 70 r=11
clear from -40 54 to 40 54 r=11
clear from 76 75 to 36 75 r=6
# (the lower town's lane from the landing to the yards: a generator rock stood on it at x 61, 2026-10-12)
clear from 28 86 to 50 86 r=2.5
clear from 50 86 to 72 84 r=2.5
clear at 30 88 r=7
clear at -19 86 r=6
clear at 0 92 r=4
clear at 66 60 r=15
