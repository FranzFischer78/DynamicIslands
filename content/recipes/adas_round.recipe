# Ada's Round - an island of the library's plan The Last Post (the Coastal Post's route, the eighth stop)
# A green hill with the postmistress Ada Lind's homestead on its top: her stone house (Raft's Tier 3 blocks, a hipped
# roof), the attic store beside it padlocked (Vasagatan's padlock door), a walled kitchen garden with Raft's planters,
# the dovecote (Raft's storage pieces stacked, a nest on top) and the post bicycle shed; a path down to the jetty on the
# south shore. A Raft store behind the house.
# Quest "Ada's Round" (9 steps): the garden gate, Ada's diary, the dovecote's pigeons, the attic key, the attic (three
# blueprints), Ada's note to the next postman.
#
# Built by the recipe player (CIRecipe adas_round) through the editor's own operations.
include lib_sea
include lib_features
include lib_post
new
# (nature: a green grass hill, Like Raft's farm islands, plenty to harvest)
gen Trees=0.2 Bushes=0.35 Rocks=0.25 Harvest=0.3 BeachThings=0.12
gen Seed=4801 Radius=52 Height=12 Roughness=0.25 Peaks=1 Shape=0 Style=3 PeakShape=0.3 Cliffs=0.1 BeachWidth=0.4
gen Water=0.5 SeaRocks=0.3 SeaFinds=0.15 Sunken=0.2 Hostiles=0 Friendly=0 SeaLife=0.3
generate

# --- Terrain: the hilltop (9 m), the path down to the south shore in steps, the jetty's root (1.6 m) ------------------
brush flatten at 0 4 r=19 s=20 frames=220 h=9
brush flatten at 0 -19 r=4 s=20 frames=60 h=7.5
brush flatten at 0 -24 r=4 s=20 frames=60 h=6
brush flatten at 0 -29 r=4 s=20 frames=60 h=4.5
brush flatten at 0 -33 r=4 s=20 frames=60 h=3
brush flatten from 0 -37 to 0 -42 r=4 s=20 frames=60 h=1.6
brush smooth from 0 -14 to 0 -42 r=5 s=10 frames=40
origin
clear at 0 4 r=19
clear from 0 -14 to 0 -44 r=4

# --- The jetty ------------------------------------------------------------------------------------------------------------
call pier x=0 z1=-40 z2=-54 h=1.45
place Placeable_Lantern_Metal - at 1.2 -53 h=1.6 sit drop

# --- Ada's house: 4 x 3 cells, door to the garden; her diary on the table --------------------------------------------
push at -1 4 h=9
call posthall w=4 d=3 al=house
place "Table Office" - at 3 3 y=1.3 sit drop yaw=0
place Note_Paper diary at 3.4 3.3 y=2.2 sit drop yaw=-6
place "Chair Office" - at 3 2.1 y=1.3 sit drop yaw=0
place Placeable_Shelf_Small_Basic - at 0.9 2.5 y=1.3 sit drop yaw=90
place Placeable_Cupboard_Small - at 5.1 1 y=1.3 sit drop yaw=270
place Placeable_Clock_Basic - at 5.3 3.6 y=1.3 sit drop yaw=270
pop

# --- The attic store beside it: 3 x 3 cells, the padlock door in its doorway; the attic chest and Ada's note in it -----
push at 6.5 4 h=9
for fx 0.75 3.75 1.5
for fz 0.75 3.75 1.5
place Block_Floor_Tier3 - at $fx $fz y=0.05
next
next
for fx 0.75 3.75 1.5
place Block_Wall_Tier3 house at $fx 4.5 y=0.2
next
for fz 0.75 3.75 1.5
place Block_Wall_Tier3 house at 0 $fz y=0.2 yaw=90
place Block_Wall_Tier3 house at 4.5 $fz y=0.2 yaw=90
next
place Block_Wall_Tier3 house at 0.75 0 y=0.2
place Block_Wall_Tier3 house at 3.75 0 y=0.2
place Block_Pillar_Tier3 - at 0 0 y=0.2
place Block_Pillar_Tier3 - at 4.5 0 y=0.2
place Block_Pillar_Tier3 - at 0 4.5 y=0.2
place Block_Pillar_Tier3 - at 4.5 4.5 y=0.2
roof 3 3 at 0 0 y=0.2
place UT_Skyscraber01PadlockDoor atticdoor at 2.75 0 y=0.2 sit yaw=0
place Loot_Chest attic at 2.25 3.6 y=1.3 sit drop yaw=180
place Note_Paper adanote at 1 3.4 y=1.3 sit drop yaw=20
place "Box Big" - at 3.8 3.6 y=1.3 sit drop yaw=10
pop

# --- The walled kitchen garden: a fence round it, the gate to the south, planters in rows -----------------------------
macro fenceline x1=0 x2=0 z=0
for fx $x1 $x2 1.5
place Block_Wall_Fence_Tier3 gardenwall at $fx $z ground sit
next
end
macro fencerow z1=0 z2=0 x=0
for fz $z1 $z2 1.5
place Block_Wall_Fence_Tier3 gardenwall at $x $fz ground sit yaw=90
next
end
call fenceline x1=-12.5 x2=-9.5 z=-6
call fenceline x1=-6.5 x2=-3.5 z=-6
call fenceline x1=-12.5 x2=-3.5 z=3
call fencerow z1=-5.25 z2=2.25 x=-14
call fencerow z1=-5.25 z2=2.25 x=-2.75
place Block_Wall_Gate_Tier3 gardengate at -8 -6 ground sit
place Zone_Trigger gatezone at -8 -7.5 ground
place Placeable_Cropplot_Medium - at -11.5 -3 ground sit
place Placeable_Cropplot_Medium - at -8 -3 ground sit
place Placeable_Cropplot_Medium - at -11.5 0.5 ground sit
place Placeable_Cropplot_Medium - at -8 0.5 ground sit
place Placeable_Cropplot_Medium - at -5 -1.5 ground sit

# --- The dovecote: storage pieces stacked, a nest on top; the pigeon box (hidden until the pigeons fly) ----------------
place Placeable_Storage_Large dovecote at 2 -4 ground sit yaw=180
place Placeable_Storage_Large dovecotetop at 2 -4 y=1.95 sit yaw=180
place Placeable_BirdsNest - at 2 -4 y=3.9 sit
place Loot_ChestSmall pigeonbox at 3.6 -4.6 ground sit yaw=200

# --- The post bicycle shed --------------------------------------------------------------------------------------------
push at 9 -7 h=9
call openhall w=2 d=1
call mailsack x=0.8 z=0.7 yaw=20 al=sacks
place "Box Small" - at 2.2 0.7 y=0.2 sit yaw=-15
pop

store adashop at 0 16 ground

# --- Nature: the reefs, things to gather, a treasure --------------------------------------------------------------------
scatter "Pickup_Landmark_Flower_Blue" 2 at -20 18 r=12 seed=4811 free=3
call dirt x=18 z=20 r=10 n=2 seed=4812
call hives x=-22 z=-16 r=10 n=1 seed=4813
call treasure x=24 z=-14 r=8 n=1 seed=4814 kind=0
place Creature_Dolphin dolphins at -36 -50 h=-3
prop dolphins creature.count=2
call shallows r=66 deep=5 n=2

# --- Settings, notes, behaviours, quest --------------------------------------------------------------------------------
info title=Ada's Round
info author=Custom Islands
info description=A green hill and the postmistress's homestead on its top: her stone house, a walled kitchen garden, a dovecote and the post bicycle shed. Ada is not home - but her pigeons are. The eighth stop of The Last Post.
island on.arrive=message||A green hill, a stone house on its top, a walled garden - and pigeons circling a dovecote.

prop house tint.color=#cfc6b4
prop house tint.amount=0.55
prop gardenwall tint.color=#9c9488
prop gardenwall tint.amount=0.5
prop sacks tint.color=#b8a478
prop sacks tint.amount=0.75

story pigeonsflown|Pigeons released|Note_Paper|Ada's homing pigeons, let out of the dovecote.
story attickey|Attic key|Placeable_Lantern_Metal|The key to Ada's attic store, from the pigeon box under the dovecote.
note diary Ada's diary | Monday. The water at the jetty again. I've sent the route cards out with the last boats.\n\nWednesday. Nobody comes for the post now, so I'm taking it to them. The pigeons know where I am going.\n\nFriday. Key to the attic in the pigeon box, as always. Let the pigeons out first or they'll have your fingers.\n\nIf you're reading this, you're on my round. Good.
prop dovecote obj.name=dovecote
prop dovecote beh.use=Open the dovecote
prop dovecote if.use=!signal|pigeons
prop dovecote on.use=sound||event:/wildlife/seagull/seagull_wingflap\nmessage||A clatter of wings - the pigeons burst out, circle the hill once and head off over the sea, all the same way. Under the dovecote, the pigeon box is open.\nsignal||pigeons\ngive||story:pigeonsflown*1\nshow|pigeonbox
prop dovecote else.use=message||The dovecote is empty. The pigeons have gone ahead.
note pigeonbox Pigeon box | The pigeon box: grain, a ring of tiny message tubes, and a big iron key tagged ATTIC.
loot pigeonbox story:attickey*1;Seed_Grass*2
prop pigeonbox obj.name=pigeonbox
prop pigeonbox beh.hidden=1
prop pigeonbox loot.refill=0
prop atticdoor obj.name=atticdoor
prop atticdoor beh.use=Unlock the attic store
prop atticdoor if.use=take|story:attickey|1
prop atticdoor on.use=hide|\nshow|attic\nshow|adanote\nmessage||The key turns stiffly and the padlock drops. Inside: Ada's attic chest, and a note on top of it.
prop atticdoor else.use=message||Ada's attic store, padlocked. The diary says where she keeps the key.
note attic Attic | Ada's attic chest: the post's best tools, packed for whoever comes next.
loot attic Blueprint_TitaniumTools*1;Blueprint_BackpackAdvanced*1;Blueprint_ZiplineToolElectric*1;TitaniumIngot*3;Cooked_Potato*3;Cooked_Beet*3;Seed_Strawberry*2
prop attic obj.name=attic
prop attic beh.hidden=1
prop attic loot.refill=0
note adanote Ada's note to the next postman | To the next postman,\n\nYou've done my round - every letter, every stop. Thank you.\n\nI've gone to the General Post Office, where the post began. It stands on the drowned square, colonnade and clock tower; you can't miss it. Bring the last letter if you find it.\n\n- Ada Lind, Postmistress
prop adanote obj.name=adanote
prop adanote beh.hidden=1

prop gatezone zone.id=garden_gate
prop gatezone zone.radius=3
prop gatezone zone.message=Ada's garden gate - never locked. The beds are weeded, the house is quiet.

quest title=Ada's Round
quest intro=The postmistress's house on a green hill. Find her garden gate.
step reach|garden_gate|1|Find the garden gate on the hilltop
step read|Ada's diary|1|Read Ada's diary in her house
step collect|story:pigeonsflown|1|Let the pigeons out of the dovecote
step collect|story:attickey|1|Take the attic key from the pigeon box
step open|Attic|1|Unlock the attic store and open Ada's chest
step blueprint|Blueprint_TitaniumTools|1|Take the titanium tools plans
step blueprint|Blueprint_BackpackAdvanced|1|Take the advanced backpack plans
step blueprint|Blueprint_ZiplineToolElectric|1|Take the electric zipline tool plans
step read|Ada's note to the next postman|1|Read Ada's note to the next postman
quest done=Ada has gone to the General Post Office. The pigeons flew that way.
quest reward=Cooked_Potato*4;Cooked_Beet*3;Seed_Watermelon*2;Seed_Strawberry*2

# Buried treasure (one of the story line's last islands): titanium ore on top of Raft's own treasure loot - the metal detector finds it, the shovel digs it
call treasure x=0 z=0 r=26 n=1 seed=8819
prop treasure8819 treasure.loot=TitaniumOre*3

save Ada's Round
