# Kit check (not content): the generator's huts of Raft's blocks as their code places them - the randomizer's castaway
# hut (RandomizerContent.Hut, 3 x 2), the ghost raft's hut (GhostRafts.Hut, 2 x 2), the wreck's shelter (MapTypes.Wreck)
new
gen Seed=1 Radius=40 Height=4 Shape=4 Roughness=0.1 ObjectDensity=0 Trees=0 Bushes=0 Rocks=0 BeachThings=0 Harvest=0
gen Hostiles=0 Friendly=0 SeaLife=0 Water=0 SeaRocks=0 SeaFinds=0 Sunken=0
generate
brush flatten at 0 0 r=35 s=20 frames=60
# castaway hut: foundations on the ground (0), deck 0.35, roofs at deck+2.4 over every cell (yaw 0)
push at -14 0
for x 0 3 1.5
place Block_Foundation - at $x 0 y=0
place Block_Foundation - at $x 1.5 y=0
place Block_Roof_Straight_Thatch - at $x 0 y=2.75
place Block_Roof_Straight_Thatch - at $x 1.5 y=2.75
place Block_Wall_Thatch - at $x -0.75 y=0.35
place Block_Wall_Thatch - at $x 2.25 y=0.35
next
place Block_Wall_Thatch - at -0.75 0 y=0.35 yaw=90
place Block_Wall_Thatch - at -0.75 1.5 y=0.35 yaw=90
place Block_Pillar_Wood - at -0.75 -0.75 y=0.35
place Block_Pillar_Wood - at 3.75 -0.75 y=0.35
place Block_Pillar_Wood - at -0.75 2.25 y=0.35
place Block_Pillar_Wood - at 3.75 2.25 y=0.35
pop
# ghost raft hut: foundations at 0.13, deck 0.35; roofs at deck+2.4 over (0,0), (g,0), (0,g)
push at 0 0
for x 0 1.5 1.5
place Block_Foundation - at $x 0 y=0.13
place Block_Foundation - at $x 1.5 y=0.13
next
place Block_Pillar_Wood - at -0.75 -0.75 y=0.35
place Block_Pillar_Wood - at 2.25 -0.75 y=0.35
place Block_Pillar_Wood - at -0.75 2.25 y=0.35
place Block_Pillar_Wood - at 2.25 2.25 y=0.35
place Block_Wall_Thatch - at 0 -0.75 y=0.35
place Block_Wall_Thatch - at 1.5 2.25 y=0.35 yaw=180
place Block_Wall_Thatch - at -0.75 1.5 y=0.35 yaw=90
place Block_Roof_Straight_Thatch - at 0 0 y=2.75
place Block_Roof_Straight_Thatch - at 1.5 0 y=2.75
place Block_Roof_Straight_Thatch - at 0 1.5 y=2.75
pop
# wreck: two pillars, a wall, a roof over the first cell
push at 12 0
place Block_Foundation - at 0 0 y=0.13
place Block_Foundation - at 1.5 0 y=0.13
place Block_Pillar_Wood - at -0.75 -0.75 y=0.35
place Block_Pillar_Wood - at 2.25 -0.75 y=0.35
place Block_Wall_Thatch - at 0 -0.75 y=0.35
place Block_Roof_Straight_Thatch - at 0 0 y=2.75
pop