place Note_Papers page5 at 3.2 4.8 y=0.61 drop yaw=-10 rot=0,0,0
place VG_LoungeChair - at 1 0.6 y=0.1 sit yaw=10
place VG_LoungeChair - at 2 0.6 y=0.1 sit yaw=-5
place VG_LoungeChair - at 5.5 0.6 y=0.1 sit
place VG_LoungeChair - at 6.6 0.6 y=0.1 sit yaw=15
place VG_LoungeChair - at 0.5 2.6 y=0.1 sit yaw=80
place VG_LoungeChair - at 1.2 3.5 y=0.1 sit yaw=95 scale=0.85
place Zone_Sound ballroommusic at 3.75 3 y=1.5
place Pickup_Landmark_Plastic3_Land - at 3.0 2.2 y=0.4 drop yaw=319
pop

# --- The boiler house behind the lodge's right half, across an alley from the kitchen (in the lodge's frame: 2 x 2 cells of Raft's blocks, a wooden roof): its door a wall piece that slides
# aside on the caretaker's key; the boiler, its pipes and gauge, the three valve wheels on the boiler's face (red, brass,
# black), the caretaker's cot and strongbox; the boiler's groan ------------------------------------------------------------
push at 7 8
call floors w=3 d=3
place Block_Wall_Tier3 - at 0.75 4.5 y=0.1
place Block_Wall_Tier3 - at 2.25 4.5 y=0.1
place Block_Wall_Tier3 - at 3.75 4.5 y=0.1
place Block_Wall_Tier3 - at 0 0.75 y=0.1 yaw=90
place Block_Wall_Tier3 - at 0 2.25 y=0.1 yaw=90
place Block_Wall_Tier3 - at 0 3.75 y=0.1 yaw=90
place Block_Wall_Tier3 - at 4.5 0.75 y=0.1 yaw=90
place Block_Wall_Tier3 - at 4.5 2.25 y=0.1 yaw=90
place Block_Wall_Tier3 - at 4.5 3.75 y=0.1 yaw=90
place Block_Wall_Tier3 - at 2.25 0 y=0.1
place Block_Wall_Tier3 - at 3.75 0 y=0.1
place Block_Wall_Tier3 boilerdoor at 0.75 -0.15 y=0.1
call corners w=3 d=3
roof 3 3 at 0 0 y=0.1 wood
place "VG_DecorationPrefabBase_Engine Variant" lodgeengine at 2.25 3.2 y=0.1 sit
# (scenery: the old engine by the valve wheels - the ready piece's lock taken off)
prop lodgeengine beh.use=
prop lodgeengine if.use=
prop lodgeengine else.use=
prop lodgeengine on.use=
place TP_Selene_DoorCrankWheel valvered at 1.2 1.62 y=1.3 rot=0,0,0
place TP_Selene_DoorCrankWheel valvebrass at 2.25 1.62 y=1.3 rot=0,0,0
place TP_Selene_DoorCrankWheel valveblack at 3.3 1.62 y=1.3 rot=0,0,0
place "VG_DecorationPrefabBase_Pipe_Monitor Variant" - at 2.25 1.64 y=2.05
place Loot_ChestLarge strongbox at 4 0.7 y=0.1 sit yaw=270
place Zone_Sound boilersound at 2.25 2.25 y=1.5
place Zone_Trigger boilerroom at 2.25 1 y=1
pop
# (the lodge's frame ends)
pop

# --- The hedge maze on the levelled west lowland: 24 x 24 m of evergreen hedges on a 4 m grid, the way in on its south
# side, a loop and four dead ends on the way to the heart - an 8 x 8 m square with the caretaker's bench and a lamp post,
# where the white bear waits; snow and fog inside -------------------------------------------------------------------------
push at -14 10 h=4.55 yaw=180
call hedgex 0 0
call hedgex 4 0
call hedgex 8 0
call hedgex 16 0
call hedgex 20 0
call hedgex 0 24
call hedgex 4 24
call hedgex 8 24
call hedgex 12 24
call hedgex 16 24
call hedgex 20 24
for mz 0 20 4
call hedgez 0 $mz
call hedgez 24 $mz
next
call hedgez 16 4
call hedgez 20 4
call hedgez 8 8
call hedgez 16 8
call hedgez 20 8
call hedgez 4 12
call hedgez 8 12
call hedgez 16 12
call hedgez 20 12
call hedgez 12 16
call hedgez 12 20
call hedgex 4 4
call hedgex 8 4
call hedgex 12 4
call hedgex 8 8
call hedgex 12 8
call hedgex 4 16
call hedgex 8 16
call hedgex 16 16
call hedgex 4 20
call hedgex 8 20
call hedgex 12 20
call hedgex 16 20
place Floorlamp_01 - at 11.3 -0.8 y=0 sit
place Floorlamp_01 - at 16.7 -0.8 y=0 sit
place Tangaroa_OutdoorFurniture_Bench mazebench at 12 11 y=0 sit
place Floorlamp_01 - at 13.6 11.2 y=0 sit
place TP_SnowDrift02 - at 2 2 y=0 sit yaw=30
place TP_SnowDrift02 - at 22 22 y=0 sit yaw=200
place TP_SnowDrift02 - at 9.6 9.6 y=0 sit yaw=110
place Zone_Trigger maze at 14 -2 y=1
place Zone_Trigger mazeheart at 12 12 y=1
place Zone_Atmosphere mazefog at 12 12 y=2
place Creature_PolarBear mazebear at 13 14 y=0.2
pop

# --- The jetty on the north beach and the drive up to the lodge's door, its lamp posts; the box at the jetty's end; the
# snowcat shed on the shelf east of the drive; the lodge's old skiff and a barrel 4 m down off the jetty; snow and wind --
push at 2.25 41 h=-2.7 yaw=270
call boardwalk n=7 wide=1 y=4.3
place "Box Small" jettybox at 9.6 0.75 y=4.3 sit yaw=15
pop
place Floorlamp_02 - at 2.6 39 ground
place Floorlamp_02 - at 6.6 36.2 ground
place SnowmobileShedMesh - at 16 31 ground yaw=270
place TP_SnowVehicle01 - at 16 31 ground yaw=270
place TP_SnowShovel02 - at 13 27.6 ground yaw=40
place "Box Small" shedbox at 13 34.6 ground yaw=-20
place RT_PlasticBoat - at 10 52 h=-4.2 sit yaw=30 roll=60
place Loot_SunkenBarrel sunkbarrel at 11.6 50.8 h=-4.2 sit
place Zone_Atmosphere snowfall at 0 0 y=8
place Zone_Sound wind at 0 0 y=8

# --- Animals: two goats on the hill's south slope, dolphins off the north shore --------------------------------------------------------
place Creature_Goat goats at 6 -22 ground
prop goats creature.count=2
place Creature_Dolphin dolphins at 0 64 h=-3
prop dolphins creature.count=2

# --- Things to gather, as suits the island (the user, 2026-10-05): pines, flowers, berries ----------
scatter "Pickup_Landmark_Tree_Pine" 3 at 0 0 r=31.5 seed=4200 free=5
scatter "Pickup_Landmark_Flower_White" 2 at 0 0 r=31.5 seed=4210 free=3
scatter "Pickup_Landmark_Flower_Blue" 2 at 0 0 r=31.5 seed=4211 free=3
scatter "Pickup_Landmark_BerryBush" 3 at 0 0 r=31.5 seed=4220 free=3

# --- Raft's finds in the shallows round the island (sand, clay, stones, ores, scrap - every Raft island has them): lib_sea
call shallows r=60 deep=5

# ===== Settings, story items, notes, behaviours, quest (7 steps) ==========================================================
info title=Highmoor Lodge
info author=Custom Islands
info description=A mountain lodge on a snowy island, closed for the winter with one caretaker to keep the boiler vented. In spring he was gone, his typed pages all over the house, music playing in the empty ballroom - and his key at the heart of the hedge maze, where a white bear walked in and never came out.
island on.arrive=message||A snowy hill with a big wooden lodge on its shoulder, every window dark. Somewhere inside, faintly, music is playing.

story boilerkey|Boiler room key|quest:Caravan_KeyInfirmary|The boiler house key on a brass tag, from the caretaker's coat.

note ledger Manager's ledger | HIGHMOOR LODGE - CLOSED FOR THE WINTER\n\nCaretaker: H. Brand, engaged for the season.\nDuties: vent the boiler EVERY MORNING, valves in their order; keep the drive clear; keep out of the maze after dark.\nI left him the typewriter. He said he'd finally write his book.\n\n(added in spring) The drive was buried, the house cold, the boiler groaning like an animal. No Brand. His pages are all over the house. I've touched nothing. - A. Lindqvist, manager
note page1 Typed page, chapter one | THE WINTER BOOK - by H. Brand\n\nChapter one. The lodge closes on the first snow, and the caretaker stays alone with the house and the boiler, which must be vented every morning, or it will-
note page2 Typed page, chapter four | Chapter four. Tonight he hears the ballroom's music again, though the power has been off for a week. At dawn he vents the boiler: red, then brass, then black. The order matters. It always matters.
note page3 Typed page, chapter nine | Chapter nine. Room 9 is occupied. The ledger says it is empty. The caretaker knocked. Someone inside knocked back.
note page4 Typed page, chapter eleven | Chapter eleven. A white bear came down off the peak in the storm and walked into the maze. It has not come out. The caretaker's coat is in there, on the bench at the heart, with his keys in the pocket. He has decided to go in after it.
note page5 Typed page, chapter twelve | Chapter twelve. No more chapters.\n\nIf anyone reads this: the boiler house key is in my coat, on the bench at the maze's heart. Vent the boiler - red, brass, black - before the pressure takes the whole house with it. - H. B.
note mazebench Caretaker's coat | A heavy coat frozen stiff on the bench, as if somebody took it off to sit down and never put it back on. In the pocket: a key on a brass tag.
loot mazebench story:boilerkey*1;Wool*2;Leather*1
prop mazebench loot.refill=0
note strongbox Caretaker's strongbox | The caretaker's strongbox under his cot: his wages, a greenhouse catalogue he marked up all winter, the lodge's spare fire grate - and the record that was on the ballroom's gramophone.
loot strongbox Blueprint_Cropplot_Small_Tier3*1;Placeable_Lantern_Fireplace*1;Wool*4;Leather*3;Cassette_Classical*1
prop strongbox loot.refill=0
prop strongbox if.open=signal|vented
prop strongbox else.open=message||The strongbox sits against the boiler's flank, too hot to touch - the whole room shakes. Vent the boiler first.
loot pantry Cooked_GenericMeat*2;Raw_Potato*3;Jar_Honey*1
prop pantry loot.refill=0
loot jettybox Rope*3;Plank*5;Nail*6
prop jettybox loot.refill=0
loot shedbox Bolt*3;Scrap*3;BioFuel*1
prop shedbox loot.refill=0
loot sunkbarrel Scrap*3;MetalOre*2;Plastic*2
prop sunkbarrel loot.refill=0

prop boilerdoor obj.name=boilerdoor
prop boilerdoor beh.use=Unlock the boiler house
prop boilerdoor beh.move=1.5,0,0
prop boilerdoor beh.moveTime=1.5
prop boilerdoor beh.moveMode=switch
prop boilerdoor if.use=has|story:boilerkey|1
prop boilerdoor on.use=message||The key turns stiffly. The door slides aside on heat and noise - the boiler is hammering, its needle deep in the red.\nopen|boilerdoor\nsound||event:/raft/door/door_unlock_key
prop boilerdoor else.use=message||Locked, and hot to the touch. The caretaker kept the key on him.
prop valvered obj.name=valvered
prop valvered tint.color=#9a2a22
prop valvered tint.amount=0.6
prop valvered beh.use=Turn the red valve
prop valvered on.use=message||Steam screams out of the red valve's pipe. The needle drops a little.\nsignal||v1\nsound||event:/exploring/temperence/selene/handle_spin
prop valvebrass obj.name=valvebrass
prop valvebrass tint.color=#b08a3a
prop valvebrass tint.amount=0.6
prop valvebrass beh.use=Turn the brass valve
prop valvebrass if.use=signal|v1
prop valvebrass on.use=message||The brass valve coughs and roars. The needle falls past the middle.\nsignal||v2\nsound||event:/exploring/temperence/selene/handle_spin
prop valvebrass else.use=message||The needle jumps - the whole boiler bangs. Wrong valve! "Red, then brass, then black."
prop valveblack obj.name=valveblack
prop valveblack tint.color=#1a1a1a
prop valveblack tint.amount=0.6
prop valveblack beh.use=Turn the black valve
prop valveblack if.use=signal|v2
prop valveblack on.use=message||The black wheel turns, the last steam goes up the stack with a long sigh - and the boiler falls quiet. Somewhere in the lodge, the music stops.\nsignal||vented\nhide|boilersound\nhide|ballroommusic\nsound||event:/exploring/temperence/selene/handle_spin
prop valveblack else.use=message||The needle jumps - the whole boiler bangs. Wrong valve! "Red, then brass, then black."
prop boilersound obj.name=boilersound
prop boilersound sound.event=event:/raft/engine/boiler
prop boilersound sound.volume=0.7
prop boilersound zone.radius=10
prop ballroommusic obj.name=ballroommusic
prop ballroommusic sound.event=event:/exploring/elevator/elevator_music
prop ballroommusic sound.volume=0.45
prop ballroommusic zone.radius=9

prop lodge zone.id=lodge
prop lodge zone.radius=7
prop lodge zone.message=Highmoor Lodge. The door is unlocked. Inside, a clock ticks, and far off in the house a band plays to nobody.
prop maze zone.id=maze
prop maze zone.radius=5
prop maze zone.message=The hedge maze: walls of frozen green, taller than you, the snow inside unmarked - but for one line of very large footprints.
prop mazeheart zone.id=mazeheart
prop mazeheart zone.radius=5
prop mazeheart zone.message=The heart of the maze: a bench, a coat - and the white bear, rising from the snow behind it!
prop boilerroom zone.id=boilerroom
prop boilerroom zone.radius=2.5
prop boilerroom zone.message=The boiler hammers like a fist on a door. Three valves on its face: red, brass, black.
prop mazebear creature.count=1
prop mazebear creature.size=1.2
prop mazebear creature.health=3
prop mazebear creature.respawn=0
prop mazebear creature.zone=mazeheart
prop kitchenrats creature.count=2
prop kitchenrats creature.respawn=0
prop mazefog atmo.fog=#c8d2da
prop mazefog atmo.fogAmount=0.4
prop mazefog atmo.particles=snow
prop mazefog zone.radius=16
prop snowfall atmo.fog=#d0d8de
prop snowfall atmo.fogAmount=0.2
prop snowfall atmo.particles=snow
prop snowfall zone.radius=45
prop wind sound.event=event:/amb/temperance
prop wind sound.volume=0.5
prop wind zone.radius=45

quest title=The Winter Book
quest intro=A lodge closed for the winter with one man to look after it. He isn't here any more - but his pages are. Start up the drive.
step read|Manager's ledger|1|Climb the drive to the lodge and read the ledger on the front desk
step pages||6|Read the six pages of the lodge's winter: the ledger and the caretaker's five typed pages
step reach|maze|1|Find the way into the hedge maze west of the lodge
step kill|Polar bear|1|Survive what waits at the heart of the maze
step collect|story:boilerkey|1|Take the boiler house key from the caretaker's coat
step reach|boilerroom|1|Unlock the boiler house behind the lodge
step open|Caretaker's strongbox|1|Vent the three valves in the order of his pages - and open his strongbox
step blueprint|Blueprint_Cropplot_Small_Tier3|1|Take the small crop plot plans from the caretaker's strongbox
quest done=The boiler sighs and goes cold, and the music in the ballroom stops. The winter book has its last chapter - you wrote it.
quest reward=Plank*6;Wool*3;Cooked_GenericMeat*2

# --- A Raft store down the hill south of the lodge: the gift shop, open all winter (Raft's goods, and plans the crew missed) --
store giftshop at 2 -30 ground

# Buried treasure (reach audit 10-24: a late island of its story line needs one): the metal detector finds it, the shovel digs it
call treasure x=0 z=0 r=35 n=1 seed=8846
prop treasure8846 treasure.loot=TitaniumOre*2

save Highmoor Lodge
