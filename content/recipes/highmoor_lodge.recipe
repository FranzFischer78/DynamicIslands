# Highmoor Lodge - a themed island, normal size (x1)
# Inspiration: snowbound-hotel horror films (a mountain lodge closed for the winter, a caretaker alone with a typewriter
#   and a boiler that must be vented, music in an empty ballroom, a hedge maze in the snow) - the mood only, never named.
# Island type: Shape 0 (Round), Style 1 (snowy). One snowy hill: the lodge on a terrace on its north shelf, the hedge maze
#   on the levelled lowland west of it, a jetty and the drive up from the shore.
# The lodge closed for the winter with one caretaker to keep the boiler vented. In spring the drive was buried, the house
# cold, the boiler groaning - and the caretaker gone, his typed pages all over the house. The last one says his boiler
# room key is in his coat at the heart of the maze, where a white bear walked in during the storm and never came out.
# Quest "The Winter Book" (7 steps): the manager's ledger up the drive, six pages (a "find pages" step), the maze, the bear
# at its heart, the key in the caretaker's coat, the boiler house, three valves in order and his strongbox.
# PAGES: step 2 counts every note read on this island (6 = the ledger + five typed pages). The loot boxes have NO note on
# purpose: a chest with a note adds a page when opened and would finish the step early.
#
# Built by the recipe player (CIRecipe highmoor_lodge) through the editor's own operations.
include lib_huts
include lib_sea
new
# (nature: snowy, Like Raft's Temperance - a few pines and drifts, near-bare)
gen Trees=0.08 Bushes=0.15 Rocks=0.25 Harvest=0.05 BeachThings=0.3
gen Seed=9006 Radius=45 Height=20 Roughness=0.35 Peaks=1 Shape=0 Style=1 BeachWidth=0.4 Cliffs=0.2 PeakShape=0.3
gen SeaFloor=0 Shelf=0.4 Seabed=1
gen Water=0.5 SeaRocks=0.5 SeaFinds=0.5 Sunken=0.4 Hostiles=0
generate

# hedgex / hedgez: a 4 m run of the maze's evergreen hedge - three young snowy firs (Temperance's pine at 0.13: Balboa's
# bushes are autumn orange, and tint doesn't take on them) and an invisible wall along them (trees have no collider low
# down) - from (x, z) along +x / along +z, on the frame's floor
macro hedgex x z
place Helper_Wall - at {$x+2} $z y=0
place TP_PineTreeSnowy - at {$x+0.67} $z y=0 sit scale=0.13
place TP_PineTreeSnowy - at {$x+2} $z y=0 sit scale=0.13 yaw=120
place TP_PineTreeSnowy - at {$x+3.33} $z y=0 sit scale=0.13 yaw=240
end
macro hedgez x z
place Helper_Wall - at $x {$z+2} y=0 yaw=90
place TP_PineTreeSnowy - at $x {$z+0.67} y=0 sit scale=0.13 yaw=60
place TP_PineTreeSnowy - at $x {$z+2} y=0 sit scale=0.13 yaw=180
place TP_PineTreeSnowy - at $x {$z+3.33} y=0 sit scale=0.13 yaw=300
end

# --- Terrain: a pad on the hill's north shelf (3.4 m) for the lodge, its wings and the boiler house, cut into the hill's
# flank behind them; the west lowland levelled at 4.5 m for the maze; the drive's slope down to the jetty eased -----------
brush flatten from -9 31 to 12 31 r=5 s=20 frames=80 h=3.4
brush flatten from -9 26 to 12 26 r=5 s=20 frames=80 h=3.4
brush flatten from -9 21.5 to 12 21.5 r=4.5 s=20 frames=100 h=3.4
brush flatten from -41 -12 to -11 -12 r=6 s=20 frames=100 h=4.5
brush flatten from -41 -4 to -11 -4 r=6 s=20 frames=100 h=4.5
brush flatten from -41 4 to -11 4 r=6 s=20 frames=100 h=4.5
brush flatten from -41 10 to -11 10 r=5 s=20 frames=80 h=4.5
brush smooth from 4.5 34 to 3 42 r=4 s=10 frames=12
brush smooth from -10 18 to -24 12 r=5 s=10 frames=12
clear from -9 27 to 12 27 r=8
clear from -41 -2 to -11 -2 r=16
clear from 4.5 34 to 3 44 r=3
clear at 15 31 r=6

# --- The lodge on its terrace: two storeys of Raft's solid wooden walls (6 x 4 cells, 9 x 6 m) on floors of Raft's
# blocks, its corner posts up into a wooden hip roof on the upper walls; the front door a gap in the front wall (Raft's
# door walls stay shut on islands); the lobby and the lounge downstairs, the stair in the back left corner, the guest rooms
# upstairs (room 9 behind a partition). Frame: x along the front, z from the front (the drive) to the back --------------
push at 10 33 h=3.45 yaw=180
call floors w=6 d=4
# (the ground floor's walls: windows, the front door at x 4.5-6, the way into the kitchen at the back x 1.5-3, the way into
# the ballroom on the right z 1.5-3)
place Block_Wall_Window_Tier3 - at 0.75 0 y=0.1
place Block_Wall_Window_Tier3 - at 2.25 0 y=0.1
place Block_Wall_Tier3 - at 3.75 0 y=0.1
place Block_Wall_Window_Tier3 - at 6.75 0 y=0.1
place Block_Wall_Window_Tier3 - at 8.25 0 y=0.1
place Block_Wall_Tier3 - at 0.75 6 y=0.1
place Block_Wall_Tier3 - at 3.75 6 y=0.1
place Block_Wall_Tier3 - at 5.25 6 y=0.1
place Block_Wall_Tier3 - at 6.75 6 y=0.1
place Block_Wall_Tier3 - at 8.25 6 y=0.1
place Block_Wall_Window_Tier3 - at 0 0.75 y=0.1 yaw=90
place Block_Wall_Tier3 - at 0 2.25 y=0.1 yaw=90
place Block_Wall_Window_Tier3 - at 0 3.75 y=0.1 yaw=90
place Block_Wall_Tier3 - at 0 5.25 y=0.1 yaw=90
place Block_Wall_Tier3 - at 9 0.75 y=0.1 yaw=90
place Block_Wall_Tier3 - at 9 3.75 y=0.1 yaw=90
place Block_Wall_Tier3 - at 9 5.25 y=0.1 yaw=90
# (the upper floor on the walls, with the stair's well over the back left corner; the stair up to it)
for fx 2.25 8.25 1.5
for fz 0.75 5.25 1.5
place Block_Floor_Wood - at $fx $fz y=2.52
next
next
place Block_Floor_Wood - at 0.75 0.75 y=2.52
place Block_Floor_Wood - at 0.75 5.25 y=2.52
# (the stair along the left wall, its foot 1.5 m from the back wall, up towards the front to the landing at z 0-1.5; the
# well over it)
place Block_Stair_Tier3 stair at 0.75 3 y=0.1 sit centred yaw=180
# (the upper storey's walls: windows all round, room 9's partition with its doorway)
place Block_Wall_Window_Tier3 - at 0.75 0 y=2.52
place Block_Wall_Tier3 - at 2.25 0 y=2.52
place Block_Wall_Window_Tier3 - at 3.75 0 y=2.52
place Block_Wall_Window_Tier3 - at 5.25 0 y=2.52
place Block_Wall_Tier3 - at 6.75 0 y=2.52
place Block_Wall_Window_Tier3 - at 8.25 0 y=2.52
place Block_Wall_Tier3 - at 0.75 6 y=2.52
place Block_Wall_Window_Tier3 - at 2.25 6 y=2.52
place Block_Wall_Tier3 - at 3.75 6 y=2.52
place Block_Wall_Window_Tier3 - at 5.25 6 y=2.52
place Block_Wall_Tier3 - at 6.75 6 y=2.52
place Block_Wall_Window_Tier3 - at 8.25 6 y=2.52
place Block_Wall_Tier3 - at 0 0.75 y=2.52 yaw=90
place Block_Wall_Window_Tier3 - at 0 2.25 y=2.52 yaw=90
place Block_Wall_Tier3 - at 0 3.75 y=2.52 yaw=90
place Block_Wall_Tier3 - at 0 5.25 y=2.52 yaw=90
place Block_Wall_Tier3 - at 9 0.75 y=2.52 yaw=90
place Block_Wall_Window_Tier3 - at 9 2.25 y=2.52 yaw=90
place Block_Wall_Tier3 - at 9 3.75 y=2.52 yaw=90
place Block_Wall_Window_Tier3 - at 9 5.25 y=2.52 yaw=90
place Block_Wall_Tier3 - at 6 0.75 y=2.52 yaw=90
place Block_Wall_Tier3 - at 6 3.75 y=2.52 yaw=90
place Block_Wall_Tier3 - at 6 5.25 y=2.52 yaw=90
for lv 0 1 1
place Block_Pillar_Tier3 - at 0 0 y={0.1+$lv*2.42}
place Block_Pillar_Tier3 - at 9 0 y={0.1+$lv*2.42}
place Block_Pillar_Tier3 - at 0 6 y={0.1+$lv*2.42}
place Block_Pillar_Tier3 - at 9 6 y={0.1+$lv*2.42}
next
roof 6 4 at 0 0 y=2.52 wood
# (downstairs: the front desk with the manager's ledger and the clock behind it, a rug; the lounge with the fireplace on
# the front wall, two armchairs and the typewriter table with page one)
place "Counter Left" - at 6 3.4 y=0.1 sit yaw=180
place "Counter Mid" - at 7 3.4 y=0.1 sit yaw=180
place "Counter Right" - at 8 3.4 y=0.1 sit yaw=180
place Note_Book ledger at 7 3.75 y=1.17 drop yaw=8 rot=0,0,0
place "VG_DecorationPrefabBase_Clock Variant" - at 7 5.88 y=1.6 yaw=180
place Placeable_Rug_Rectangle - at 5.25 1.6 y=0.1 yaw=90
place Placeable_Lantern_Fireplace - at 3.75 0.45 y=0.1 sit
place "VG_DecorationPrefabBase_Armchair Variant" - at 2.6 1.8 y=0.1 sit yaw=140
place "VG_DecorationPrefabBase_Armchair Variant" - at 1.7 0.9 y=0.1 sit yaw=110
place Placeable_Table_Basic - at 3.4 4.6 y=0.1 sit yaw=90
place Tangaroa_OfficeKit_Keyboard - at 3.4 4.4 y=0.84 drop yaw=0
place Note_Papers page1 at 3.0 4.9 y=0.84 drop yaw=20 rot=0,0,0
place Note_Papers page2 at 8.3 3.6 y=1.17 drop yaw=-30 rot=0,0,0
# (upstairs: room 9 on the right behind the partition - the bed with page three, the wardrobe; a guest room on the left)
place Placeable_Bed_Wood - at 7.5 4.6 y=2.52 sit yaw=90
place Note_Papers page3 at 7.4 4.5 y=3.1 drop yaw=40 rot=0,0,0
place Placeable_Wardrobe - at 8.3 1.0 y=2.52 sit yaw=270
place Placeable_Bed_Wood - at 3.6 4.65 y=2.52 sit yaw=90
place Zone_Trigger lodge at 5.25 -3 y=1
place Pickup_Landmark_Plastic3_Land - at 4.3 2.6 y=0.4 drop yaw=83
place Pickup_Landmark_Plank_Land - at 4.8 2.3 y=2.82 drop yaw=157

# --- The kitchen wing behind the lodge (in the lodge's frame: 4 x 3 cells, one storey, a wooden roof): the bench and the stove, the pantry, page
# four on the counter, two rats; its way in from the lodge at x 1.5-3, the boiler house's door on its right ---------------
push at 0 6
call floors w=4 d=3
place Block_Wall_Tier3 - at 0.75 4.5 y=0.1
place Block_Wall_Window_Tier3 - at 2.25 4.5 y=0.1
place Block_Wall_Tier3 - at 3.75 4.5 y=0.1
place Block_Wall_Tier3 - at 5.25 4.5 y=0.1
