place Block_Wall_Window_Tier3 - at 0 2.25 y=0.1 yaw=90
place Block_Wall_Tier3 - at 0 3.75 y=0.1 yaw=90
place Block_Wall_Tier3 - at 6 0.75 y=0.1 yaw=90
place Block_Wall_Tier3 - at 6 3.75 y=0.1 yaw=90
call corners w=4 d=3
roof 4 3 at 0 0 y=0.1 wood
place TangaroaKitchen_Bench5 - at 4.6 4.4 y=0.1 sit
place "VG_DecorationPrefabBase_Stove Variant" - at 0.6 3.8 y=0.1 sit yaw=90
place Placeable_Cupboard_Large pantry at 0.4 1.5 y=0.1 sit yaw=90
place Note_Papers page4 at 3.2 4.05 y=1.12 drop yaw=15 rot=0,0,0
place Creature_Rat kitchenrats at 3 2 y=0.3
place "Pickup_Landmark_Scrap 3_Land" - at 2.2 3.1 y=0.4 drop yaw=240
place Pickup_Landmark_Plank_Land - at 4.6 1.3 y=0.4 drop yaw=5
pop

# --- The ballroom on the lodge's right (in the lodge's frame: 5 x 4 cells, a wooden roof): the stage, chairs pushed to the walls, the piano,
