place RT_Camera - at -2.4 -87.4 h=6.2 yaw=-135
place RT_Camera - at -8.4 -79 h=6.2 yaw=-135
place TP_RotatingRedLight camlights at -19.85 -104.85 h=5.9
place TP_RotatingRedLight camlights at -2.15 -104.85 h=5.9
place TP_RotatingRedLight camlights at -19.85 -96.6 h=5.9
place TP_RotatingRedLight camlights at -13.85 -88 h=5.9
place TP_RotatingRedLight camlights at -2.15 -87.4 h=5.9
place TP_RotatingRedLight camlights at -8.15 -79 h=5.9
place TP_Selene_Int_Room_Bars - at -7.2 -100 h=3.6 yaw=0
place "Table Office" - at -4 -98 h=3.6 sit yaw=0
place Note_Book ledger at -4 -98 h=5 drop yaw=20
# --- The back room by the yard door; the counting room with its rats -------------------------------------------------
place Zone_Trigger casinofloor at -17 -91.5 h=4.6
place "Box Small" - at -19 -88 h=3.6 sit yaw=10
place "Table Office" - at -5 -91 h=3.6 sit yaw=0
place "VG_DecorationPrefabBase_Tray2 Variant" - at -5.4 -91 h=5 drop
place "VG_DecorationPrefabBase_Tray2 Variant" - at -4.6 -91 h=5 drop yaw=30
place Creature_Rat_Tangaroa cashrats at -4 -89 h=3.9
place Zone_Trigger countingroom at -5 -91.5 h=4.6
# --- The vault corridor: the laser emitters facing each other, the beams an invisible wall and a red glow; the panel by
# its entrance; the time lock by the vault door (Selene's gate, slides aside) -----------------------------------------
place TP_LaserEmitter - at -13.7 -91 h=5.3 yaw=90
place TP_LaserEmitter - at -8.3 -91 h=5.3 yaw=270
place Helper_Wall laserwall at -11 -91 h=3.6 sx=1.5
place TP_RotatingRedLight laserglow at -11 -91 h=6.4
place TP_LaserControlPanel laserpanel at -13.85 -94.5 h=3.6 yaw=90
place Zone_Trigger vaultcorridor at -11 -88.4 h=4.6
place TP_SeleneEntranceGate vaultdoor at -11 -87 h=3.6 sx=0.83
place VP_GarageDoor_KeyHole timelock at -8.15 -87.6 h=4.8 yaw=270
place RT_Pillar - at -8.15 -87.6 h=3.6 sy=0.37
# --- The vault: crates of gold, the house's reserve -------------------------------------------------------------------
for gx -13 -10 1.5
place TP_Moontown_SealedCrate02_Clean goldcrates at $gx -79.5 h=3.6 sit
place TP_Moontown_SealedCrate02_Clean goldcrates at $gx -79.5 h=4.6 sit
next
place Loot_ChestLarge goldreserve at -11 -81.5 h=3.6 yaw=180
place Zone_Trigger vaultzone at -11 -83 h=4.6
# --- The service yard: walls round the pit ---------------------------------------------------------------------------
for wz -99 -90 3
place RT_Wall1 - at -29.5 $wz h=3.5 yaw=90
next
place RT_Wall1 - at -26.5 -99 h=3.5 yaw=0
place RT_Wall1 - at -23.5 -99 h=3.5 yaw=0
place RT_Wall1 - at -20.4 -99 h=3.5 yaw=0
place RT_Wall1 - at -26.5 -87 h=3.5 yaw=0
place RT_Wall1 - at -23.5 -87 h=3.5 yaw=0
place RT_Wall1 - at -20.4 -87 h=3.5 yaw=0

# ===== Chapter 5 - the getaway: the casino's own dock =================================================================
push at 13 -102 h=-2.5 yaw=0
call boardwalk n=8 wide=2 y=5.1
pop
place RT_PlasticBoat getawayboat at 21 -97.4 h=0 yaw=90
place Note_Paper lastpostcard at 21 -97.4 h=2 drop yaw=10
place MayorsChest crewstrongbox at 23 -101.2 h=2.6 sit yaw=270
place Zone_Trigger getawayzone at 20 -100.5 h=3.6

# ===== The friendly animals, Raft's finds in the shallows ==============================================================
place Creature_Dolphin dolphins at 100 40 h=-1.5
call shallows r=160 deep=5 n=2
prop turtles creature.count=2
prop dolphins creature.count=3
prop wheels beh.spin=20
prop spinner beh.spin=40
prop goldcrates tint.color=#c8a040
prop goldcrates tint.amount=0.6

# --- Things to gather, as suits the island (the user, 2026-10-05): palms, melons, pineapples ----------
scatter "Pickup_Landmark_Tree_Palm 1" 6 at 0 0 r=99.4 seed=4454 free=5
scatter "Pickup_Landmark_Tree_Palm 3" 6 at 0 0 r=99.4 seed=4455 free=5
scatter "Pickup_Landmark_WatermelonLandmark" 9 at 0 0 r=99.4 seed=4464 free=3
scatter "Pickup_Landmark_PineappleLandmark" 9 at 0 0 r=99.4 seed=4474 free=3

# ===== Settings, story items, notes, behaviours, quest (30 steps, 5 chapters) =============================================
info title=Paradise Archipelago
info author=Custom Islands
info description=A holiday-resort archipelago gone quiet - marina, hotel tower, water park, villas, a lighthouse bar - and on its own key the Golden Gull casino, its gold reserve still in the vault. A crew of five came to take it and never met again. Their plan is still here, a piece on every key. Finish the job.
island on.arrive=message||Seven sandy keys on a turquoise reef: a marina, a hotel tower, water slides, villas - and on its own key, a casino with a gold sign. Not a soul. Dogs bark on the marina.

story crewkey|Crew's locker key|quest:Vasagatan_BlueKey|The key of the crew's locker in the marina office, from the planner's cabin.
story fusepuller|Fuse puller|quest:Balboa_BrunosTool_Wrench|The electrician's insulated fuse puller, for the power islet's breakers.
story divemap|Diver's map|Placeable_PaperBundle|The diver's map of the service tunnel from the marina floor to the casino.
story dealercard|Croupier's card|quest:Tangaroa_KeyCard|The dealer's croupier card: it kills the vault corridor's lasers for thirty seconds.
story timelockkey|Time-lock key|quest:Vasagatan_GreenKey|The safecracker's key for the vault's time lock.
story blackout|Blackout|quest:Caravan_BatteryChargerPart|The casino's cameras and alarms are dark - the breakers are pulled.

note briefing Planner's briefing | THE JOB - Golden Gull casino, Azure Keys resort\n\nThe resort is closed, the sea is rising, and the house left its gold reserve in the vault because the insurance won't pay for a boat.\n\nFive of us, five jobs.\nSol (electrician): the cameras run off the power islet - three breakers; his notes say which order.\nNoa (diver): the service tunnel from the marina floor up under the casino - her map.\nMarco (dealer): his croupier's card kills the laser grid in the vault corridor for thirty seconds.\nIris (safecracker): the vault's time lock - her key.\nMe: the plan, and the getaway boat at the casino's own dock.\n\nWe split up to get our kits and meet back on the yacht. Nobody came back. Our locker's in the marina office; its key is in my cabin chest.\n\n- Vera
note electriciannotes Electrician's notes | (on the desk in room 304)\n\nBreakers on the power islet, for the cameras and the vault corridor's alarm:\nBLUE first, then GREEN, then RED.\nWrong order and the backup kicks in - you start over.\n\nMy fuse puller's in the service room downstairs. The roaches in the kitchen are the size of shoes.\n- Sol
note dealerletter Dealer's letter | Vera -\n\nI'm not coming. My card's at the bottom of the villa pool, where I threw it. If you want it, swim for it.\nIt kills the lasers for thirty seconds. Not one more.\n\nSorry.\n- Marco
note safecrackerpostcard Safecracker's postcard | (a postcard of the lighthouse bar, pinned behind the bar)\n\nV. - Time-lock key's in the bar cupboard. Set it, wait twenty seconds, the door opens.\nDon't be in the corridor when the lasers come back.\nI'm going to the mainland. I've had enough of islands.\n- I.
note ledger Pit boss's ledger | GOLDEN GULL - PIT BOSS'S LEDGER\n\nHouse reserve moved to the vault on the 9th.\nInsurance won't cover the boat. Gold stays until the season.\n\n(Season cancelled.)
note lastpostcard The crew's last postcard | (taped to the getaway boat's wheel)\n\nWhoever you are - you finished our job.\nOur shares are in the strongbox by the boat. We're not coming back for them.\nSpend it somewhere dry.\n- V., S., N., M., I.
note yachtchest Planner's cabin chest | Vera's cabin chest: charts, a pair of sunglasses, a deck of marked cards - and the key to the crew's locker.
loot yachtchest story:crewkey*1;Hat_Glasses_Aviator*1;Rope*2
prop yachtchest loot.refill=0
note crewlocker Crew's locker | The crew's locker: five sets of overalls, radios with dead batteries, and the plan of the job pinned inside the door.
loot crewlocker Battery*1;Rope*3;Plastic*3
prop crewlocker loot.refill=0
prop crewlocker if.open=has|story:crewkey|1
prop crewlocker else.open=message||The crew's locker is padlocked. The planner's briefing said the key is in her cabin chest.
prop crewlocker on.open=journal|The plan of the job|Five jobs, in order: Sol's breakers on the power islet (blue, green, red) for the blackout. Noa's tunnel from the marina floor under the third pier up into the casino. Marco's card for the lasers - thirty seconds. Iris's time lock - twenty seconds. Out to the getaway boat at the casino's own dock.
note servicebox Electrician's toolbox | Sol's toolbox in the service room: wire, tape - and his insulated fuse puller.
loot servicebox story:fusepuller*1;CopperIngot*2
prop servicebox loot.refill=0
note wavehut Diver's box | A dive bag in the wave-machine hut: fins, a mask - and Noa's map: "Tunnel mouth under the marina's third pier, behind a grate. Its bottom bolts are rusted through - push. Comes up under the casino's back room. Something lives in it."
loot wavehut story:divemap*1;OxygenBottle*2
prop wavehut loot.refill=0
note poolbox Box in the villa pool | A waterproof card wallet on the pool's floor: the croupier's card.
loot poolbox story:dealercard*1;TradeToken*2
prop poolbox loot.refill=0
note barcupboard Bar cupboard | The lighthouse bar's cupboard: glasses, limes gone to stone - and a heavy brass key tagged TIME LOCK.
loot barcupboard story:timelockkey*1;Glass*3
prop barcupboard loot.refill=0
note goldreserve House gold reserve | The Golden Gull's gold reserve: chips, coins, bars - the house's last season, never banked.
loot goldreserve TradeToken*30;TitaniumIngot*2;Placeable_ToyRobot_Golden*1
prop goldreserve loot.refill=0
prop goldreserve on.open=show|getawayzone\nopen|exitdoor\nhide|lasers\nmessage||Gold! The corridor's grid dies for good with the vault open, and at the back of the gaming floor a service shutter rattles down. Now out - the crew's getaway boat waits at the casino's own dock.
note crewstrongbox Crew's strongbox | The crew's strongbox: five shares, each in a velvet bag with a name on it, the plans they meant to retire on - a zipline for a beach house, beds for a garden, carpentry for a boat - and a tape for the long ride home.
loot crewstrongbox Blueprint_ZiplineBase*1;Blueprint_Cropplot_Small_Tier3*1;Blueprint_DetailPlank*1;TradeToken*40;Cassette_EDM*1
prop crewstrongbox loot.refill=0
prop crewstrongbox if.open=signal|heistdone
prop crewstrongbox else.open=message||The strongbox is wired to the boat's ignition - the crew's joke: no share without the job done.
note marinabarrel Marina floor barrel | A barrel on the marina floor: what fell off the yachts all season.
loot marinabarrel Plastic*4;Scrap*3;Rope*2
prop marinabarrel loot.refill=0
note beachbarbox Beach bar box | The beach bar's box: coconuts, glasses, a crate of tonic.
loot beachbarbox Coconut*4;Glass*2;PlasticBottle_Water*2
prop beachbarbox loot.refill=0
note minibar Room 304's minibar | The minibar: two cocktails and a jar of nuts.
loot minibar DrinkingGlass_Mangonana*1;DrinkingGlass_StrawberryColada*1;Banana*2
prop minibar loot.refill=0
note lifeguardbox Lifeguard's box | The lifeguard's box: a whistle, sun cream, a first-aid kit.
loot lifeguardbox HealingSalve*2;Rope*2;Plastic*2
prop lifeguardbox loot.refill=0
note villafridge Villa fridge | The villa's fridge: champagne gone flat, cheese gone strange, fruit.
loot villafridge Watermelon*1;Pineapple*1;Mango*2
prop villafridge loot.refill=0
note register Lighthouse bar's till | The bar's till: the last night's takings.
loot register TradeToken*6
prop register loot.refill=0
note powerlocker Power plant locker | The power plant's locker: spare fuses (the wrong size), a hard hat, wire.
loot powerlocker CopperIngot*2;Bolt*4;Hat_Construction*1
prop powerlocker loot.refill=0
note slotmachine Slot machine | A slot machine on the dark gaming floor, its glass cracked. Its coin box comes away in your hands.
loot slotmachine TradeToken*8;Glass*2
prop slotmachine loot.refill=0

prop breaker1 obj.name=breaker1
prop breaker1 beh.use=Pull the blue breaker
prop breaker1 if.use=has|story:fusepuller|1
prop breaker1 on.use=message||The blue breaker comes out with a fat spark. Across the water, the casino's sign flickers.\nsignal||b1\nsound||event:/raft/radar/lever
prop breaker1 else.use=message||Live breakers - you'd want the electrician's insulated fuse puller for these.
prop breaker2 obj.name=breaker2
prop breaker2 beh.use=Pull the green breaker
prop breaker2 if.use=has|story:fusepuller|1\nsignal|b1
prop breaker2 on.use=message||The green breaker comes out. The casino's sign goes dark.\nsignal||b2\nsound||event:/raft/radar/lever
prop breaker2 else.use=message||The backup hums and the breakers snap back - wrong order (or no fuse puller). Blue, then green, then red.
prop breaker3 obj.name=breaker3
prop breaker3 beh.use=Pull the red breaker
prop breaker3 if.use=has|story:fusepuller|1\nsignal|b2
prop breaker3 on.use=message||The red breaker comes out - and across the water every red light on the casino goes dark. Blackout.\ngive||story:blackout*1\nsignal||blackout\nhide|camlights\nsound||event:/raft/radar/radar_off
prop breaker3 else.use=message||The backup hums and the breakers snap back - wrong order (or no fuse puller). Blue, then green, then red.
prop camlights obj.name=camlights
prop tunnelgrate obj.name=tunnelgrate
prop tunnelgrate beh.use=Push the grate where its bolts are rusted through
prop tunnelgrate beh.turn=-80
prop tunnelgrate beh.moveTime=2
prop tunnelgrate beh.moveMode=switch
prop tunnelgrate if.use=has|story:divemap|1
prop tunnelgrate on.use=message||Just where the map said: the bottom bolts are rusted through. The grate swings in.\nopen|tunnelgrate\nsound||event:/exploring/utopia/gate_metal_open
prop tunnelgrate else.use=message||A heavy grate over a dark tunnel mouth, bolted fast - as far as you can see.
prop laserpanel obj.name=laserpanel
prop laserpanel beh.use=Swipe the croupier's card
prop laserpanel if.use=has|story:dealercard|1\nsignal|blackout
prop laserpanel on.use=message||The panel blinks green and the red beams across the corridor die. Thirty seconds - not one more.\nhide|lasers\nsound||event:/exploring/obstacles/keypad/keypad_correct\nwait|30\nshow|lasers\nmessage||The lasers snap back on.
prop laserpanel else.use=message||CORRIDOR SECURED. The panel wants a croupier's card - and with the alarms still live, it would only raise them.
prop laserwall obj.name=lasers
prop laserglow obj.name=lasers
prop laserglow beh.spin=120
prop timelock obj.name=timelock
prop timelock beh.use=Set the time lock
prop timelock if.use=quest|25\ntake|story:timelockkey|1
prop timelock on.use=message||The brass key turns with a clunk: TIME LOCK - 20 SECONDS. Something inside the door begins to tick.\nsound||event:/exploring/obstacles/doorbomb_tick\nwait|20\nopen|vaultdoor\nsignal||vaultopen\nmessage||The vault door rolls aside.
prop timelock else.use=message||A keyhole marked TIME LOCK. The safecracker had the key.
prop vaultdoor obj.name=vaultdoor
prop vaultdoor beh.move=-6,0,0
prop vaultdoor beh.moveTime=4
prop vaultdoor beh.moveMode=switch
prop exitdoor obj.name=exitdoor
prop exitdoor beh.move=0,-3.1,0
prop exitdoor beh.moveTime=2
prop exitdoor beh.moveMode=switch
prop getawayzone obj.name=getawayzone
prop getawayzone beh.hidden=1
prop getawayzone on.enter=signal||heistdone\nsound||event:/raft/engine/controller_on

prop marina zone.id=marina
prop marina zone.radius=14
prop marina zone.message=The resort's marina: yachts at their moorings, an office, a beach bar - and three security dogs who haven't been paid either.
prop hotel zone.id=hotel
prop hotel zone.radius=10
prop hotel zone.message=The hotel tower: four storeys of empty rooms, a fire stair up the side, the lobby's fountain dry.
prop hotelkitchen zone.id=hotelkitchen
prop hotelkitchen zone.radius=5
prop hotelkitchen zone.message=The hotel kitchen - and the roaches, exactly the size of shoes.
prop waterpark zone.id=waterpark
prop waterpark zone.radius=12
prop waterpark zone.message=The water park: wheels turning on the wave pool by themselves, diving boards, a lifeguard tower - and humming from the wave-machine hut.
prop villas zone.id=villas
prop villas zone.radius=12
prop villas zone.message=The villas: three of them, three pools - and in the corner one, a letter on the table.
prop lighthousebar zone.id=lighthousebar
prop lighthousebar zone.radius=6
prop lighthousebar zone.message=The lighthouse bar: stools up, glasses on the shelf - and a postcard pinned behind the bar.
prop powerisle zone.id=powerisle
prop powerisle zone.radius=10
prop powerisle zone.message=The power islet: a generator thundering on its own, and three breakers - blue, green, red.
prop tunnel zone.id=servicetunnel
prop tunnel zone.radius=4.5
prop tunnel zone.message=The service tunnel. Black water - and far in, a light, coming.
prop casinofloor zone.id=casinofloor
prop casinofloor zone.radius=6
prop casinofloor zone.message=The Golden Gull's gaming floor, dark but for the slot machines' glow. Somewhere a chandelier tinkles.
prop countingroom zone.id=countingroom
prop countingroom zone.radius=5
prop countingroom zone.message=The counting room - and the rats have been counting the money.
prop vaultcorridor zone.id=vaultcorridor
prop vaultcorridor zone.radius=3
prop vaultcorridor zone.message=Through the lasers. The vault door is in front of you, a brass keyhole beside it.
prop vaultzone zone.id=vault
prop vaultzone zone.radius=3
prop vaultzone zone.message=Inside the vault. Gold, stacked to the ceiling.
prop getawayzone zone.id=getaway
prop getawayzone zone.radius=6
prop getawayzone zone.message=The casino's own dock - and the getaway boat, the crew's postcard taped to its wheel. The engine turns over first time.
prop securitydogs creature.count=3
prop securitydogs creature.respawn=0
prop securitydogs creature.zone=marina
prop kitchenroaches creature.count=4
prop kitchenroaches creature.respawn=0
prop kitchenroaches creature.zone=hotelkitchen
prop bees creature.count=1
prop bees creature.respawn=0
prop tunnelthing creature.count=1
prop tunnelthing creature.size=1.8
prop tunnelthing creature.health=3
prop tunnelthing creature.respawn=0
prop tunnelthing creature.zone=servicetunnel
prop cashrats creature.count=3
prop cashrats creature.respawn=0
prop cashrats creature.zone=countingroom
prop tunneldark atmo.fog=#04080c
prop tunneldark atmo.fogAmount=0.8
prop tunneldark atmo.light=#0c141c
prop tunneldark atmo.lightAmount=0.85
prop tunneldark zone.radius=16

quest title=The Job
quest intro=A resort archipelago, a casino with its gold still in the vault, and a crew's plan in five pieces. The crew's yacht is at the marina.
# Chapter 1 - the marina
step reach|marina|1|Tie up at the resort's marina
step kill|Hyena|3|Deal with the security dogs loose on the marina
step read|Planner's briefing|1|Read the planner's briefing on the crew's yacht
step collect|story:crewkey|1|Find the crew's locker key in the yacht's cabin chest
step open|Crew's locker|1|Open the crew's locker in the marina office
# Chapter 2 - the crew
step reach|hotel|1|Cross the boardwalk to the hotel key
step kill|Roach|4|Clear the roaches out of the hotel kitchen
step read|Electrician's notes|1|Find the electrician's notes in room 304
step collect|story:fusepuller|1|Take his fuse puller from the hotel's service room
step reach|waterpark|1|Cross to the water park
step collect|story:divemap|1|Find the diver's map in the wave-machine hut (mind the bees)
step reach|villas|1|Reach the villa key
step read|Dealer's letter|1|Read the dealer's letter in the corner villa
step collect|story:dealercard|1|Dive into the villa's pool for the croupier's card
step reach|lighthousebar|1|Climb to the lighthouse bar on the point
step read|Safecracker's postcard|1|Read the safecracker's postcard behind the bar
step collect|story:timelockkey|1|Find her time-lock key in the bar cupboard
# Chapter 3 - lights out
step reach|powerisle|1|Swim to the resort's power plant on its islet
step collect|story:blackout|1|Pull the three breakers in the electrician's order
step reach|servicetunnel|1|Dive under the marina's third pier and push through the service tunnel's grate
step kill|Angler fish|1|Face the thing living in the service tunnel
step reach|casinofloor|1|Climb the service shaft onto the dark casino floor
step read|Pit boss's ledger|1|Read the pit boss's ledger in the cashier's cage
# Chapter 4 - the vault
step kill|Tangaroa rat|3|Clear the rats out of the counting room
step reach|vaultcorridor|1|Kill the lasers with the croupier's card and get through in thirty seconds
step reach|vault|1|Set the time lock and get into the vault when the door rolls open
step open|House gold reserve|1|Open the house's gold reserve
# Chapter 5 - the getaway
step reach|getaway|1|Carry the gold out to the crew's getaway boat at the casino's dock
step read|The crew's last postcard|1|Read the postcard taped to the boat's wheel
step open|Crew's strongbox|1|Open the crew's strongbox
quest done=The job is done - five specialists' worth of it, by one. The Golden Gull's lights are out, its vault is empty, and the crew's shares are yours. Spend them somewhere dry.
quest reward=TitaniumIngot*4;Battery*4;MetalIngot*10

save Paradise Archipelago
