# Paradise Archipelago - a themed island, ten times the size (x10). Inspiration: casino-heist films (a crew of five
# specialists, each with one job, a vault with lasers and a time lock) set in a holiday-resort archipelago (hotel tower,
# marina, water park, villas, a lighthouse bar) - the mood only, never named on the island.
# Seven sandy keys on a turquoise reef plateau 2.5 m down (Shape 2, Style 0), four of them the generator's and three raised
# by the recipe, joined by boardwalks (decks 2.6 m): the marina key in the south-west (-70 -55) with its three piers, the
# office and the beach bar; the hotel key in the middle (17 -18) with the hotel tower; the water park key in the north-east
# (45 75) with its wave pool; the villa key in the north (-10 66) with three villas and their pools; the lighthouse point
# (-50 45) with its bar. Not joined: the power islet (45 -78) and the casino key (-11 -93) with the Golden Gull - its
# front doors chained, its only way in the service tunnel from the marina's floor under the third pier into the flooded
# pit in its walled service yard; its own dock on its east side.
# Quest "The Job" (30 steps, 5 chapters): the marina (5), the crew's five kits (12), lights out and the tunnel (6), the
# vault - rats, lasers, time lock, gold (4), the getaway (3).
include lib_rt
include lib_huts
include lib_relay
include lib_sea
new
gen Trees=0.28 Bushes=0.28 Rocks=0.43 Harvest=0.24 BeachThings=0.3
gen Seed=9024 Radius=142 Height=10 Roughness=0.35 Peaks=1 Shape=2 Style=0 BeachWidth=0.8 Cliffs=0.1 PeakShape=0.25 Bays=0.3
gen SeaFloor=0 Shelf=0.5 Seabed=2
gen Water=0.5 SeaRocks=0.5 SeaFinds=0.3 Sunken=0.4 Hostiles=0 Friendly=0 SeaLife=0
generate

# ===== The land ==========================================================================================================
# (ramps: flatten dabs from one height to another along a line - paths between the pads and the boardwalks' landings)
macro dabs x1 z1 h1 x2 z2 h2 n=8 r=3
for i 0 $n
brush flatten at {$x1+($x2-$x1)*$i/$n} {$z1+($z2-$z1)*$i/$n} r=$r s=20 frames=25 h={$h1+($h2-$h1)*$i/$n}
next
end
# (the three raised keys: the villa key, the casino key, the power islet; sand round them, grass on top)
brush flatten at -10 66 r=20 s=20 frames=60 h=2.5
brush flatten at -10 66 r=14 s=20 frames=60 h=2.5
brush flatten at -21 76 r=7 s=20 frames=40 h=2.5
brush flatten at -3 76 r=7 s=20 frames=40 h=2.5
brush flatten at -3 58 r=7 s=20 frames=40 h=2.5
brush flatten at -10 78 r=12 s=20 frames=40 h=2.5
brush flatten at -3 80 r=7 s=20 frames=40 h=2.5
brush flatten at 2 50 r=7 s=20 frames=40 h=2.5
brush flatten at -12 50 r=6 s=20 frames=40 h=2.5
brush flatten from -26 -101 to 6 -101 r=9 s=20 frames=60 h=3.5
brush flatten from -26 -89 to 6 -89 r=9 s=20 frames=60 h=3.5
brush flatten at -11 -80 r=7 s=20 frames=60 h=3.5
brush flatten at -29 -93 r=7 s=20 frames=60 h=3.5
brush flatten at 45 -78 r=9 s=20 frames=60 h=2.5
brush sand at -10 66 r=21 s=20 frames=30
brush grass at -10 66 r=14 s=20 frames=30
brush sand from -26 -95 to 6 -95 r=16 s=20 frames=30
brush grass from -24 -95 to 4 -95 r=10 s=20 frames=30
brush sand at 45 -78 r=10 s=20 frames=30
# (the marina's waterfront on the marina key's south-east; its basin, 3 m, and the service tunnel's approach, 8 m)
brush flatten from -70 -76 to -46 -76 r=9 s=20 frames=60 h=2.45
brush flatten at -58 -68 r=9 s=20 frames=60 h=2.45
brush flatten from -72 -94 to -54 -94 r=7 s=20 frames=40 h=-3
brush flatten from -62 -92 to -58.6 -92 r=2.6 s=20 frames=40 h=-8
# (the casino's service yard: the pit for the tunnel's far end, 8 m down, the sea in it)
for px -25.5 -23.5 2
for pz -95 -91 2
brush flatten at $px $pz r=2.2 s=20 frames=30 h=-8
next
next
# (the hotel's pad on the hotel key; the water park's on its key, its wave pool; the villas' pools; the lighthouse's pad)
brush flatten at 12.5 -18 r=9 s=20 frames=60 h=6
brush flatten at 15 -18 r=6 s=20 frames=40 h=6
brush flatten at 45 72 r=16 s=20 frames=60 h=1.8
