brush flatten at 22 16 r=3 s=20 frames=30 h=2.45
brush flatten at 36 54 r=3 s=20 frames=30 h=2.45
brush flatten at 24 72 r=3 s=20 frames=30 h=2.45
brush flatten at 6 66 r=3 s=20 frames=30 h=2.45
brush flatten at -24 53 r=3 s=20 frames=30 h=2.45
brush flatten at -34 44 r=3 s=20 frames=30 h=2.45
brush flatten at 13 -100.5 r=3 s=20 frames=30 h=2.45
# (the paths: from the marina's waterfront to the first boardwalk; from the hotel's pad down to the second; from its far
# end up to the water park; from the water park to the third)
brush flatten from -52 -62 to -46 -52 r=3 s=20 frames=40 h=2.45
call dabs 17 -10 6 22 15 2.45 n=12
call dabs 36 54 2.45 41 63 1.8
call dabs 31 64 1.8 24 72 2.45
brush flatten from -12 50 to -24 53 r=3 s=20 frames=40 h=2.45
# (the built areas cleared of the generator's palms, bushes and rocks)
clear at -58 -72 r=14
clear from -72 -94 to -54 -94 r=8
clear from -28 -95 to 8 -95 r=14
clear at -11 -80 r=8
clear at 45 -78 r=10
clear at 12.5 -18 r=11
