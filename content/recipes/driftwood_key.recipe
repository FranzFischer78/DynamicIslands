# Driftwood Key - a new small island of the library (ROADMAP 3d NI3), no quest
# A low sandy key, a few palms, and a fisherman's cabin of planks built from what the sea brought - his bed, his fire
# outside, his box. Nothing hostile. Driftwood and barrels on the beach, Raft's finds in the shallows.
#
# Built by the recipe player (CIRecipe driftwood_key) through the editor's own operations. Points: the cabin's pad
# (2.2 m) x -4.5..0, z -3..0 (its door on the south side at -2.25 -3); the fire at -1 -6; the cabin's box inside at
# -3.6 -1.
include lib_huts
include lib_sea
include lib_features
include lib_ni34
new
gen Trees=0.28 Bushes=0.28 Rocks=0.3 Harvest=0.24 BeachThings=0.5
gen Seed=7402 Radius=22 Height=3.5 Roughness=0.3 Peaks=1 Shape=0 Style=0 BeachWidth=0.9 Cliffs=0 PeakShape=0.2
gen SeaFloor=0 Shelf=0.5 Seabed=2
gen Water=0.5 SeaRocks=0.35 SeaFinds=0.35 Sunken=0.4 Hostiles=0 Friendly=0 SeaLife=0
generate

# ===== Terrain: the cabin's pad, its yard =============================================================================
brush flatten at -2.25 -3 r=5.5 s=20 frames=60 h=2.2
brush sand at -1 -6 r=3 s=20 frames=20
clear at -2.25 -3 r=6.5

# ===== The fisherman's cabin: bed, box, his fire and his net outside ====================================================
push at -4.5 -3 h=2.2
call cabin w=3 d=2 al=cabinwall
place Bed_Simple - at 3.3 2.2 y=0.1 sit yaw=90
place "Box Small" cabinbox at 0.9 2 y=0.1 sit yaw=10
pop
place campfire_1 - at -1 -6.5 ground sit
place FishingNets_02 - at 1.8 -4.5 ground sit yaw=30
place Reef_Barrel1 - at -6.2 -4.6 ground sit yaw=40

# ===== Things to gather: palms and melons; driftwood barrels on the beach; Raft's finds in the shallows ===================
scatter "Pickup_Landmark_Tree_Palm 2" 3 at 0 0 r=15 seed=7412 free=5
scatter "Pickup_Landmark_WatermelonLandmark" 2 at 0 0 r=14 seed=7422 free=3
scatter Reef_Barrel3 2 at 0 0 r=19 seed=7432 free=4
call shallows r=40 deep=5 n=1 seed=742
place Creature_Stingray rays at -30 25 h=-3
prop rays creature.count=2

info title=Driftwood Key
info author=Custom Islands
info description=A low sandy key with a few palms and a fisherman's cabin built of driftwood planks - his bed, his box, his fire. No quest - an island to explore.

note cabinbox Fisherman's box | His box under the window: a tin of fish, a knife's whetstone, rope, a little water.
loot cabinbox Raw_Pomfret*2;Rope*2;PlasticBottle_Water*2;Nail*5
prop cabinbox loot.refill=0

save Driftwood Key
