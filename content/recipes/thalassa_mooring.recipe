# Thalassa Mooring - an island of the library's plan The Sunken Kingdom (sea level; chapter 5, the surface station)
# The Pelagic Network's surface station on a rock shelf: a steel deck on posts over the rock with a moonpool shaft cut
# through it down into the sea, and over the shaft a crane holding the diving bell - Varuna's scissor lift, used here the
# other way: it carries whoever stands on it 20 m straight down the shaft to a bell zone with air in it, and back up.
# A water tower on legs (the water tank plans on its top), the pump pipes, the station office (the purifier plans), the
# store shed (the large storage plans), the vending machine under a canopy on posts with four Tangaroa tokens round the
# decks, palms and grass, two reefs, buried titanium for the metal detector. Quest "The Surface Station" (11 steps).
#
# Points (metres over the sea): the rock shelf at 2 (r 14 round 0 0); the deck x -3..7.5, z -4.5..4.5, its top at 4.5;
# the shaft round 5.25 0 (r 3, its bottom at -22), the bell in the deck's hole (x 3..7.5, z -1.5..1.5) at 2.3, the bell
# zone at -17; the water tower at -8 6 (its top at 5.3); the office x -10..-7, z -3..0; the store shed x -4..0.5,
# z -12..-9; the canopy x 4.5..7.5, z -11.5..-8.5 over the vending machine.
include lib_sunken
include lib_huts
include lib_gravity
include lib_sl1
include lib_features
include lib_sea
# RESIZE 10-24: Radius 34 -> 85 (Height 6 -> 8), the island grows round the old content, which stays where it was.
new
gen Trees=0.25 Bushes=0.3 Rocks=0.4 Harvest=0.3 BeachThings=0.4
gen Seed=10501 Radius=85 Height=8 Roughness=0.35 Peaks=2 Shape=0 Style=0 BeachWidth=0.25 Cliffs=0.35 PeakShape=0.4
gen Water=0.5 SeaRocks=0.4 SeaFinds=0.4 Sunken=0.3 Hostiles=0 Friendly=0.2 SeaLife=0.3
generate

# --- Terrain: the rock shelf, the moonpool shaft ------------------------------------------------------------------------
brush flatten at 0 0 r=14 s=20 frames=240 h=2
brush flatten at 5.25 0 r=3 s=30 frames=300 h=-22
brush grass at -9 3 r=6 s=20 frames=20
brush flatten at 14 -36.4 r=5 s=8 frames=40
origin
clear at 14 -36.4 r=6
clear at 0 0 r=13

# --- The steel deck on posts, the hole over the shaft -------------------------------------------------------------------
for dx -2.25 6.75 1.5
place Block_Floor_Tier3 deck at $dx -3.75 h=4.5
place Block_Floor_Tier3 deck at $dx -2.25 h=4.5
place Block_Floor_Tier3 deck at $dx 2.25 h=4.5
place Block_Floor_Tier3 deck at $dx 3.75 h=4.5
next
for dx -2.25 2.25 1.5
place Block_Floor_Tier3 deck at $dx -0.75 h=4.5
place Block_Floor_Tier3 deck at $dx 0.75 h=4.5
next
prop deck tint.color=#5b6266
prop deck tint.amount=0.45
for px -3 3 3
place RT_Pillar - at $px -4.5 ground sy=0.76
place RT_Pillar - at $px 4.5 ground sy=0.76
next
place RT_Pillar - at 7.5 -4.5 ground sy=0.76
place RT_Pillar - at 7.5 4.5 ground sy=0.76
place RT_Pillar - at -3 0 ground sy=0.76
ramp Block_Wall_Fence_Rope from -2.25 -4.5 4.5 to 6.75 -4.5 4.5 len=1.5 top=-0.1
ramp Block_Wall_Fence_Rope from 7.5 -3.75 4.5 to 7.5 3.75 4.5 len=1.5 top=-0.1
place Block_Ladder_Tier3 - at -3.15 -0.75 ground yaw=270
place Zone_Trigger deckzone at 0 0 h=5.5
place Placeable_Table_Basic - at -1.5 2.6 h=4.5 sit yaw=0
place Note_Paper handbook at -1.5 2.6 h=5.4 drop yaw=10
place Placeable_Lantern_Metal - at -2.5 3.9 h=4.5 sit

# --- The crane and the diving bell over the shaft -----------------------------------------------------------------------
place UT_ElectricityIsland_Crane02 bellcrane at 7 3.5 h=4.5 sit scale=0.3 yaw=225
place VP_Skylift bell at 5.25 0 h=2.3
place Zone_Trigger bellzone at 5.25 0 h=-17
place Zone_Atmosphere bellbub at 5.25 0 h=-17.5
place Antenna_pole - at 3.4 1.6 h=-22 sy=0.6
place Placeable_Lantern_Metal - at 3.4 1.6 h=-18.8 sit

# --- The water tower on legs, the pipes to the deck ---------------------------------------------------------------------
place RT_Pillar - at -8.9 5.1 ground sy=1.05
place RT_Pillar - at -7.1 5.1 ground sy=1.05
place RT_Pillar - at -8.9 6.9 ground sy=1.05
place RT_Pillar - at -7.1 6.9 ground sy=1.05
place Block_Foundation towertop at -8 6 h=5.65 sx=1.25 sz=1.25
place Placeable_WaterTank - at -8.3 6.3 h=5.65 sit
place Loot_ChestSmall towerchest at -7.5 5.3 h=5.65 sit yaw=180
place Block_Ladder_Tier3 - at -8 4.85 ground sy=1.45 yaw=180
place WaterPipe_Short_1 pipes at -6 6 h=3 rot=0,0,90
place WaterPipe_Short_1 pipes at -4.5 5 h=3 rot=0,60,90
place Loot_Chest pipecrate at -4.6 6.6 ground sit yaw=270
prop pipes tint.color=#6d7f86
prop pipes tint.amount=0.4

# --- The station office (hut) and the store shed -------------------------------------------------------------------------
push at -10 -3 h=2
call hut w=2 d=2 y=0.1
place Loot_Chest officechest at 2.2 2.2 y=0.1 sit yaw=180
place Placeable_Lantern_Metal - at 0.6 2.4 y=0.1 sit
pop
push at -4 -12 h=2
call shed w=3 d=2 door=1
place Loot_Chest storeshed at 0.8 2.2 y=0.2 sit yaw=180
place "Box Small" - at 3.6 2.3 y=0.2 sit yaw=30
pop

# --- The canopy on posts, the vending machine, the tokens round the decks -----------------------------------------------
push at 4.5 -11.5 h=2
place Block_Pillar_Wood - at 0 0 y=0
place Block_Pillar_Wood - at 3 0 y=0
place Block_Pillar_Wood - at 0 3 y=0
place Block_Pillar_Wood - at 3 3 y=0
roof 2 2 at 0 0 y=0 wood
pop
vending thalvend at 6 -10 ground
place QuestItemPickup_Tangaroa_Token - at -1.5 -3.5 h=4.5
place QuestItemPickup_Tangaroa_Token - at 6.5 3.5 h=4.5
place QuestItemPickup_Tangaroa_Token - at -8 6.8 h=5.65
place QuestItemPickup_Tangaroa_Token - at -11 -6 ground

# --- Palms, grass, crops, animals, treasure, reefs, the sea -------------------------------------------------------------
place "Pickup_Landmark_Tree_Palm 2" - at -12 9 ground
place "Pickup_Landmark_Tree_Palm 1" - at -5 11 ground
place "Pickup_Landmark_Tree_Palm 3" - at 11 -6 ground
place "Pickup_Landmark_Tree_Palm 4" - at -13 -9 ground
place Pickup_Landmark_PineappleLandmark - at -11 1 ground
place Pickup_Landmark_BerryBush - at -3 9 ground
place Placeable_Cropplot_Medium - at -6 -6.5 ground sit
place Creature_Chicken hens at -7 -7 ground
prop hens creature.count=3
call treasure x=-14 z=8 r=12 n=1 seed=10051
prop treasure10051 treasure.loot=TitaniumOre*3
call hives x=-6 z=12 r=6 n=1 seed=10502
scatter VP_CoralBulb04 5 at 50 35 r=3 seed=10503 free=1
scatter VP_CoralDigitate01 5 at 50 35 r=3 seed=10504 free=1
scatter TinyCoral 6 at -50 -35 r=3 seed=10505 free=1
scatter VP_CoralFoliose01 4 at -50 -35 r=3 seed=10506 free=1
place Creature_PufferFish puffers at 55 25 h=-4
prop puffers creature.count=2
call shallows x=0 z=0 r=125 deep=5 n=1 seed=10507

# --- DISCOVERIES 10-24 (optional, no quest needs them): camp + note; BoatStranded + chest; hatch with a chest; buried treasure; viewpoint ---
place campfire_1 - at 14 -36.4 ground sit
place Balboa_DecorationPrefabBase_SimpleTent - at 17 -34.4 ground sit yaw=97
place "Box Small" - at 12 -33.9 ground sit
place Note_Paper dnote at 12 -33.9 ground y=0.7 drop yaw=20
note dnote Castaway's note | DAY 40 - OR 41\n\nThe station people never came up for me. I watch their crane from here.\nAt night a light goes down the shaft and does not come back up.\nI have fish, rain, and this pencil. That is enough for now.
place BoatStranded dvan at -14 36.4 ground yaw=217
prop dvan tint.color=#6b5a48
prop dvan tint.amount=0.5
place Loot_ChestSmall dwreckchest at -18 39.4 ground sit yaw=157
note dwreckchest Wreck's chest | A small chest from the wreck, its lid swollen shut by the salt: line, nails and scrap.
loot dwreckchest Rope*3;Nail*8;Scrap*3
prop dwreckchest loot.refill=0
call hatchcache x=-36.4 z=-14 r=4 seed=10591 alias=dhatch chest=dhatchchest items=MetalIngot*2;CopperIngot*2;Bolt*2
call treasure x=36.4 z=14 r=6 n=1 seed=10592
prop treasure10592 treasure.loot=TitaniumOre*2;CopperOre*2
place Zone_Trigger dview at -36.9 12.7 ground
prop dview zone.id=thalassa_mooring_view
prop dview zone.radius=7
prop dview zone.repeat=never
prop dview zone.message=From the high ground the station's crane is a toy over the shelf - and past it the sea turns from green to black.

# --- Areas (10-24: every story island has places all over it and its quest crosses it): the breakwater ridge in the west, the bell crew's cave in
# the south-east, the dive master's hut in the north, the divers' dinghy in the south-west (the dive log's three lost dives)
call sk_ridge x1=-74 z1=-24 x2=-64 z2=26 h=5 top=8 r=10
call sk_plants x=-69 z=1 r=16 seed=10561
call sk_zone x=-69 z=1 al=th_ridge id=th_ridge r=7 msg="The breakwater ridge. The station's bell hangs on its frame below you, and the zipline cable still runs down to the yard."
call sk_cave x=30 z=-60 h=3 yaw=180 al=th_caverock chest=th_cavechest
call sk_zone x=30 z=-65 al=th_cave id=th_cave r=4 msg="The bell crew's cave: their lockers, a bench, a cold stove."
call sk_ruin x=22 z=56 h=3 al=th_ruin
call sk_notebox x=24.5 z=51.5 yaw=10 al=th_ruinnote
call sk_wreck x=-50 z=-52 h=3 yaw=40 v=RT_PlasticBoat al=th_wreck crate=th_wreckcrate scale=1
call sk_notebox x=-44 z=-56 yaw=70 al=th_wrecknote

# --- Tools in use (10-24: a tool or item given earlier in the storyline opens extras here, never the main path)
clear from -69 3 to -46 0 r=3
place ZiplinePath_Landmark thridgezip at -69 3 ground
zipto thridgezip -46 0
call vinecache x=-30 z=-70 r=8 seed=10571 chest=thvinechest vines=thvines items=Rope*3;Nail*8;Glass*2

# --- Unique layer (10-24): the dive log's three lost dives: buried tags and sample bags for the metal detector at the
# three places the log names (east, north-east, south)
call treasure x=70 z=-6 r=6 n=1 seed=10581
call treasure x=48 z=58 r=6 n=1 seed=10582
call treasure x=-26 z=-72 r=6 n=1 seed=10583

# --- Settings, notes, behaviours, quest ---------------------------------------------------------------------------------
# the generator's rocks that floated over the slope, and walls left wholly under the ground (ground check, 2026-10-23)
clear at -29.82 -2.51 r=1.5 only=SmallBoulder

info title=Thalassa Mooring
info author=Custom Islands
info description=The Network's surface station: a steel deck over a moonpool, a crane and a diving bell that rides 20 m down, a water tower and a vending machine. The fifth island of The Sunken Kingdom.
island on.arrive=message||A crane over a steel deck - and under it, a square of black water going straight down.

note handbook Station handbook | THALASSA MOORING - HANDBOOK\n\n1. Fresh water from the tower. Pipes to the deck. Don't drink from the moonpool.\n2. The purifier plans are in the office. Keep the filters dry.\n3. The bell: stand on it, use it. It goes down to the shelf at twenty metres and comes back when used again.\n4. Tokens for the machine - the old crews hid them round the decks.\n5. Nobody goes below the shelf edge. Nobody.
note towerchest Water tower chest | A chest on top of the water tower: water tank plans.
note pipecrate Pipe crate | A crate of pipe fittings: water pipe plans.
note officechest Station office chest | The office chest: electric purifier plans and a logbook stub.
note storeshed Store shed chest | The store shed's chest: large storage plans.
loot towerchest Blueprint_WaterTank*1;Plank*4
prop towerchest loot.refill=0
loot pipecrate Blueprint_Pipe_Water*1;Scrap*3
prop pipecrate loot.refill=0
loot officechest Blueprint_ElectricPurifier*1;Bolt*2
prop officechest loot.refill=0
loot storeshed Blueprint_Storage_Large*1;Plank*6;Nail*10
prop storeshed loot.refill=0

prop deckzone zone.id=deck
prop deckzone zone.radius=5
prop deckzone zone.message=Thalassa Mooring's deck. The moonpool breathes cold air.
prop bell obj.name=bell
prop bell beh.use=Ride the diving bell
prop bell beh.move=0,-20,0
prop bell beh.moveTime=12
prop bell beh.carry=1
prop bell on.use=switch|\nmessage||The crane's winch groans. The bell sinks into the shaft.
prop bellzone zone.id=bell
prop bellzone zone.radius=4
prop bellzone zone.air=1
prop bellzone zone.repeat=1
prop bellzone zone.message=Twenty metres down. Through the shaft's mouth: a glowing shelf, lamps in a line - the shelf the handbook spoke of.
prop bellbub atmo.particles=bubbles
prop bellbub zone.radius=3
prop bellcrane obj.name=bellcrane

note th_cavechest Bell crew's locker | A bell crew locker: a dive knife's sheath, a rope, a tin of grease.
loot th_cavechest Rope*3;Bolt*2;Leather*1;Copper*2
prop th_cavechest loot.refill=0
note th_ruinnote Dive log | DIVE LOG - the dives that never came back\n\nDive 41: east of the station, off the rocks. Diver did not surface. Her sample bag is still down there, buried in the sand.\nDive 44: north-east, by the old marker. Line cut.\nDive 47: south, past the dinghy. Bell came up empty.\nWhoever has a metal detector: their tags will ring under the sand.
note th_wrecknote Dinghy logbook | DINGHY LOGBOOK\n\nTook the dinghy out for dive 47. Came back without the bell crew.\nI tied her up on the rocks and walked to the hut. I am not taking her out again.
note th_wreckcrate Dinghy stores | The dinghy's stores crate: spare line, a lamp, a tin of fuel.
loot th_wreckcrate Rope*3;Plank*3;Scrap*2;Battery*1
prop th_wreckcrate loot.refill=0

quest title=The Surface Station
quest intro=A surface station on the Receiver. Find its deck.
step reach|deck|1|Climb onto the station's deck
step read|Station handbook|1|Read the station handbook
step blueprint|Blueprint_WaterTank|1|Climb the water tower: water tank plans
step blueprint|Blueprint_Pipe_Water|1|Find the water pipe plans in the pipe crate
step blueprint|Blueprint_ElectricPurifier|1|Find the purifier plans in the station office
step blueprint|Blueprint_Storage_Large|1|Open the store shed: large storage plans
step reach|th_ridge|1|Climb the breakwater ridge in the west
step reach|th_cave|1|Find the bell crew's cave in the south-east
step read|Dive log|1|Read the dive log in the dive master's hut in the north
step read|Dinghy logbook|1|Read the logbook at the divers' dinghy in the south-west
step reach|bell|1|Ride the diving bell 20 m down the shaft
quest done=Down the shaft the shelf glows. The Receiver picks up the survey lamps on band 600.
quest reward=Rope*4;Plank*6

save Thalassa Mooring
