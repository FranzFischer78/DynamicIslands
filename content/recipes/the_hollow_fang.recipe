# The Hollow Fang - an island of the library's plan Relic of the Seventh Tide (the three trials)
# A single tall spire of rock, cleft from the south by a narrow gorge (the sea cave's way in) and hollow at its heart.
# Up the cleft run the three trials of the sea kings' guardians: the Penitent (Utopia's water-challenge wheels spinning
# at head height on posts - stoop under them), the Word (stepping stones on posts over a flooded pit: step only on the
# letters of the name, the wrong stones throw you back to the start), and the Leap (a chasm with an invisible bridge;
# a bag of sand thrown from the lion's head stone shows it). In the hollow, a glass bridge over the void to the altar.
# Quest "The Three Trials" (13 steps): the sea cave, Kett's last diary page, the three trials, the Word, the Leap, the
# bag of sand, the far side, the Syndicate's mercenaries, the altar (the Gear of the Third Tide), Orin's charge, and the
# window in the Fang that looks out to the Colossus.
#
# Built by the recipe player (CIRecipe the_hollow_fang) through the editor's own operations.
include lib_sea
include lib_features
new
# (nature: a green rock spire at Raft's density - trees and bushes on its flanks, a few rocks; one reef)
gen Trees=0.45 Bushes=0.35 Rocks=0.55 Harvest=0.3 BeachThings=0.3
gen Seed=9501 Radius=58 Height=34 Roughness=0.35 Peaks=1 Shape=0 Style=0 PeakShape=0.9 Cliffs=0.8 BeachWidth=0.5
gen Water=0.5 SeaRocks=0.5 SeaFinds=0.2 Sunken=0.3 Hostiles=0 Friendly=0.2 SeaLife=0.3
generate

# --- Terrain: the cleft at 3 m from the sea cave (south, 0 -54) to the hollow (0 8); the Word's flooded pit (z -24..-15);
# the Leap's chasm (z -10..-4); the hollow at 3 m (r~12 at 0 8) with its void (z 0..12) round the altar rock (0 15); the
# window slot out to the north ------------------------------------------------------------------------------------------
brush flatten from 0 -54 to 0 -2 r=5 s=20 frames=300 h=3
brush flatten at 0 -58 r=5 s=20 frames=60 h=1.2
brush smooth from 0 -60 to 0 -50 r=3 s=6 frames=20
brush flatten at 0 8 r=12 s=20 frames=240 h=3
brush flatten from 0 18 to 0 34 r=2.5 s=20 frames=120 h=3
brush flatten from 0 -23 to 0 -19 r=3 s=20 frames=100 h=-2
brush flatten from 0 -8 to 0 -6 r=2.5 s=20 frames=100 h=-3
brush flatten from 0 3 to 0 9 r=4 s=20 frames=120 h=-4
brush flatten at 0 15 r=3 s=20 frames=80 h=3
origin
clear from 0 -60 to 0 34 r=6
clear at 0 8 r=13

# --- The sea cave: the way in from the beach, Kett's last diary page on a rock ----------------------------------------
place Zone_Trigger seacave at 0 -50 ground
place SmallRock_02 - at 2.8 -47.5 ground sit scale=0.3
place Note_Paper diarypage at 2.8 -47.5 h=4.5 sit drop yaw=25

# --- Trial 1, the Penitent: four water-challenge wheels spinning at head height on posts; a gate of columns each end --
place Zone_Trigger trial1 at 0 -44 ground
place RT_PillarThick trialcols at -3 -42 ground
place RT_PillarThick trialcols at 3 -42 ground
place RT_PillarThick trialcols at -3 -28 ground
place RT_PillarThick trialcols at 3 -28 ground
place RT_Pillar - at -1.2 -39 ground sy=0.45
place UT_WaterChallengeWheel3 blade1 at -1.2 -39 h=4.35 scale=0.36
place RT_Pillar - at 1.2 -36 ground sy=0.45
place UT_WaterChallengeWheel3 blade2 at 1.2 -36 h=4.35 scale=0.36
place RT_Pillar - at -1.2 -33 ground sy=0.45
place UT_WaterChallengeWheel3 blade3 at -1.2 -33 h=4.35 scale=0.36
place RT_Pillar - at 1.2 -30 ground sy=0.45
place UT_WaterChallengeWheel3 blade4 at 1.2 -30 h=4.35 scale=0.36
place Zone_Trigger trial1end at 0 -27 ground
prop trialcols tint.color=#b8ab92

# --- Trial 2, the Word: twelve stones on posts over the flooded pit, three to a row; the right four spell O-R-I-N; the
# wrong ones throw the walker back to the start; the pit throws you back too; invisible walls keep the walk on the stones
# (a safe row at each end, the four lettered rows z -24 -22.4 -20.8 -19.2)
place Note_Sign wordtablet at 2.6 -27.4 ground sit yaw=180
place Zone_Trigger wordstart at 0 -27 ground
for wx -1.6 1.6 1.6
for wz -27.2 -14.4 1.6
place Block_Floor_Tier3 stones at $wx $wz h=3.05
next
for wz -24 -16 1.6
place RT_PillarThick stoneposts at $wx $wz h=-2.4 sy=0.87
next
next
place Zone_Trigger wrong1a at -1.6 -24 h=3.4
place Zone_Trigger wrong1b at 1.6 -24 h=3.4
place Zone_Trigger wrong2a at -1.6 -22.4 h=3.4
place Zone_Trigger wrong2b at 0 -22.4 h=3.4
place Zone_Trigger wrong3a at -1.6 -20.8 h=3.4
place Zone_Trigger wrong3b at 1.6 -20.8 h=3.4
place Zone_Trigger wrong4a at 0 -19.2 h=3.4
place Zone_Trigger wrong4b at 1.6 -19.2 h=3.4
place Zone_Trigger pitback at 0 -21 h=-1
for iz -24 -16 4
place Helper_Wall - at -2.6 $iz h=-2 sy=3 yaw=90
place Helper_Wall - at 2.6 $iz h=-2 sy=3 yaw=90
next
place Zone_Trigger trial2end at 0 -12.6 ground
prop stones tint.color=#a59a86
prop stoneposts tint.color=#8d8474

# --- Trial 3, the Leap: the chasm, the invisible bridge over it (an invisible ramp, flattened), the lion's head stone
# at the lip, the bag of sand in a chest, the sand trail that shows the bridge ------------------------------------------
place Note_Sign leaptablet at 2.6 -12 ground sit yaw=180
place Loot_ChestSmall sandchest at -2.6 -12 ground sit yaw=160
place TangaroaFounderStatue lionhead at 1.8 -13 ground sit scale=0.32 yaw=200
place Zone_Trigger leaplip at 0 -11.4 ground
place Helper_Wall leapbridge at 0 -11.8 h=2.85 rot=90,0,0 sy=3.2
for tz -9.75 -4.25 1.1
place Block_Floor_Tier3 sandtrail at 0 $tz h=3.02 sx=0.35 sz=0.75
next
place Zone_Trigger chasmback at 0 -7 h=-2.5
for iz -9 -5 4
place Helper_Wall - at -2.6 $iz h=-3 sy=3 yaw=90
place Helper_Wall - at 2.6 $iz h=-3 sy=3 yaw=90
next
prop sandtrail tint.color=#e2cf9a
prop lionhead tint.color=#c9b48a

# --- The hollow: the far side of the leap, the glass bridge over the void to the altar rock, the altar, Orin's charge,
# the Syndicate's mercenaries waiting; the window slot looking north to the Colossus -----------------------------------
place Zone_Trigger trial3end at 0 -2.5 ground
place UT_Set_GlassBridge glassbridge at 0 6 h=3 yaw=90 scale=0.32
place "Box Big" - at 0 15.6 ground sit
place Loot_Chest altar at 0 15.6 h=4.2 sit yaw=180
place Note_Sign orinscharge at 1.8 16 ground sit yaw=180
place Placeable_Lantern_Metal - at -1.6 16.2 ground sit
place Zone_Trigger altarzone at 0 13.6 ground
place Creature_Bear mercs at 0 17 ground
place Zone_Trigger fangtop at 0 28 ground
place Placeable_Lantern_Metal fangcam at 0 26 ground sit yaw=0

# --- Things to gather, reefs ---------------------------------------------------------------------------------------------
scatter "Pickup_Landmark_PineappleLandmark" 2 at 20 -40 r=10 seed=9521 free=3
call dirt x=-22 z=-40 r=8 n=3 seed=9522
call shallows x=18 z=-66 r=12 deep=4 n=1 seed=9523

# --- Settings, story items, notes, behaviours, quest ----------------------------------------------------------------
info title=The Hollow Fang
info author=Custom Islands
info description=A tall spire of rock, cleft by a narrow gorge and hollow at its heart: the three trials of the sea kings' guardians - spinning blades, a floor of lettered stones over a flooded pit, an invisible bridge over a chasm - and a glass bridge to the altar. The fifth island of Relic of the Seventh Tide.
island on.arrive=message||A single spire of rock like a fang. A cleft runs into it from the sea - and something glints inside.

story sand|Bag of sand|Placeable_PaperBundle|A small sack of fine white sand, for throwing.
story gear3|Gear of the Third Tide|Bolt|The biggest of the three bronze gears, its teeth cut like waves. Three of three.

note diarypage Kett's last diary page | KETT - THE FANG\n\nThe three trials are as the walls said: the Penitent, the Word, the Leap. Orin - my old teacher - came here forty years ago and never came out. I will.\n\nThe Penitent kneels: keep your head low.\nThe Word is his name.\nThe Leap is faith - but Orin always said faith is easier with a handful of sand.
note wordtablet The Word | THE WORD\n\nOnly the name of the one who guards may be walked. Four stones, one to a row.\n\nRow one: O in the middle. Row two: R on the right. Row three: I in the middle. Row four: N on the left.\n\n(Someone has scratched under it: ORIN.)
note leaptablet The Leap | THE LEAP\n\nOnly in the leap from the lion's head will he prove his worth.\n\nThe chasm is too wide to jump. The far side is just there.
note sandchest Bag of sand | A small chest by the lip. Inside: a sack of fine white sand, and on its label in Kett's hand: "Throw it from the lion's head."
loot sandchest story:sand*1;Rope*2
prop sandchest loot.refill=0
note altar Altar | The altar of the sea kings' guardians. On it: the Gear of the Third Tide - and a leather pack of Orin's, still good.
loot altar story:gear3*1;Leather*4;Rope*4;Cooked_GenericMeat*2;TradeToken*6
prop altar loot.refill=0
note orinscharge Orin's charge | ORIN'S CHARGE\n\nWhoever reads this has the three gears. Do not take them to the Engine. Take them to the giant in the strait: set them in its breast, and its eyes will show you the heart. Then decide.\n\n- Orin, keeper of the Fang

prop blade1 obj.name=blade1
prop blade1 beh.spin=70
prop blade2 obj.name=blade2
prop blade2 beh.spin=-70
prop blade3 obj.name=blade3
prop blade3 beh.spin=70
prop blade4 obj.name=blade4
prop blade4 beh.spin=-70
prop lionhead obj.name=lionhead
prop lionhead beh.use=Throw the sand from the lion's head
prop lionhead if.use=take|story:sand|1
prop lionhead on.use=message||The sand fans out over the chasm - and settles on nothing, in a thin line, all the way across. A bridge you cannot see!\nshow|sandtrail
prop lionhead else.use=message||A stone lion's head at the chasm's lip. From here the far side seems a long jump away.
prop sandtrail obj.name=sandtrail
prop sandtrail beh.hidden=1

prop seacave zone.id=sea_cave
prop seacave zone.radius=5
prop seacave zone.message=A cleft runs into the spire from the sea, carved columns at its mouth. On a rock, a page torn from a diary.
prop trial1 zone.id=trial1
prop trial1 zone.radius=3
prop trial1 zone.message=THE PENITENT. Blades turn at head height all down the cleft. Keep your head low.
prop trial1end zone.id=trial1_end
prop trial1end zone.radius=2
prop trial1end zone.message=Through the blades. Ahead, a pit of black water - and stepping stones.
prop wordstart obj.name=wordstart
prop wordstart zone.radius=1
prop trial2end zone.id=trial2_end
prop trial2end zone.radius=2
prop trial2end zone.message=The last stone holds. Ahead, the cleft simply ends in a chasm.
prop leaplip obj.name=leaplip
prop leaplip zone.radius=1
prop trial3end zone.id=trial3_end
prop trial3end zone.radius=2.5
prop trial3end zone.message=Solid rock under you again. The cleft opens into the hollow heart of the Fang.
prop altarzone zone.id=altar
prop altarzone zone.radius=3
prop altarzone zone.repeat=never
prop altarzone zone.message=Two big shapes rise from behind the altar - bears in Syndicate harness. Mercenaries' dogs of war!
prop mercs creature.count=2
prop mercs creature.respawn=0
prop mercs creature.zone=altar
prop mercs tint.color=#8a7f55
prop mercs tint.amount=0.5
prop fangtop zone.id=fang_top
prop fangtop zone.radius=3
prop fangtop zone.repeat=never
prop fangtop zone.message=A window in the Fang. Far off to the north, across the water: a giant standing in the sea.
prop fangtop on.enter=camera|fangcam||6|40
prop fangcam obj.name=fangcam

macro wrongstone a
prop $a zone.radius=0.8
prop $a zone.message=The stone tips under you - and the floor of the trial throws you back to its start!
prop $a on.enter=teleport|wordstart
end
call wrongstone wrong1a
call wrongstone wrong1b
call wrongstone wrong2a
call wrongstone wrong2b
call wrongstone wrong3a
call wrongstone wrong3b
call wrongstone wrong4a
call wrongstone wrong4b
prop wrong1a zone.id=wrong_stone
prop pitback zone.radius=5
prop pitback zone.message=Cold black water. You haul yourself out at the start of the Word.
prop pitback on.enter=teleport|wordstart
prop chasmback zone.radius=5
prop chasmback zone.message=Down into the chasm's water. You climb back up to the lip.
prop chasmback on.enter=teleport|leaplip

quest title=The Three Trials
quest intro=A cleft into a spire of rock. Kett went in. Go into the sea cave.
step reach|sea_cave|1|Go into the sea cave
step read|Kett's last diary page|1|Read Kett's last diary page
step reach|trial1|1|Come to the first trial
step reach|trial1_end|1|Pass the Penitent's blades
step read|The Word|1|Read the Word's tablet
step reach|trial2_end|1|Walk the Word's stones
step read|The Leap|1|Read the Leap's tablet
step collect|story:sand|1|Take the bag of sand
step reach|trial3_end|1|Cross the chasm
step kill|Bear|2|Fight off the Syndicate's mercenary bears
step open|Altar|1|Take what lies on the altar
step read|Orin's charge|1|Read Orin's charge
step reach|fang_top|1|Look out of the window in the Fang
quest done=The three gears. Orin's charge, and the window in the Fang, show the way: the giant in the strait - 1100 on the Receiver.
quest reward=TradeToken*6;Rope*4;Leather*3

# Buried treasure (one of the story line's last islands): titanium ore on top of Raft's own treasure loot - the metal detector finds it, the shovel digs it
call treasure x=0 z=0 r=30 n=1 seed=8807
prop treasure8807 treasure.loot=TitaniumOre*3

save The Hollow Fang
