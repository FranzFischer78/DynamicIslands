# --- AUTUMN (the west islet): bare trees, fallen logs, the orchard of mangoes, watermelons and scarecrows, the autumn sky
# (and its first frost, hidden); the barn with the harvest rhyme on its door and the autumn token's sheaf (hidden till the
# bells are rung); four harvest bells on posts by the field; hens; the boars wait in the orchard ---------------------------
push at -88.25 -2.25 h=5.05
call stilt_hut y=0.4
