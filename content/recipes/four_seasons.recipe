macro harvestbell name x z
place RT_Pillar - at $x $z ground sit sy=0.55
place TangaroaBucket $name at $x $z y=1.93 scale=1.2 rot=180,0,0
end
call harvestbell bellplough -88 -16
call harvestbell bellsow -84 -16
call harvestbell bellreap -80 -16
call harvestbell bellstore -76 -16
