# Four Seasons - a new island of the library, seven times the size (x7)
# A forested atoll cut into four islets by four channels, each islet stuck in its own season - winter on the north,
# spring on the east, summer on the south, autumn on the west - and in the lagoon the weather-house on its stone piers,
# where the year's wheel that kept them turning has stopped. Each season keeps a token behind a different kind of task.
# Quest "The Year's Wheel" (24 steps in 6 chapters): the weather-house; winter (a fight and a climb up an ice spire);
# spring (a catch); summer (a dive to a sunken bell, air under the coral); autumn (boars, then bells rung in the rhyme's
# order); the turning of the wheel.
#
# Built by the recipe player (CIRecipe four_seasons) through the editor's own operations.
include lib_huts
include lib_sea
new
# (nature: forest, Like Raft - birch and pine round the ring; each islet dressed for its season)
gen Trees=0.21 Bushes=0.38 Rocks=0.42 Harvest=0.1 BeachThings=0.3
gen Seed=9224 Radius=119 Height=14 Roughness=0.4 Peaks=4 Shape=1 Style=3 BeachWidth=0.4 Cliffs=0.2 PeakShape=0.3
gen Water=0.5 SeaRocks=0.3 SeaFinds=0.3 Sunken=0.4 Hostiles=0
generate

# --- Terrain: the four channels cut through the ring (north-east, north-west, south-east, south-west; 4 m deep); pads
# for the shepherdess's cottage (spring), the diver's hut (summer) and the barn (autumn); the reef's floor off the summer
# islet (7 m down) ---------------------------------------------------------------------------------------------------------
brush flatten from 45 55 to 75 85 r=5 s=20 frames=300 h=-4
brush flatten from -55 55 to -85 85 r=5 s=20 frames=300 h=-4
brush flatten from 40 -50 to 70 -80 r=5 s=20 frames=300 h=-4
brush flatten from -55 -50 to -85 -80 r=5 s=20 frames=300 h=-4
brush flatten at 80 7 r=5 s=20 frames=200 h=6
brush flatten at -40 -80 r=5 s=20 frames=200 h=4
brush flatten at -86 0 r=6 s=20 frames=200 h=5
brush flatten at -25 -50 r=9 s=20 frames=300 h=-7
clear at 80 7 r=7
clear at -40 -80 r=7
clear at -86 0 r=8
clear at 0 78 r=5

# --- The weather-house in the lagoon: a deck on stone piers 2 m over the water, two huts on it (Maren's almanac on its
# lectern in the west one, her locker in the east one), the year's wheel on the deck between them (its turning twin
# hidden), her chest, her last page (hidden till the wheel turns), a weather vane; the jetty south with a boat ------------
for px -6 6 12
for pz -1 11 12
place RT_GroundPillar - at $px $pz h=2 sy=4
next
next
place RT_Floor weatherdeck at 6.04 11 h=2 sx=2 sz=1.333
push at -5.5 0.5 h=2.05
call stilt_hut y=0.1 ladder=none
place Placeable_OpenBook - at 2.25 3.6 y=0.1 sit
place Note_Book almanac at 2.25 3.6 y=1.2 drop yaw=10
place Pickup_Landmark_Plastic3_Land - at 1.1 1.8 y=0.4 drop yaw=65
pop
push at 1 0.5 h=2.05
call stilt_hut y=0.1 ladder=none
place Locker - at 3.6 3.6 y=0.1 sit yaw=180
place Loot_ChestSmall keeperlocker at 1.2 3.6 y=0.1 sit yaw=180
place "Pickup_Landmark_Scrap 1_Land" - at 2.8 1.6 y=0.4 drop yaw=190
pop
place UT_WaterChallengeWheel1 wheel at 0 8.6 h=2.05 sit scale=0.35 rot=90,0,0
place UT_WaterChallengeWheel1 wheelturning at 0 8.6 h=2.05 sit scale=0.35 rot=90,0,0
place Loot_ChestLarge keeperchest at 4.2 9.6 h=2.05 sit yaw=180
place Note_Paper lastpage at -3.5 9.6 h=2.6 drop yaw=20
place Antenna_pole - at 5.4 10.4 h=2.05 sit
place RT_WindMill - at 5.4 10.4 h=8.3 scale=0.3
place Zone_Trigger wheelroom at 0 9.8 h=3.5
push at -0.75 -1 h=-3 yaw=90
call boardwalk n=5 wide=1 y=5.05
pop
place RT_PlasticBoat - at 3.5 -6 h=0.3 yaw=10
place Zone_Trigger weatherhouse at 0 -4 h=3.5

# --- WINTER (the north islet): snow drifts and snowy pines, the winter sky (and its thaw, hidden); the frost shrine at
# the landing with its verse; the ice spire, a tower of posts with ladders beside it up to a deck at its top (the winter
# token's box), the frost bear's den at its foot; a box at the landing ----------------------------------------------------
for k 0 7 1
place TP_SnowDrift01 - at {-10+22*cos(45*$k)} {92+12*sin(45*$k)} ground sit yaw={50*$k}
next
