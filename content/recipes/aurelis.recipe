prop canalbridge tint.amount=0.4
prop thronechair tint.color=#c8a040
prop thronechair tint.amount=0.6
prop crystalgate tint.color=#8a6a3a
prop crystalgate tint.amount=0.5
prop camp zone.id=camp
prop camp zone.radius=8
prop camp zone.message=The expedition's camp on the rim: tents, a compressor, a dive locker - and the lagoon below, full of white ruins.
prop watchtemple zone.id=watchtemple
prop watchtemple zone.radius=7
prop watchtemple zone.message=The watch temple on the rim's highest islet: an altar, a tablet - and the whole drowned city below you.
prop altarzone zone.id=altar
prop altarzone zone.radius=4
prop altarzone obj.name=altarzone
prop altarzone beh.hidden=1
prop altarzone zone.message=The altar of the watch temple. The crown is heavy in your hands now.
prop agora zone.id=agora
prop agora zone.radius=12
prop agora zone.message=The agora of Aurelis: a plaza of white stone, fallen statues, baskets of shells - eighteen metres down.
prop sluice zone.id=sluice
prop sluice zone.radius=6
prop sluice zone.message=A wall across the inner basin, a round bronze gate in it, and a wheel.
prop gate zone.id=gate
prop gate zone.radius=10
prop gate zone.message=The crystal gate at the tower's foot - and the guardian uncoiling from the shadow of the arch!
prop thronehall zone.id=thronehall
prop thronehall zone.radius=6
prop thronehall zone.message=The throne hall: a dome of white stone, a golden throne - and under the dome's top, a shining pocket of air.
prop thronehallair zone.id=thronehallair
prop thronehallair zone.radius=3.5
prop thronehallair zone.repeat=1
