prop templecolumns tint.amount=0.5
prop tower tint.color=#e8e2d4
prop tower tint.amount=0.5
prop risenpipe tint.color=#e8e2d4
prop risenpipe tint.amount=0.5
prop agorastatue tint.color=#4a6a5a
prop agorastatue tint.amount=0.6
prop sluicegate tint.color=#8a6a3a
prop sluicegate tint.amount=0.6
