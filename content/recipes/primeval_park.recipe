# Primeval Park - a themed island, five times the size (x5)
# Inspiration: the island theme-park-of-ancient-beasts film (a visitor centre, paddock fences, a storm that cuts the power,
#   a river ride, an aviary, a show lagoon, a great gate and the park's queen behind it) - the mood only, never named.
# Island type: Shape 6 (Crescent), Style 0 (tropical), low (Height 14: the generator's crescent at 36 m was one steep
#   ridge with no level ground for a park). A jungle crescent round a shallow bay that opens east: the arrival dock on the
#   bay's south shore, the visitor centre on a terrace at the crescent's middle, the boar paddock north of it, the show
#   lagoon dug at the bay's head, the river ride, the power house and the aviary on the south horn, the great gate across
#   the north horn's neck with the Queen's valley behind it.
# Primeval Park bred its animals big: ironback boars, the aviary's screechers, a leviathan in the show lagoon - and the
# park's crown, a giant bear the keepers called the Queen. A storm blew the park's three fuses and the staff fled on the
# last boat. Bring the power back, cross the park, open the great gate and meet the Queen.
# Quest "Welcome to Primeval Park" (20 steps, 4 chapters): arrival (4), the power (6), the aviary and the lagoon (6), the
# Queen (4) - large crop plot and recycler blueprints, titanium, batteries.
#
# Built by the recipe player (CIRecipe primeval_park) through the editor's own operations.
include lib_rt
include lib_huts
include lib_relay
include lib_sea
include lib_features
new
# (nature: a jungle a little denser than Raft's tropical islands; the park's terraces, roads and paddocks cleared)
gen Trees=0.35 Bushes=0.35 Rocks=0.43 Harvest=0.24 BeachThings=0.3
gen Seed=9021 Radius=100 Height=14 Roughness=0.35 Peaks=2 Shape=6 Style=0 BeachWidth=0.5 Cliffs=0.3 PeakShape=0.4
gen SeaFloor=0 Shelf=0.45 Seabed=0
gen Water=0.5 SeaRocks=0.5 SeaFinds=0.5 Sunken=0.4 Hostiles=0
generate

# --- Terrain: the visitor centre's terrace (7 m) cut into the crescent's middle, the maintenance shed on its west end;
# the boar paddock's field (5 m) and the keeper's pad; the river ride's channel cut from the bay into the south horn and
# its station's landing; the power house's yard (6.5 m); the aviary's hilltop (12 m); the show lagoon dug 12 m deep at
# the bay's head and the grandstand's three steps on its shore; the keeper lodge's pad in the Queen's valley ---------------
for vz -14 16 3.75
brush flatten from -30 $vz to 2 $vz r=4 s=20 frames=150 h=7
next
for vz 4 16 4
brush flatten from -37 $vz to -24 $vz r=4 s=20 frames=150 h=7
next
brush smooth from -26 -18 to 4 -18 r=4 s=10 frames=10
brush smooth from 5 -16 to 5 18 r=4 s=10 frames=10
for pz 29 45 4
brush flatten from -20 $pz to 4 $pz r=3.5 s=20 frames=60 h=5
next
brush flatten at 10.25 45.25 r=4 s=20 frames=80 h=3.5
for pass 1 2 1
brush flatten from 50 -21 to 56 -34 r=4 s=20 frames=200 h=-3
brush flatten from 56 -34 to 61 -46 r=4 s=20 frames=200 h=-3
brush flatten from 61 -46 to 60 -58 r=4 s=20 frames=200 h=-3
next
brush smooth from 50 -21 to 56 -34 r=5 s=10 frames=8
brush smooth from 56 -34 to 61 -46 r=5 s=10 frames=8
brush smooth from 61 -46 to 60 -60 r=5 s=10 frames=8
brush flatten at 61 -69.5 r=4 s=20 frames=80 h=1.8
for wz -58 -46 4
brush flatten from 32 $wz to 48 $wz r=3.5 s=20 frames=60 h=6.5
next
for az -53 -37 4
brush flatten from -10 $az to 10 $az r=4 s=20 frames=60 h=12
next
brush flatten at 24 22 r=8 s=20 frames=150 h=-12
for a 0 315 45
brush flatten at {24+9*cos($a)} {22+9*sin($a)} r=6 s=20 frames=100 h=-10
next
for a 0 340 20
brush smooth at {24+15*cos($a)} {22+15*sin($a)} r=4 s=10 frames=10
next
brush flatten from -2 12 to -2 32 r=2 s=20 frames=60 h=4
brush flatten from 1.5 12 to 1.5 32 r=2 s=20 frames=60 h=3
brush flatten from 5 12 to 5 32 r=2 s=20 frames=60 h=2
for lz 78 90 4
brush flatten from -8 $lz to 12 $lz r=4 s=20 frames=60 h=3.5
next
brush grass from -24 -14 to 2 16 r=6 s=20 frames=20
# (the generator's jungle off the park's grounds and roads)
clear from -40 -18 to 6 -18 r=16
clear from -37 10 to -24 10 r=8
clear from -22 37 to 6 37 r=10
clear at 10 45 r=5
clear from 50 -21 to 60 -62 r=6
clear at 61 -69 r=6
clear at 24 22 r=17
clear at 40 -52 r=11
clear at 0 -45 r=13
clear from -4 10 to -4 34 r=6
clear from -50 56 to 26 56 r=4
clear at 2 84 r=11
clear from 20 -24 to 40 -24 r=6
clear from 20 -22 to 2 -14 r=3
clear from -4 -8 to -4 26 r=3
clear from -4 28 to -10 52 r=3
clear from 40 -26 to 40 -50 r=3
clear from 32 -52 to 10 -48 r=3

