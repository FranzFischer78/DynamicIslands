# Sealkeeper Spire - an island of the library's plan The Sunken Kingdom (sea level; chapter 9, the choice - finale 1)
# The Network's control tower over the trench: a stone spire on a rock base, its control room on top behind lit windows,
# a cable from its winch down into the sea. A cable mast on the base with electric ziplines to two side towers on rocks
# of their own - the pump tower (west) and the door tower (east, three fuse lockers and the fuse board that lights the
# spire's windows). The dock with the Sealkeeper's orders and a Raft store; the generator; screechers nesting on the
# spire's roof; a storm over it all (fog and mist). At the cable head two levers - RESTORE and SEAL; pull one, the other
# is dead. Then the descend lever. Quest "The Choice" (24 steps in three parts: the base, the towers, the control room).
#
# Points (metres over the sea): the base (rock) at 3, r 14 round 0 0; the spire x -2.25..2.25, z -2.25..2.25 (walls
# 3..20, the control room floor at 17.52, its roof at 20.15), its door on the south side; the cable mast round -8 -6
# (deck at 12.9); the pump tower round -24 -14, the door tower round 24 -14 (their rocks at 2, decks at 9.5); the dock
# at -11 13; the cable head platform at 15 4 (on the shore, at 1.5); the generator at 6 -7.
include lib_huts
include lib_gravity
include lib_features
include lib_sea
include lib_sunken
# RESIZE 10-24: Radius 44 -> 100 (Height 7 -> 9), the island grows round the old content, which stays where it was.
new
gen Trees=0 Bushes=0.1 Rocks=0.45 Harvest=0.2 BeachThings=0.3
gen Seed=10901 Radius=100 Height=9 Roughness=0.4 Peaks=2 Shape=0 Style=0 BeachWidth=0.2 Cliffs=0.45 PeakShape=0.4
gen Water=0.5 SeaRocks=0.5 SeaFinds=0.4 Sunken=0.4 Hostiles=0 Friendly=0.2 SeaLife=0.3 Grass=0.1
generate

# --- Terrain: the base, the towers' rocks, the dock, the cable head ------------------------------------------------------
brush flatten at 0 0 r=14 s=20 frames=240 h=3
brush flatten at -24 -14 r=4.5 s=25 frames=260 h=2
brush flatten at 24 -14 r=4.5 s=25 frames=260 h=2
brush flatten at -11 13 r=5 s=25 frames=260 h=1.2
brush flatten at 15 4 r=4 s=25 frames=260 h=1.5
brush grass at -4 6 r=7 s=20 frames=20
brush flatten at 23.2 -38.6 r=5 s=8 frames=40
origin
clear at 23.2 -38.6 r=6
clear at 0 0 r=13

# --- The spire: six storeys of stone, a ladder up the inside, the control room on top ----------------------------------
push at -2.25 -2.25 h=3
for k 0 6
place Block_Wall_Tier3 spire at 2.25 0 y={$k*2.42}
place Block_Wall_Tier3 spire at 3.75 0 y={$k*2.42}
place Block_Wall_Tier3 spire at 0 0.75 y={$k*2.42} yaw=90
place Block_Wall_Tier3 spire at 0 3.75 y={$k*2.42} yaw=90
place Block_Wall_Tier3 spire at 4.5 0.75 y={$k*2.42} yaw=90
place Block_Wall_Tier3 spire at 4.5 3.75 y={$k*2.42} yaw=90
next
for k 0 5
place Block_Wall_Tier3 spire at 0.75 4.5 y={$k*2.42}
place Block_Wall_Tier3 spire at 2.25 4.5 y={$k*2.42}
place Block_Wall_Tier3 spire at 3.75 4.5 y={$k*2.42}
place Block_Wall_Tier3 spire at 0 2.25 y={$k*2.42} yaw=90
place Block_Wall_Tier3 spire at 4.5 2.25 y={$k*2.42} yaw=90
place Block_Ladder_Tier3 - at 0.75 4.3 y={$k*2.42} yaw=180
next
place Block_Wall_Door_Tier3 spire at 0.75 0 y=0
for k 1 6
place Block_Wall_Tier3 spire at 0.75 0 y={$k*2.42}
next
place Block_Wall_Window_Tier3 spire at 0.75 4.5 y=14.52
place Block_Wall_Window_Tier3 spire at 2.25 4.5 y=14.52
place Block_Wall_Window_Tier3 spire at 3.75 4.5 y=14.52
place Block_Wall_Window_Tier3 spire at 0 2.25 y=14.52 yaw=90
place Block_Wall_Window_Tier3 spire at 4.5 2.25 y=14.52 yaw=90
for fx 0.75 3.75 1.5
place Block_Floor_Tier3 spire at $fx 0.75 y=14.52
place Block_Floor_Tier3 spire at $fx 2.25 y=14.52
place Block_Floor_Tier3 spire at $fx 3.75 y=17.155
place Block_Floor_Tier3 spire at $fx 0.75 y=17.155
place Block_Floor_Tier3 spire at $fx 2.25 y=17.155
next
place Block_Floor_Tier3 spire at 2.25 3.75 y=14.52
place Block_Floor_Tier3 spire at 3.75 3.75 y=14.52
place Placeable_Table_Basic - at 2.6 2.0 y=14.52 sit yaw=0
place Note_Paper inesmessage at 2.6 2.0 y=15.8 drop yaw=15
place Note_Board networkmap at 4.4 1.2 y=15.5 yaw=270
place RT_PowerBox controlpad at 0.15 1.2 y=15.9 yaw=90
place RT_Pillar - at 3.6 0.6 y=14.52 sy=0.6
place TP_Selene_DoorCrankWheel winch at 3.6 0.51 y=15.72
place Placeable_Lantern_Metal spirelights at 1.5 3.9 y=14.52 sit
place Placeable_Lantern_Metal spirelights at 3.4 3.9 y=14.52 sit
place Placeable_BirdsNest nest at 1.5 1.5 y=17.155 sit
pop
