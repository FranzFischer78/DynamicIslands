# Firedance Isle - a new medium island of the library (ROADMAP 3d NI7), no quest
# A dark volcanic island where a tribe once lived: four thatched huts round a dancing ground with a fire pit in the middle,
# a drum-fire and a woodpile, and up on the hill behind the village their holy place - three tall wooden idols in a half
# ring, fire baskets burning between them, and an offering chest on a flat altar stone. Grass round the village, black
# rock on the hill, sand on the beaches. A cave in the south-east rock. Boars root in the bush - a monster island.
#
# Built by the recipe player (CIRecipe firedance_isle). Points: the village ground (3 m, r 14 round -12 -12), the fire pit
# at -12 -12; the huts (4.5 x 3 m, door in the middle of the front, all doors facing the fire): north of it x -23..-18.5
# z -6..-3 and x -9..-4.5 z -5..-2 (doors south), south of it x -23..-18.5 z -21..-18 and x -14.25..-9.75 z -23..-20
# (turned 180, doors north); the shrine (11 m, r 9 round 12 12), the idols at 12 18, 6.5 15 and 17.5 15, the altar stone
# at 12 12, the offering chest before it at 12 10.4; the path from the village up the hill in two steps (-1.5 -0.5, 2 2.5); the cave rock round 22 -24,
# its floor 2 m, its mouth north at 21 -8.
include lib_huts
include lib_sea
include lib_features
include lib_ni34
include lib_ni7a
new
# (nature: volcanic - black rock and dark sand, palms and bush on the low ground)
gen Trees=0.80 Bushes=0.95 Rocks=0.75 Harvest=0.52 BeachThings=0.60
gen Seed=7702 Radius=50 Height=11 Roughness=0.4 Peaks=1 Shape=0 Style=4 BeachWidth=0.5 Cliffs=0.35 PeakShape=0.45
gen SeaFloor=0 Shelf=0.5 Seabed=2
gen Water=0.5 SeaRocks=0.45 SeaFinds=0.3 Sunken=0.3 Hostiles=0 Friendly=0.2 SeaLife=0.2
generate

# ===== Terrain: the village ground (grass), the shrine hill (rock), the path, the cave rock, the beaches (sand) ==========
brush flatten at -12 -12 r=17 s=20 frames=100 h=3
brush grass at -12 -12 r=14 s=20 frames=25
brush flatten at 12 12 r=9 s=20 frames=120 h=11
brush rock at 12 12 r=13 s=8 frames=20
brush flatten at -1.5 -0.5 r=3.5 s=20 frames=60 h=5
brush flatten at 2 2.5 r=3.5 s=20 frames=60 h=7.4
brush smooth from -4 -3 to 7 7 r=4 s=10 frames=80
brush grass from -4 -2 to 6 6 r=3 s=20 frames=15
brush flatten at 22 -24 r=13 s=20 frames=100 h=1.6
brush flatten from 21 -6 to 21 -20 r=4.5 s=20 frames=60 h=2
brush sand from -30 -36 to 0 -44 r=7 s=20 frames=20
brush sand from -42 0 to -44 20 r=6 s=20 frames=20
clear at -12 -12 r=15
clear at 12 12 r=10
clear from -4 -2 to 6 6 r=3
clear at 22 -24 r=17
clear from 21 -8 to 21 -2 r=4

# ===== The village: four thatched huts round the dancing ground; the fire pit, the drum-fire, wood, a hut's goods ========
push at -18.5 -18 h=3 yaw=180
call thatchhut w=3 d=2 al=hut1
place Bed_Simple - at 3.6 2.2 y=0.1 sit yaw=90
pop
push at -9.75 -20 h=3 yaw=180
call thatchhut w=3 d=2 al=hut2
place "Box Small" hutbox at 1 2.2 y=0.1 sit yaw=15
pop
push at -23 -6 h=3
call thatchhut w=3 d=2 al=hut3
pop
push at -9 -5 h=3
call thatchhut w=3 d=2 al=hut4
place Loot_ChestSmall chiefchest at 1 2.2 y=0.1 sit yaw=180
pop
place campfire_1 firepit at -12 -12 ground sit
for st 0 5 1
place SmallBoulder3 - at {-12+2.2*cos(60*$st)} {-12+2.2*sin(60*$st)} y=-0.25 sit scale=0.22 yaw={47*$st}
next
place Placeable_Lantern_FireBasket - at -6 -15 ground sit
place Placeable_Lantern_FireBasket - at -18 -10 ground sit
for fw 0 4 1
place Firewood_1 - at {-25.5+0.6*$fw} -13 ground sit yaw={30*$fw}
next
place Reef_Barrel4 - at -25 -16 ground sit
place FishingNets_02 - at -22 -32 ground sit yaw=10
place RT_PlasticBoat - at -14 -40 ground sit yaw=190 roll=7

# ===== The holy place on the hill: three idols in a half ring facing the village, fire baskets, the altar and its chest ==
call idol x=12 z=18 yaw=0 size=2.4 al=idols
call idol x=6.5 z=15 yaw=-30 size=2.1 al=idols
call idol x=17.5 z=15 yaw=30 size=2.1 al=idols
place SmallBoulder3 altar at 12 12 y=-0.2 sit sx=0.5 sy=0.22 sz=0.4
place Loot_ChestSmall offerings at 12 10.4 ground sit yaw=180
place Bird_Nest - at 9 7.5 ground sit yaw=70
scatter "Pickup_Landmark_Flower_White" 4 at 12 12 r=7 seed=7731 free=2

# ===== The cave in the south-east rock, a chest inside =================================================================
place BalboaCave_Bear southcave at 22 -24 h=6.55
place Loot_ChestSmall cavechest at 19.5 -19 h=2.05 sit yaw=60

# ===== Boars in the bush; things to gather: palms, mangoes, berries, hives, dirt, a treasure; the shallows; turtles =====
place Creature_Boar boars at -20 20 ground
prop boars creature.count=2
place Creature_Boar boars2 at 28 4 ground
scatter "Pickup_Landmark_Tree_Palm 1" 4 at 0 0 r=40 seed=7741 free=6
scatter "Pickup_Landmark_Tree_Mango" 2 at -16 10 r=30 seed=7742 free=6
scatter "Pickup_Landmark_BerryBush" 4 at 0 0 r=38 seed=7743 free=3
call hives x=0 z=10 r=30 n=2 seed=7744
call dirt x=-12 z=-12 r=22 n=3 seed=7745
call treasure x=0 z=0 r=30 n=1 seed=7712
call shallows r=74 deep=5 n=2 seed=772
place Creature_Turtle turtles at -40 -40 h=-2
prop turtles creature.count=2

info title=Firedance Isle
info author=Custom Islands
info description=A dark volcanic island where a tribe once lived - four thatched huts round a dancing ground and its fire pit, and up on the hill their holy place: three tall idols, fire baskets and an offering stone. A cave in the south-east rock. Boars in the bush. No quest - an island to explore.

note hutbox Box in the hut | Woven grass, mended many times. Inside, what a family kept.
loot hutbox Rope*2;Leather*2;Feather*4;Seed_Mango*2
prop hutbox loot.refill=0
note chiefchest Chest in the big hut | Carved with the same faces as the idols on the hill.
loot chiefchest CopperIngot*2;Rope*3;Leather*2;Glass*2
prop chiefchest loot.refill=0
note offerings Offerings on the altar | Shells, metal, things washed up from the sea - laid before the idols and never taken back.
loot offerings MetalIngot*2;CopperIngot*2;TradeToken*2;Feather*3
prop offerings loot.refill=0
note cavechest Chest in the south cave | Somebody's hoard, kept away from the village.
loot cavechest Scrap*4;Nail*12;Bolt*2;Plank*6
prop cavechest loot.refill=0

save Firedance Isle
