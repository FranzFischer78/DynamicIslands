# Saga Drift - the seventh island of the library's plan The Frozen Horizon (storyline SL12, chapter 7: The Floating City)
# Nine old whaling ships lashed hull to hull and frozen into one sheet of sea ice, plank streets laid across the ice
# between them; round the hulls the city's own buildings: the flensing yard turned smelter yard, the council cabin with
# its planter boxes, the rendering house, the ship's chapel on the north shore and the anchor winch at the flagship's
# bow. Rats and screechers own it now; fog off the ice. Quest "The Floating City" (10 steps): the gangway, the city
# charter, three screechers, the electric smelter's plans (the smelter yard), the council minutes ("the comms off, on
# the Coldhold's order"), four rats (in the rendering house), the advanced biofuel extractor's plans, the chapel
# strongbox (its keypad wants the year the charter was signed), the advanced anchor's plans (the winch), the last sermon.
#
# Built by the recipe player (CIRecipe saga_drift) through the editor's own operations. Points (metres over the sea):
# the ice at 0.6 (r 38 round 0 0); the nine hulls in three rows (x -12, 0, 12; z -22, 0, 22; each 7 x 16 m, along z);
# the streets: z -11 and z 11 across, x -6 and x 6 along; the gangway from 0 -46 to 0 -34; the smelter yard x 21..27,
# z -9..-3; the council cabin x -28..-23.5, z -16..-13; the rendering house x -28..-23.5, z 12..15; the chapel x -3..3,
# z 33..37.5; the anchor winch at 12 33.
# (Adapted: Raft's stranded boat has no deck to build on, so the city's houses stand on the ice round the hulls; the
# titanium treasure is on the north-west spit at -30 26, clear of the hulls.)
include lib_sea
include lib_huts
include lib_features
include lib_frozen
include lib_verdance
# RESIZE 10-24: Radius 48 -> 90 (Height 2 -> 3), the island grows round the old content, which stays where it was.
new
gen Trees=0 Bushes=0 Rocks=0.15 Harvest=0.05 BeachThings=0.25
gen Seed=12701 Radius=90 Height=3 Roughness=0.25 Peaks=2 Shape=0 Style=1 BeachWidth=0.4 Cliffs=0.05 PeakShape=0.3
gen Water=0.5 SeaRocks=0.25 SeaFinds=0.35 Sunken=0.3 Hostiles=0 Friendly=0 SeaLife=0.4
generate

# --- Terrain: one sheet of sea ice at 0.6 m ----------------------------------------------------------------------------
brush flatten at 0 0 r=38 s=20 frames=400 h=0.6
brush flatten from 0 -34 to 0 -46 r=2.5 s=20 frames=80 h=0.2
# RESIZE 10-24 retest: the bigger island stands higher here - the huts' pads flattened again
brush flatten at 0 35.25 r=6 s=20 frames=200 h=0.6
brush flatten at -25.75 -14.5 r=5 s=20 frames=200 h=0.6
brush flatten at -25.75 13.5 r=5 s=20 frames=200 h=0.6
brush flatten at 26.4 32.6 r=5 s=8 frames=40
origin
clear at 26.4 32.6 r=6
clear at 0 0 r=38
clear from 0 -34 to 0 -46 r=3

# --- The nine hulls, frozen in ------------------------------------------------------------------------------------------
place BoatStranded hulls at -12 -22 h=3.6 yaw=3 roll=-4
place BoatStranded hulls at 0 -22 h=3.4 yaw=178 roll=3
place BoatStranded hulls at 12 -22 h=3.7 yaw=-4 roll=5
place BoatStranded hulls at -12 0 h=3.5 yaw=182 roll=2
place BoatStranded flagship at 0 0 h=3.9 yaw=0
place BoatStranded hulls at 12 0 h=3.4 yaw=176 roll=-3
place BoatStranded hulls at -12 22 h=3.6 yaw=-2 roll=4
place BoatStranded hulls at 0 22 h=3.5 yaw=181 roll=-5
place BoatStranded hulls at 12 22 h=3.8 yaw=4 roll=2
prop hulls tint.color=#6a5a4a
prop hulls tint.amount=0.35

# --- The plank streets across the ice, the lashings between the hulls ---------------------------------------------------
line Block_Floor_Wood from -24 -11 to 24 -11 step=1.5 follow
line Block_Floor_Wood from -24 11 to 24 11 step=1.5 follow
line Block_Floor_Wood from -6 -30 to -6 30 step=1.5 follow
line Block_Floor_Wood from 6 -30 to 6 30 step=1.5 follow
for lz -26 26 13
place Beam_Long_01 - at -6 $lz ground y=0.2 yaw=90
place Beam_Long_01 - at 6 $lz ground y=0.2 yaw=90
next

# --- The gangway: the plank way up from the water, the city charter on its board ---------------------------------------
line Block_Floor_Wood from 0 -46 to 0 -33 step=1.5 follow
place Zone_Trigger gangzone at 0 -34 ground y=1
place Note_Sign charter at 2 -35 ground sit yaw=200
place TP_Moontown_SealedCrate01 - at -3 -36 ground sit yaw=15

# --- The smelter yard (the old flensing deck): the electric smelter's plans ---------------------------------------------
push at 21 -9 h=0.6
call floors w=4 d=4 y=0.1
place Placeable_CookingStand_Smelter - at 1.5 4.5 y=0.1 sit yaw=180
place Placeable_CookingStand_Smelter_Electric - at 3.5 4.6 y=0.1 sit yaw=180
place Loot_ChestLarge flensechest at 5 1.2 y=0.1 sit yaw=270
place Beam_Long_01 - at 3 0.2 y=0.1
pop
place Zone_Trigger yardzone at 24 -6 ground y=1
scatter "Pickup_Landmark_Scrap 1_OceanBottom" 2 at 48.75 -26.25 r=3 seed=12711 free=1

# --- The council cabin and its planter boxes ---------------------------------------------------------------------------
push at -28 -16 h=0.6
call hut w=3 d=2 y=0.1
place Placeable_Table_Basic - at 2.2 1.6 y=0.1 sit
place Note_Book minutes at 2.2 1.6 y=1 drop yaw=20
place Loot_Chest councilchest at 0.9 2.4 y=0.1 sit yaw=180
pop
place Zone_Trigger councilzone at -25.75 -18 ground y=1
place Placeable_Cropplot_Small - at -21 -16 ground sit
place Placeable_Cropplot_Small - at -21 -14 ground sit
place Placeable_Cropplot_Small - at -19 -16 ground sit
place Placeable_Cropplot_Small - at -19 -14 ground sit

# --- The rendering house: the advanced biofuel extractor's plans, rats among the oil casks -------------------------------
push at -28 12 h=0.6
call hut w=3 d=2 y=0.1
place Loot_ChestLarge renderchest at 3.6 2.2 y=0.1 sit yaw=180
place Reef_Barrel2 - at 0.9 2.2 y=0.1 sit
place Reef_Barrel2 - at 1.9 2.3 y=0.1 sit
pop
place Creature_Rat rats at -25.5 13.5 ground y=0.4

# --- The chapel on the north shore: benches, candles, the strongbox and its keypad, the last sermon ---------------------
push at -3 33 h=0.6
call hut w=4 d=3 y=0.1
place Bench_01 - at 1.5 1.5 y=0.1 sit yaw=180
place Bench_01 - at 4.5 1.5 y=0.1 sit yaw=180
place Placeable_Candlestick - at 3 4 y=0.1 sit
place Loot_Chest chapelbox at 1 4 y=0.1 sit yaw=180
place RT_PowerBox chapelpad at 0.2 3 y=1.2 yaw=90
place Note_Paper sermon at 4.6 3.8 y=0.1 drop yaw=170
pop

# --- The anchor winch at the flagship's bow ----------------------------------------------------------------------------
# REDO 10-24: the winch was frozen by order - the city's "all hands" is three bells, one on each of three hulls
place Placeable_Anchor_Stationary - at 12 33 ground sit yaw=180
call crank x=9.8 z=32.2 yaw=180 alias=anchorwinch
place TangaroaBucket bell1 at -12 -22 h=10 drop rot=180,0,0 scale=1.3
place TangaroaBucket bell2 at 12 0 h=10 drop rot=180,0,0 scale=1.3
place TangaroaBucket bell3 at -12 22 h=10 drop rot=180,0,0 scale=1.3
place Loot_Chest anchorchest at 14 32 ground sit yaw=200

# --- Screechers on the hulls, the titanium treasure, the sea: reefs, puffers, fog ----------------------------------------
place Creature_StoneBird screechers at 0 -10 h=14
call treasure x=-30 z=26 r=15 n=1 seed=12051
place Creature_PufferFish puffers at 56.25 -67.5 h=-2
scatter VP_CoralDigitate01 4 at 56.25 -67.5 r=4 seed=12721 wet free=1
scatter VP_CoralBulb04 3 at 56.25 -67.5 r=4 seed=12722 wet free=1
scatter SeaVine3_klump 4 at -67.5 56.25 r=5 seed=12723 wet free=1
scatter VP_CoralDigitate01 3 at -67.5 56.25 r=4 seed=12724 wet free=1
scatter Pickup_Landmark_GiantClam 2 at 30 -36 r=6 wet seed=12725
call shallows x=0 z=0 r=90 deep=5 n=1 seed=12730
call snowfall x=0 z=0 r=46 al=snow fog=#c0c8cc fa=0.5

# --- DISCOVERIES 10-24 (optional, no quest needs them): camp + note; TP_SnowVehicle02 + chest; hatch with a chest; buried treasure; viewpoint ---
place campfire_1 - at 26.4 32.6 ground sit
place Balboa_DecorationPrefabBase_SimpleTent - at 29.4 34.6 ground sit yaw=137
place "Box Small" - at 24.4 35.1 ground sit
place Note_Paper dnote at 24.4 35.1 ground y=0.7 drop yaw=20
note dnote Sealer's note | Poor hunting. The seals left when the warm water came up.\nLeft the spare furs and the tea in the box.\nIf you are cold, the fire pit still takes driftwood.
place TP_SnowVehicle02 dvan at -26.4 -32.6 ground yaw=257
prop dvan tint.color=#7a8a96
prop dvan tint.amount=0.5
place Loot_ChestSmall dwreckchest at -30.4 -29.6 ground sit yaw=197
note dwreckchest Driver's box | The driver's box under the seat: bolts, glass and a scrap of leather.
loot dwreckchest Bolt*2;Glass*2;Leather*2
prop dwreckchest loot.refill=0
call hatchcache x=-15 z=-12 r=8 seed=12791 alias=dhatch chest=dhatchchest items=MetalIngot*2;Wool*3;Bolt*2
call vinecache x=-12 z=15 r=15 seed=12793 chest=dvinechest vines=dvines items=Rope*3;Wool*2;Bolt*3
call treasure x=-39.7 z=13.7 r=15 n=1 seed=12792
prop treasure12792 treasure.loot=TitaniumOre*2;MetalOre*2
place Zone_Trigger dview at -15.1 39.2 ground
prop dview zone.id=saga_drift_view
prop dview zone.radius=7
prop dview zone.repeat=never
prop dview zone.message=Nine old ships frozen into one sheet of ice, their masts like a winter forest.

# --- Settings, story item, notes, behaviours, quest ----------------------------------------------------------------------
info title=Saga Drift
info author=Custom Islands
info description=Nine old whaling ships lashed hull to hull and frozen into the ice: a city with plank streets, a smelter yard, a council cabin, a chapel - and no one in it but rats and screechers. The seventh island of The Frozen Horizon.
island on.arrive=message||Nine masts in the fog, and not a light among them. The best radio on the white sea - silent.

story chapelcode|The chapel's code|Placeable_Lantern_Metal|You typed the charter's year into the chapel strongbox's keypad.

note charter City charter | SAGA DRIFT - CITY CHARTER\n\nNine keels, one city. Signed on the ice in the year 1909, when the last ship was lashed.\nNo ship leaves alone. No light goes out alone. The radio belongs to all.\n\n(the chapel keeps the city's strongbox; its lock is set to the year of this charter)
note minutes Council cabin minutes | COUNCIL OF SAGA DRIFT - MINUTES\n\nItem 1: the order from the Coldhold, by runner over the ice: all comms off, "for the vault's sake".\nCarried, five to four. The radio was shut down the same night.\nItem 2: the Whale to be told nothing. Not carried. The Whale was sent north on our band - on the Coldhold's order.\nItem 3: the rendering house is full of rats again.
note sermon Last sermon | (the chaplain's last sermon, on the lectern)\n\nWe were nine ships because no ship can live alone up here.\nNow the vault asks us to be silent for its sake. A seed bank under the glacier, they say, for when the world is green again.\nI say a city that stops talking is already dead.\nThe glacier is on 1000. Go and see what they are keeping.
note flensechest Smelter yard chest | The smelter yard's chest: the electric smelter's plans, "for the day the generator runs".
note councilchest Council chest | The council's chest: beets from the planter boxes, the city's seal.
note renderchest Rendering house chest | The rendering house's big chest: the advanced biofuel extractor's plans, oil-stained.
note chapelbox Chapel strongbox | The chapel strongbox: the city's treasury in tokens, the chaplain's prayer book.
note anchorchest Winch locker | The anchor winch's locker: the advanced anchor's plans - the one that held nine ships in a gale.
loot flensechest Blueprint_SmelterElectric*1;MetalIngot*2;Scrap*3
prop flensechest loot.refill=0
loot councilchest Raw_Beet*4;Plank*6;Rope*2
prop councilchest loot.refill=0
loot renderchest Blueprint_BiofuelExtractorAdvanced*1;Leather*2;Bolt*2
prop renderchest loot.refill=0
loot chapelbox TradeToken*6;MetalIngot*2;Raw_Beet*2
prop chapelbox loot.refill=0
loot anchorchest Blueprint_AnchorStationaryAdvanced*1;MetalIngot*2;Rope*4
prop anchorchest obj.name=anchorchest
prop anchorchest beh.hidden=1
prop bell1 obj.name=bell1
prop bell1 beh.use=Ring the south-west ship's bell
prop bell1 if.use=!signal|bell1
prop bell1 on.use=signal||bell1\ngive||story:bellrung*1\nsound||event:/exploring/obstacles/keypad/keypad_correct\nmessage||The bell clangs over the ice. Far off, something creaks on the flagship's bow.
prop bell2 obj.name=bell2
prop bell2 beh.use=Ring the middle ship's bell
prop bell2 if.use=!signal|bell2
prop bell2 on.use=signal||bell2\ngive||story:bellrung*1\nsound||event:/exploring/obstacles/keypad/keypad_correct\nmessage||A second bell. The ice round the anchor cracks.
prop bell3 obj.name=bell3
prop bell3 beh.use=Ring the north-west ship's bell
prop bell3 if.use=!signal|bell3
prop bell3 on.use=signal||bell3\ngive||story:bellrung*1\nsound||event:/exploring/obstacles/keypad/keypad_correct\nmessage||The third bell - the city's old 'all hands'. The winch is ready to turn.
story bellrung|A ship's bell rung|Placeable_Lantern_Metal|One of the three bells of the city's "all hands".
story winchfree|The anchor winch freed|Placeable_Lantern_Metal|The flagship's winch turns again.
prop anchorwinch obj.name=anchorwinch
prop anchorwinch beh.use=Turn the anchor winch
prop anchorwinch if.use=take|story:bellrung|3
prop anchorwinch on.use=give||story:winchfree*1\nshow|anchorchest\nmessage||The chain groans and comes up a link at a time. The winch locker under it is free.
prop anchorwinch else.use=message||Frozen by order: "THE WINCH TURNS ON ALL HANDS ONLY." Three bells call all hands - one on each of three hulls.
prop dhatchchest if.open=wears|HeadLight*
prop dhatchchest else.open=message||A ship's hold under the hatch, pitch black - wear a headlight.
prop anchorchest loot.refill=0
prop treasure12051 treasure.loot=TitaniumOre*3

prop gangzone zone.id=gangway
prop gangzone zone.radius=4
prop gangzone zone.message=The gangway. Overhead, on the masts, something shrieks.
prop yardzone zone.id=smelter_yard
prop yardzone zone.radius=4
prop yardzone zone.message=The smelter yard - once the flensing deck. Cold furnaces.
prop councilzone zone.id=council
prop councilzone zone.radius=4
prop councilzone zone.message=The council cabin. Something scuttles in the rendering house across the ice.
prop screechers creature.count=3
prop screechers creature.respawn=0
prop screechers creature.zone=gangway
prop rats creature.count=4
prop rats creature.respawn=0
prop rats creature.zone=council
prop puffers creature.count=3

prop chapelpad obj.name=chapelpad
prop chapelpad beh.use=Type the strongbox's code
prop chapelpad lock.code=1909
prop chapelpad on.use=sound||event:/exploring/obstacles/keypad/keypad_correct\nmessage||The keypad beeps and the strongbox's bolt slides back.\nsignal||chapelcode\ngive||story:chapelcode*1
prop chapelpad else.use=message||The strongbox wants the year the city was founded. The charter by the gangway says it.
prop chapelbox obj.name=chapelbox
prop chapelbox if.open=signal|chapelcode
prop chapelbox else.open=message||The strongbox is locked. The keypad beside it wants a year.

quest title=The Floating City
quest intro=Nine ships frozen into one city - and silent. Climb the gangway.
step reach|gangway|1|Climb the gangway onto the ice
step read|City charter|1|Read the city charter by the gangway
step kill|Screecher|3|Drive off the three screechers nesting on the masts
step blueprint|Blueprint_SmelterElectric|1|Take the electric smelter's plans from the smelter yard
step read|Council cabin minutes|1|Read the council cabin minutes
step kill|Rat|4|Clear the four rats out of the rendering house
step blueprint|Blueprint_BiofuelExtractorAdvanced|1|Take the advanced biofuel extractor's plans from the rendering house
step open|Chapel strongbox|1|Open the chapel strongbox (the charter knows its year)
step collect|story:bellrung|3|Ring the three ships' bells - "all hands"
step collect|story:winchfree|1|Turn the anchor winch at the flagship's bow
step blueprint|Blueprint_AnchorStationaryAdvanced|1|Take the advanced anchor's plans from the winch locker
step read|Last sermon|1|Read the chaplain's last sermon
quest done=The vault ordered the silence. The glacier calls on 1000.
quest reward=MetalIngot*3;Rope*4;Raw_Beet*3

save Saga Drift
