# Kit check (not content): Selene's ladder shaft (bottom and top pieces stacked) and a room off its foot
include lib_selene
new
gen Seed=1 Radius=60 Height=4 Shape=4 Roughness=0.1 ObjectDensity=0 Trees=0 Bushes=0 Rocks=0 BeachThings=0 Harvest=0
gen Hostiles=0 Friendly=0 SeaLife=0 Water=0 SeaRocks=0 SeaFinds=0 Sunken=0
generate
brush flatten at 0 0 r=60 s=20 frames=80
push at 0 0 y=0.3
place TP_Selene_Int_Tunnel_Ladder_Bot shaftbot at 0 0
place TP_Selene_Int_Tunnel_Ladder_Top shafttop at 0 0 y=8.82
call selene_cell 0 -6 n=TP_Selene_Int_Room_Entrance
pop
