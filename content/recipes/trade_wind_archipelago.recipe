# The Trade Wind Archipelago - a new island of the library, twenty times the size (x20)
# Palm islands scattered over one vast turquoise reef, three little harbour towns among them, and the course of the Trade
# Wind Regatta laid out in buoys round the whole archipelago - sailed in your own raft. A storm scattered the fleet the day
# before the start; the committee boat is still anchored off Port Alize, the start cannon still loaded, the trophy in the
# clubhouse on the hill.
# Quest "The Trade Wind Regatta" (30 steps in 5 chapters): the start at Port Alize (the notice, the register, a dive for
# the first pennant, the start cannon), the windward leg (three buoys, Windward Cay's fish market and its rats), the reef
# leg (the passage, the sunken leader's wreck and her flag), Leeward Key (the goatherd's goats), the run home (two buoys,
# the finish, the entry, the clubhouse's bell tower, the trophy).
#
# Built by the recipe player (CIRecipe trade_wind_archipelago) through the editor's own operations.
include lib_rt
include lib_huts
include lib_relay
include lib_sea
new
# (nature: tropical, Like Raft - palms on the islands; a living reef (Seabed reef))
gen Trees=0.28 Bushes=0.28 Rocks=0.43 Harvest=0.24 BeachThings=0.3
gen Seed=9227 Radius=200 Height=12 Roughness=0.4 Peaks=6 Shape=2 Style=0 BeachWidth=0.7 Cliffs=0.1 PeakShape=0.3 Bays=0.3
gen SeaFloor=0 Shelf=0.5 Seabed=2
gen Water=0.5 SeaRocks=0.3 SeaFinds=0.3 Sunken=0.4 Hostiles=0 Friendly=0 SeaLife=0
generate

# ===== THE LAND ===========================================================================================================
# The archipelago (the map, seed 9227): the main island in the middle-west (x -90..10, z 10..110, its hill 12 m at -40 60)
# with Port Alize on its south shore; Windward Cay in the north-east (x 90..150, z 110..170); the south-east island
# (x 70..150, z -10..-90); the south island (x -110..-30, z -70..-150); Leeward Key in the west (x -150..-100, z -10..-60).
# THE COURSE (clockwise, ~1 km): the committee boat off Port Alize (-40 -22) -> buoy one (15 25) -> buoy two (50 90) ->
# buoy three off Windward Cay (75 145) -> the reef passage far east, buoy four at its mouth (155 75) and five at its end
# (155 25) -> buoy six, the leader's wreck (25 -115) -> buoy seven north of Leeward Key (-150 20) -> buoy eight (-88 -2)
# -> the finish at the committee boat.

# --- Terrain: Port Alize's town at 2 m and its quay at 1 m, the harbour dug to 6 m; the committee boat's anchorage; the
# road up to the clubhouse (a slanting ramp in two legs) and the hilltop cut level at 11 m ----------------------------------
brush flatten from -64 24 to -26 24 r=9 s=20 frames=300 h=2
brush flatten from -60 13 to -30 13 r=3.5 s=20 frames=200 h=2
brush flatten at -45 1 r=7 s=20 frames=300 h=-6
brush flatten at -40 -22 r=10 s=20 frames=300 h=-6
for i 0 10 1
brush flatten at {-30+1.2*$i} {32+1.2*$i} r=3 s=20 frames=150 h={2+0.45*$i}
next
for i 0 10 1
brush flatten at {-18-1.2*$i} {44+1.2*$i} r=3 s=20 frames=150 h={6.5+0.45*$i}
next
brush flatten at -38 60 r=10 s=20 frames=300 h=11
# (Windward Cay: the sea floor under the stilt town 2 m down, the shore and the fish market's ground at 2 m)
brush flatten from 70 139 to 84 139 r=9 s=20 frames=300 h=-2
brush flatten from 100 130 to 100 150 r=8 s=20 frames=300 h=2
brush flatten at 110 140 r=9 s=20 frames=300 h=2
# (Leeward Key: the landing at 1.5 m, a ramp up to the goat pen's ground at 5 m, two hut plots at 4 m)
brush flatten at -104 -35 r=5 s=20 frames=200 h=1.5
for i 0 6 1
brush flatten at {-104-1.5*$i} -35 r=2.5 s=20 frames=150 h={1.5+0.58*$i}
next
brush flatten at -121 -35 r=7 s=20 frames=300 h=5
brush flatten at -110.75 -42.75 r=4 s=20 frames=200 h=4
brush flatten at -110.75 -24.75 r=4 s=20 frames=200 h=4
# (the wreck's bed on the reef, 8 m down)
brush flatten at 25 -115 r=12 s=20 frames=300 h=-8
brush sand from -60 13 to -30 13 r=4 s=20 frames=20
clear from -66 22 to -20 22 r=12
clear from -30 32 to -30 56 r=5
clear at -38 60 r=11
clear at 105 140 r=11
clear from -104 -35 to -121 -35 r=8

