# Halcyon Cove - a themed island, three times the size (x3)
# Inspiration: the perfect-town-that-is-a-stage-set film (a pastel seaside town built round one man's life, hidden
#   cameras, rain on cue, a control booth in the "moon", and a painted sky wall out at sea with a door in it) - the mood
#   only, never named on the island.
# Island type: Shape 0 (Round), Style 0 (tropical). A gentle round island: the town on the flat plain of its north side
#   (3 m) by the north beach and its jetty, a hill in the middle with the weather tower on its north slope and the white
#   dome ("the moon") on its top, and 36 m off the east shore, on a sandbank, the sky wall.
# Everyone in Halcyon Cove was an actor except one man. One day he took a boat, sailed into the rain the weather tower
# threw at him, reached the painted horizon, climbed its stair and went out through the door in the sky. The crew turned
# the lights off and left. The cameras are still hidden round the town; the director's journal is in the moon.
# Quest "The Door in the Sky" (12 steps): the square, the welcome board, a neighbour's "script", four hidden cameras'
# tapes, the weather tower, the rain log, the rain switched off (the booth key), the moon, the director's journal, the
# tapes played (the exit key), the sky wall, the door and what's behind it (crop plot blueprint, a globe of the world).
#
# Built by the recipe player (CIRecipe halcyon_cove) through the editor's own operations.
include lib_rt
include lib_huts
include lib_sea
new
# (nature: tropical, Like Raft - palms and gardens; the town's lawns and flower beds the recipe's own)
gen Trees=0.28 Bushes=0.28 Rocks=0.43 Harvest=0.24 BeachThings=0.3
gen Seed=9020 Radius=78 Height=14 Roughness=0.25 Peaks=1 Shape=0 Style=0 BeachWidth=0.6 Cliffs=0.1 PeakShape=0.3
gen SeaFloor=0 Shelf=0.45 Seabed=0
gen Water=0.5 SeaRocks=0.5 SeaFinds=0.5 Sunken=0.4 Hostiles=0
generate

# --- Terrain: the town levelled at 3.2 m on the north plain (lawns painted grass, the street and square sand); the
# weather tower's pad on the hill's north slope (10 m), the moon's on the hilltop (12.5 m), the back lot behind it; the
# sandbank raised under the sky wall off the east shore ---------------------------------------------------------------
for tz 36 68 4
brush flatten from -40 $tz to 40 $tz r=4.5 s=20 frames=120 h=3.2
next
brush smooth from -44 70 to 44 70 r=4 s=10 frames=10
brush smooth from -44 34 to 44 34 r=4 s=10 frames=10
brush grass from -40 52 to 40 52 r=18 s=20 frames=25
brush sand from -40 50 to 40 50 r=3.5 s=20 frames=25
brush sand at 0 50 r=10 s=20 frames=25
brush sand from -1.5 52 to -1.5 72 r=2 s=20 frames=25
brush flatten at 0 30 r=5 s=20 frames=100 h=10
brush flatten at 5.25 25.75 r=4.5 s=20 frames=80 h=9.6
brush flatten at -4 2 r=9 s=20 frames=120 h=12.5
brush flatten at -4 -14 r=6 s=20 frames=80 h=9
for bx 94 116 4
brush flatten from $bx -22 to $bx 22 r=4.5 s=20 frames=150 h=-2.2
next
clear from 105 -26 to 105 26 r=15
clear from -44 52 to 44 52 r=20
clear from -1.5 52 to -1.5 76 r=3
clear at 0 30 r=7
clear at -4 2 r=11
clear at -4 -14 r=8
clear from 0 38 to 0 30 r=3
clear from 0 30 to -4 10 r=3

