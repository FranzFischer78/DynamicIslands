# ===== The sky wall =========================================================================================================
# --- 36 m off the east shore on the sandbank (2.2 m down): a wall of the radio tower's walls tinted sky blue, ten pieces
# long (30 m) and six high (18 m); in its third course the door in the sky (one wall piece that swings open on its
# hinge); a landing on legs at the waterline, the radio tower's stair up to the door; behind it a ledge with the exit
# sign and the last prop crate; fallen props and a sunk barrel at its foot ----------------------------------------------
macro skycourse h
for k 0 4 1
place RT_Wall1 skywall at 108 {-15+3*$k} h=$h yaw=90
next
for k 6 9 1
place RT_Wall1 skywall at 108 {-15+3*$k} h=$h yaw=90
next
end
macro skyfull h
for k 0 9 1
place RT_Wall1 skywall at 108 {-15+3*$k} h=$h yaw=90
next
end
call skyfull -2.2
call skyfull 0.8
call skycourse 3.8
call skyfull 6.8
call skyfull 9.8
call skyfull 12.8
place RT_Wall1 skydoor at 108 0 h=3.8 yaw=90
