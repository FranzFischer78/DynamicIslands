prop frag1 beh.use=Pick up the fragment with the tongs
prop frag1 if.use=has|story:tongs|1\n!signal|f1
prop frag1 on.use=hide|frag1\ngive||story:fragment*1\nsignal||f1\nsound||event:/exploring/utopia/metal_pickup
prop frag1 else.use=message||Too cold to touch - it burns like ice. Sato's notes mention tongs.
