prop cradle beh.use=Lay the twelve fragments in the cradle
prop cradle if.use=quest|9\ntake|story:fragment|12
prop cradle on.use=message||One by one the fragments slide out of the tongs and into the cradle, clicking together - and the violet light runs up the star's veins like water up a wick. With a long grinding sigh, the two halves at its front slide apart.\nopen|starleft\nopen|starright\nshow|core\nsound||event:/exploring/temperence/selene/gate_open
prop cradle else.use=message||A ring of stones round a hollow, the hollow fitted for twelve pieces. Sato's notes: all twelve.
prop starleft obj.name=starleft
prop starleft beh.move=0,0,-3
prop starleft beh.moveTime=5
prop starleft beh.moveMode=switch
prop starright obj.name=starright
prop starright beh.move=0,0,3
prop starright beh.moveTime=5
prop starright beh.moveMode=switch

prop camp zone.id=camp
prop camp zone.radius=9
prop camp zone.message=The scientists' camp on the rim: tents, a lab table, a telescope aimed down into the crater - and the llamas, very glad to see someone.
prop badlands zone.id=badlands
prop badlands zone.radius=12
prop badlands zone.repeat=never
prop badlands zone.message=The badland gullies - and the laughing starts. Hyenas, three of them!
prop hyenas creature.count=3
prop hyenas creature.respawn=0
prop hyenas creature.zone=badlands
prop lakebed zone.id=lakebed
prop lakebed zone.radius=14
prop lakebed zone.message=The crater lake's floor: dark glassy sand, and small violet lights round the star's islet.
prop cleftair zone.id=cleftair
prop cleftair zone.radius=2.5
prop cleftair zone.repeat=1
prop cleftair zone.air=1
prop cleftbubbles atmo.particles=bubbles
prop cleftbubbles zone.radius=3
prop core obj.name=core
prop core beh.hidden=1
prop core zone.id=core
prop core zone.radius=1.5
prop core zone.message=Inside the star: warm, violet, humming. A clipboard - and something like a chest, grown out of the rock.
prop starglow atmo.fog=#2a1a3a
prop starglow atmo.fogAmount=0.2
prop starglow atmo.light=#a080ff
prop starglow atmo.lightAmount=0.3
prop starglow atmo.particles=fireflies
prop starglow zone.radius=20
prop craterhush sound.event=event:/exploring/temperence/selene/cryotube_monitor
prop craterhush sound.volume=0.3
prop craterhush zone.radius=25
prop llamas creature.count=3
prop dolphins creature.count=2

quest title=Twelve Fragments
quest intro=A crater lake with a fallen star in it, and a scientists' camp abandoned on the rim. Dr. Sato's notes are on the lab table.
step reach|camp|1|Climb to the scientists' camp on the south rim
step read|Dr. Sato's field notes|1|Read Dr. Sato's field notes
step open|Instrument crate|1|Take the fragment tongs from the instrument crate
step collect|story:fragment|3|Gather the three fragments on the crater's rim
step kill|Hyena|3|Drive the hyenas out of the badland gullies
step collect|story:fragment|6|Gather the three fragments at the gullies' ends
step reach|lakebed|1|Dive to the crater lake's floor
step collect|story:fragment|9|Gather the three fragments round the star's islet (breathe in the cleft)
step collect|story:fragment|12|Climb the star and gather the three on its crown
step reach|core|1|Lay the twelve fragments in the cradle and enter the star
step read|Sato's last entry|1|Read Sato's last entry inside the star
step open|The star's heart|1|Open the star's heart
quest done=Twelve fragments home and the star open, humming to itself in its crater. Whatever it is, it seems content.
quest reward=TitaniumOre*2;MetalOre*4;Rope*3

save Starfall Crater
