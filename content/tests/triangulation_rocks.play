expect step 5
use relay1
expect story bearing1 1
expect step 6
open Fuel cache
wait 3
expect step 7
zone relay_2
use relay2
expect story bearing2 1
expect step 8
open Relay 2 locker
wait 3
expect step 9
zone relay_3
use relay3
expect story fixed 0
code relay3pad 1111 wrong
code relay3pad 2417
expect story unlock3 1
expect step 10
use relay3
